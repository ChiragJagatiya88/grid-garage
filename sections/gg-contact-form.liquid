{%- liquid
  assign form_id = 'ContactForm-' | append: section.id
  assign email_id = form_id | append: '-email'
  assign label_name = 'templates.contact.form.name' | t
  assign label_phone = 'templates.contact.form.phone' | t
  assign label_email = 'templates.contact.form.email_address' | t
  assign label_subject = 'templates.contact.form.subject' | t
  assign label_message = 'templates.contact.form.message_label' | t
  assign contact_form_class = 'contact gg-contact__form isolate'
  if settings.animations_reveal_on_scroll
    assign contact_form_class = contact_form_class | append: ' scroll-trigger animate--slide-in'
  endif
-%}

{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}
{{ 'gg-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    class="contact page-width gg-contact section-{{ section.id }}-padding{% if section.settings.custom_css_class != blank %} {{ section.settings.custom_css_class | strip }}{% endif %}"
  >
    <header class="gg-contact__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="gg-contact__heading {{ section.settings.heading_size }}">
          {{- section.settings.heading | escape -}}
        </h2>
      {%- else -%}
        <h2 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p
          class="gg-contact__subtext{% if section.settings.subtext_size == 'caption' %} caption{% elsif section.settings.subtext_size == 'caption-large' %} caption-large{% elsif section.settings.subtext_size == 'subtext-medium' %} gg-contact__subtext--medium{% endif %}"
        >
          {{- section.settings.subtext | escape -}}
        </p>
      {%- endif -%}
    </header>

    {%- form 'contact', id: form_id, class: contact_form_class -%}
      {%- if form.posted_successfully? -%}
        <p
          class="gg-contact__status gg-contact__status--success"
          tabindex="-1"
          autofocus
          role="status"
        >
          {{- 'templates.contact.form.post_success' | t -}}
        </p>
      {%- elsif form.errors -%}
        <p class="gg-contact__status gg-contact__status--error" role="alert" tabindex="-1" autofocus>
          {{- 'templates.contact.form.error_heading' | t -}}
        </p>
        <ul class="gg-contact__error-list" role="list">
          {%- if form.errors contains 'email' -%}
            <li>
              <a href="#{{ email_id }}" class="link">
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </a>
            </li>
          {%- endif -%}
        </ul>
      {%- endif -%}

      <div class="gg-contact__grid">
        <div class="field">
          <input
            type="text"
            id="{{ form_id }}-name"
            class="field__input"
            name="contact[name]"
            autocomplete="name"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            placeholder="{{ label_name }}"
          >
          <label class="field__label" for="{{ form_id }}-name">{{ label_name }}</label>
        </div>

        <div class="field">
          <input
            type="tel"
            id="{{ form_id }}-phone"
            class="field__input"
            name="contact[phone]"
            autocomplete="tel"
            value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
            placeholder="{{ label_phone }}"
          >
          <label class="field__label" for="{{ form_id }}-phone">{{ label_phone }}</label>
        </div>

        <div class="field field--with-error">
          <input
            type="email"
            id="{{ email_id }}"
            class="field__input"
            name="contact[email]"
            autocomplete="email"
            spellcheck="false"
            autocapitalize="off"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            placeholder="{{ label_email }}"
            aria-required="true"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="{{ email_id }}-error"
            {% endif %}
          >
          <label class="field__label" for="{{ email_id }}">
            {{- label_email -}}
            <span class="gg-contact__required" aria-hidden="true">*</span>
          </label>
          {%- if form.errors contains 'email' -%}
            <small class="contact__field-error" id="{{ email_id }}-error">
              <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
              <span class="form__message">
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </span>
            </small>
          {%- endif -%}
        </div>

        <div class="field">
          <input
            type="text"
            id="{{ form_id }}-subject"
            class="field__input"
            name="contact[subject]"
            placeholder="{{ label_subject }}"
          >
          <label class="field__label" for="{{ form_id }}-subject">{{ label_subject }}</label>
        </div>

        <div class="field gg-contact__field--full">
          <textarea
            id="{{ form_id }}-body"
            class="text-area field__input"
            name="contact[body]"
            rows="6"
            placeholder="{{ label_message }}"
          >{{- form.body -}}</textarea>
          <label class="form__label field__label" for="{{ form_id }}-body">{{ label_message }}</label>
        </div>

        <div class="gg-contact__actions contact__button">
          <button
            type="submit"
            class="gg-contact__submit{% if section.settings.button_size == 'small' %} gg-contact__submit--sm{% elsif section.settings.button_size == 'large' %} gg-contact__submit--lg{% endif %}"
          >
            {{- section.settings.button_label | escape -}}
          </button>
        </div>
      </div>
    {%- endform -%}

    <div class="logo_title">
      <h2>{{ section.settings.site_text }}</h2>
    </div>

    <hr class="gg-contact__divider gg-contact__divider--before-info" aria-hidden="true">

    <div class="gg-contact__info">
      {%- if section.settings.address != blank -%}
      <div class="gg-contact__info-item">
        <div class="gg-contact__icon-wrap" aria-hidden="true">
          <span class="gg-contact__icon">
            {%- if section.settings.icon_address != blank -%}
              {{
                section.settings.icon_address
                | image_url: width: 128
                | image_tag:
                  loading: 'lazy',
                  widths: '48, 64, 96, 128',
                  sizes: '(min-width: 750px) 36px, 30px',
                  class: 'gg-contact__icon-img',
                  alt: ''
              }}
            {%- else -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/>
              </svg>
            {%- endif -%}
          </span>
        </div>
        <div class="gg-contact__info-body">
          <h4 class="gg-contact__info-title">
            {{- 'templates.contact.form.info_address_title' | t -}}
          </h4>
          <div class="gg-contact__info-text">
            {%- if section.settings.address != blank -%}
              {{ section.settings.address | newline_to_br }}
            {%- endif -%}
          </div>
        </div>
      </div>
      {%- endif -%}

      {%- if section.settings.phone != blank -%}
      <div class="gg-contact__info-item">
        <div class="gg-contact__icon-wrap" aria-hidden="true">
          <span class="gg-contact__icon">
            {%- if section.settings.icon_phone != blank -%}
              {{
                section.settings.icon_phone
                | image_url: width: 128
                | image_tag:
                  loading: 'lazy',
                  widths: '48, 64, 96, 128',
                  sizes: '(min-width: 750px) 36px, 30px',
                  class: 'gg-contact__icon-img',
                  alt: ''
              }}
            {%- else -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M6.62 10.79a15.15 15.15 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V21a1 1 0 0 1-1 1C10.07 22 2 13.93 2 3a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.58a1 1 0 0 1-.25 1.01l-2.2 2.2z"/>
              </svg>
            {%- endif -%}
          </span>
        </div>
        <div class="gg-contact__info-body">
          <h4 class="gg-contact__info-title">
            {{- 'templates.contact.form.info_phone_title' | t -}}
          </h4>
          <p class="gg-contact__info-text">
            {%- if section.settings.phone != blank -%}
              {%- liquid
                assign phone_href = section.settings.phone | strip | remove: '(' | remove: ')' | remove: '-' | remove: ' '
              -%}
              <a href="tel:{{ phone_href | escape }}">{{ section.settings.phone | escape }}</a>
            {%- endif -%}
          </p>
        </div>
      </div>
      {%- endif -%}

      {%- if section.settings.email != blank -%}
        <div class="gg-contact__info-item">
          <div class="gg-contact__icon-wrap" aria-hidden="true">
            <span class="gg-contact__icon">
              {%- if section.settings.icon_email != blank -%}
                {{
                  section.settings.icon_email
                  | image_url: width: 128
                  | image_tag:
                    loading: 'lazy',
                    widths: '48, 64, 96, 128',
                    sizes: '(min-width: 750px) 36px, 30px',
                    class: 'gg-contact__icon-img',
                    alt: ''
                }}
              {%- else -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                  <path fill="currentColor" d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5L4 8V6l8 5 8-5v2z"/>
                </svg>
              {%- endif -%}
            </span>
          </div>
          <div class="gg-contact__info-body">
            <h4 class="gg-contact__info-title">
              {{- 'templates.contact.form.info_email_title' | t -}}
            </h4>
            <p class="gg-contact__info-text">
              {%- if section.settings.email != blank -%}
                <a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a>
              {%- endif -%}
            </p>
          </div>
        </div>
      {%- endif -%}
      
    </div>

    <hr class="gg-contact__divider gg-contact__divider--after-info" aria-hidden="true">
  </div>
</div>

{% schema %}
{
  "name": "t:sections.gg_contact_form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.gg_contact_form.settings.heading.label",
      "default": "t:sections.gg_contact_form.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "t:sections.gg_contact_form.settings.subtext.label",
      "default": "t:sections.gg_contact_form.settings.subtext.default"
    },
    {
      "type": "select",
      "id": "subtext_size",
      "label": "t:sections.gg_contact_form.settings.subtext_size.label",
      "options": [
        {
          "value": "caption",
          "label": "t:sections.gg_contact_form.settings.subtext_size.options__1.label"
        },
        {
          "value": "subtext-medium",
          "label": "t:sections.gg_contact_form.settings.subtext_size.options__2.label"
        },
        {
          "value": "caption-large",
          "label": "t:sections.gg_contact_form.settings.subtext_size.options__3.label"
        }
      ],
      "default": "subtext-medium"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.gg_contact_form.settings.button_label.label",
      "default": "t:sections.gg_contact_form.settings.button_label.default"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "t:sections.gg_contact_form.settings.button_size.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.gg_contact_form.settings.button_size.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.gg_contact_form.settings.button_size.options__2.label"
        },
        {
          "value": "large",
          "label": "t:sections.gg_contact_form.settings.button_size.options__3.label"
        }
      ],
      "default": "medium"
    },
     {
      "type": "text",
      "id": "site_text",
      "label": "Heading Text",
      "default": "Your Heading Here"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "t:sections.gg_contact_form.settings.address.label",
      "default": "t:sections.gg_contact_form.settings.address.default"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "t:sections.gg_contact_form.settings.phone.label",
      "default": "t:sections.gg_contact_form.settings.phone.default"
    },
    {
      "type": "text",
      "id": "email",
      "label": "t:sections.gg_contact_form.settings.email.label",
      "default": "t:sections.gg_contact_form.settings.email.default"
    },
    {
      "type": "header",
      "content": "Contact info icons"
    },
    {
      "type": "paragraph",
      "content": "Upload custom icons for address, phone, and email. Leave empty to use the default icons."
    },
    {
      "type": "image_picker",
      "id": "icon_address",
      "label": "Address icon image"
    },
    {
      "type": "image_picker",
      "id": "icon_phone",
      "label": "Phone icon image"
    },
    {
      "type": "image_picker",
      "id": "icon_email",
      "label": "Email icon image"
    },
    {
      "type": "text",
      "id": "custom_css_class",
      "label": "t:sections.gg_contact_form.settings.custom_css_class.label",
      "info": "t:sections.gg_contact_form.settings.custom_css_class.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "t:sections.gg_contact_form.presets.name"
    }
  ]
}
{% endschema %}
