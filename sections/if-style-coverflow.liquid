{% render 'if-swiper' %}
{{ 'if-style-coverflow.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign if_accent = section.settings.accent_color | default: '#DC1C1B'
  assign if_overlay = section.settings.overlay_opacity | default: 55
-%}

<div
  id="if-cf-{{ section.id }}"
  class="section_{{ section.id }} if-cf{% if section.settings.enable_custom_class and section.settings.section_class != blank %} {{ section.settings.section_class }}{% endif %}"
  data-if-cf
  style="--if-cf-accent: {{ if_accent }}; --if-cf-overlay: {{ if_overlay | divided_by: 100.0 }};"
>
  <div class="if-cf__bg" aria-hidden="true">
    {%- if section.settings.bg_image != blank -%}
      {{
        section.settings.bg_image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          sizes: '100vw',
          widths: '800,1200,1600,2400',
          alt: ''
      }}
    {%- endif -%}
  </div>

  <div class="{% if section.settings.enable_container %}if-cf__inner{% else %}if-cf__inner if-cf__inner--fluid{% endif %}">
    {%- if section.settings.heading != blank -%}
      {%- capture if_cf_heading_html -%}{{ section.settings.heading | newline_to_br }}{%- endcapture -%}
      {%- assign if_cf_lines = if_cf_heading_html | split: '<br />' -%}
      {%- if if_cf_lines.size == 1 -%}
        {%- assign if_cf_lines = if_cf_heading_html | split: '<br>' -%}
      {%- endif -%}
      <h2 class="if-cf__heading">
        {%- for line in if_cf_lines -%}
          {%- assign if_cf_line = line | strip -%}
          {%- if if_cf_line != blank -%}
            {%- if forloop.last and if_cf_lines.size > 1 -%}
              <span class="if-cf__heading-line if-cf__heading-line--sub">{{ if_cf_line | escape }}</span>
            {%- else -%}
              <span class="if-cf__heading-line">{{ if_cf_line | escape }}</span>{%- unless forloop.last -%}<br>{%- endunless -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </h2>
    {%- endif -%}
  </div>

  <div class="if-cf__stage">
    <div class="if-cf__slider swiper" data-if-cf-slider>
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          {%- if block.type == 'slide' -%}
            <div class="swiper-slide" {{ block.shopify_attributes }}>
              <div class="if-cf__card">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 1200px) 280px, (min-width: 750px) 260px, 168px',
                      widths: '320,480,640,900',
                      alt: block.settings.title | default: section.settings.heading | escape
                  }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'slide' -%}
            <div class="swiper-slide" {{ block.shopify_attributes }}>
              <div class="if-cf__card">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 1200px) 280px, (min-width: 750px) 260px, 168px',
                      widths: '320,480,640,900',
                      alt: block.settings.title | default: section.settings.heading | escape
                  }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- if section.settings.btn_label != blank -%}
    <div class="if-cf__cta">
      <a
        class="if-cf__btn"
        href="{{ section.settings.btn_link | default: routes.all_products_collection_url }}"
      >
        {{ section.settings.btn_label | escape }}
      </a>
    </div>
  {%- endif -%}
</div>

<script src="{{ 'if-style-coverflow.js' | asset_url }}" defer></script>

{% style %}
  .section_{{ section.id }} {
    {% if section.settings.enable_custom_padding %}padding-block: {{ section.settings.padding_desk }};{% endif %}
  }
  @media screen and (max-width: 767px) {
    .section_{{ section.id }} {
      {% if section.settings.enable_custom_padding %}padding-block: {{ section.settings.padding_mob }};{% endif %}
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "IF Style Coverflow",
  "tag": "section",
  "class": "if_style_coverflow",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_class",
      "label": "Enable custom class",
      "default": false
    },
    {
      "type": "text",
      "id": "section_class",
      "label": "Custom class",
      "visible_if": "{{ section.settings.enable_custom_class == true }}"
    },
    {
      "type": "checkbox",
      "id": "enable_container",
      "label": "Enable container",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Choose Your Style. One Price. No Surprises.\nShipping is included."
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Background overlay",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button color",
      "default": "#DC1C1B"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_padding",
      "label": "Enable custom padding",
      "default": true
    },
    {
      "type": "text",
      "id": "padding_desk",
      "label": "Padding desktop",
      "default": "64px 0 72px",
      "visible_if": "{{ section.settings.enable_custom_padding == true }}"
    },
    {
      "type": "text",
      "id": "padding_mob",
      "label": "Padding mobile",
      "default": "40px 0 48px",
      "visible_if": "{{ section.settings.enable_custom_padding == true }}"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Alt / title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IF Style Coverflow",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
