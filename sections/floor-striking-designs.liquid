{%- comment -%}
  Figma node 551:1109 — Floor page: dark gallery grid with numbered cells.
{%- endcomment -%}
{{ 'floor-garage-sections.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .flr-strike {
    --floor-accent: {{ section.settings.accent_color.red }},{{ section.settings.accent_color.green }},{{ section.settings.accent_color.blue }};
    --floor-strike-bg: {{ section.settings.background_color.red }},{{ section.settings.background_color.green }},{{ section.settings.background_color.blue }};
    --floor-strike-gap: {{ section.settings.grid_gap }}px;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="floor-sec flr-strike section-{{ section.id }}-padding" aria-labelledby="FloorStrikeTitle-{{ section.id }}">
  <div class="floor-sec__inner">
    <div class="flr-strike__head">
      {%- if section.settings.heading != blank -%}
        <h2 id="FloorStrikeTitle-{{ section.id }}" class="flr-strike__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="flr-strike__sub rte">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>

    <div class="flr-strike__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'image' -%}
            <div class="flr-strike-cell" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a class="flr-strike-cell__link" href="{{ block.settings.link }}">
              {%- endif -%}
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 750px) 25vw, 50vw',
                    widths: '375,550,750,800',
                    alt: block.settings.image.alt | escape
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
              {%- if block.settings.badge != blank -%}
                <span class="flr-strike-cell__badge">{{ block.settings.badge | escape }}</span>
              {%- endif -%}
              {%- if block.settings.link != blank -%}
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="flr-strike__cta">
        <a class="floor-sec__btn floor-sec__btn--solid" href="{{ section.settings.button_link | default: '#' }}">
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Floor: Striking designs",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Striking designs"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Need more inspiration? Browse our <strong>Garage flooring ideas</strong> pages to see how customers use our garage floor tile.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#E11D48"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Grid gap",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge text",
          "default": "01"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Floor: Striking designs",
      "blocks": [
        { "type": "image", "settings": { "badge": "01" } },
        { "type": "image", "settings": { "badge": "02" } },
        { "type": "image", "settings": { "badge": "03" } },
        { "type": "image", "settings": { "badge": "04" } },
        { "type": "image", "settings": { "badge": "05" } },
        { "type": "image", "settings": { "badge": "06" } },
        { "type": "image", "settings": { "badge": "07" } },
        { "type": "image", "settings": { "badge": "08" } }
      ]
    }
  ]
}
{% endschema %}
