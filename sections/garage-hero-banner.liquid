<section class="garage-hero-banner">
  <div class="garage-hero-banner__bg">
    {% if section.settings.bg_image != blank %}
      <img 
        src="{{ section.settings.bg_image | image_url: width: 2000 }}" 
        alt="Background"
        class="garage-hero-banner__image"
      >
    {% endif %}
    <div class="garage-hero-banner__overlay"></div>
  </div>

  <div class="garage-hero-banner__content page-width">
    <div class="garage-hero-banner__status">
      <span class="dot"></span>
      <span>{{ section.settings.status_text }}</span>
    </div>
    <h2 class="garage-hero-banner__heading">
      {{ section.settings.heading }}
    </h2>
  </div>
</section>

<style>
.garage-hero-banner {
  position: relative;
  overflow: hidden;
}

.garage-hero-banner__bg {
  position: relative;
}

.garage-hero-banner__image {
  width: 100%;
  height: 250px;
  object-fit: cover;
  display: block;
}

/* Overlay (dark + red sides) */
.garage-hero-banner__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    rgba(180, 0, 0, 0.6) 0%,
    rgba(0, 0, 0, 0.6) 40%,
    rgba(0, 0, 0, 0.6) 60%,
    rgba(180, 0, 0, 0.6) 100%
  );
}

.garage-hero-banner__content {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #fff;
  text-align: center;
}

.garage-hero-banner__status {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 23px;
    color: #22C55E;
    font-size: 20px;
    font-weight: 700;
    line-height: 16px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
}

.garage-hero-banner__status .dot {
  width: 8px;
  height: 8px;
  background: #00c853;
  border-radius: 50%;
}

.garage-hero-banner__heading {
    color: #FFF;
    font-size: 40px;
    font-weight: 700;
    line-height: 40px;
    margin: 0;
}

/* Responsive */
@media (min-width: 768px) {
  .garage-hero-banner__image {
    height: 280px;
  }
}
@media screen and (max-width:749px){
.garage-hero-banner__heading {
    font-size: 22px;
    line-height: normal;
}
.garage-hero-banner__status {
    margin-bottom: 10px;
    font-size: 16px;
    line-height: normal;
    letter-spacing: 1px;
}
.garage-hero-banner__image {
    height: 150px;
}
}
</style>

{% schema %}
{
  "name": "Garage Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "status_text",
      "label": "Status Text",
      "default": "IN STOCK"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ships within 2–4 business days."
    }
  ],
  "presets": [
    {
      "name": "Garage Hero Banner"
    }
  ]
}
{% endschema %}