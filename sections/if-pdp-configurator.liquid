                    <path d="M14.4504 12.9526C14.4504 12.9526 15.6488 14.6134 17.2251 14.2994L23.2944 20.3686C23.6304 20.7046 23.6304 21.2493 23.2944 21.5853L20.8046 24.0751C20.4686 24.4111 19.9238 24.4111 19.5879 24.0751L13.5186 18.0059C13.8327 16.4296 12.1719 15.2311 12.1719 15.2311" stroke="#0E100F" stroke-width="1.03125" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M7.8994 23.071C6.57888 24.3916 4.61205 24.6709 3.01793 23.909L5.60135 21.3256L5.23844 19.6661L3.57926 19.3042L0.996163 21.8873C0.234632 20.2935 0.513304 18.326 1.83419 17.0058C3.06373 15.7763 4.85435 15.4495 6.38243 16.0253L15.245 7.1627C14.6692 5.63458 14.996 3.844 16.2256 2.61447C17.5458 1.29358 19.5132 1.01491 21.107 1.77644L18.5239 4.35953L18.8858 6.01872L20.5453 6.38162L23.1288 3.7982C23.8906 5.39233 23.6113 7.35916 22.2908 8.67967C21.0612 9.9092 19.271 10.2364 17.7429 9.66053L8.88026 18.5231C9.45612 20.0513 9.12893 21.8415 7.8994 23.071Z" stroke="#DC1C1B" stroke-width="1.03125" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M13.5195 18.0058L17.226 14.2993" stroke="#0E100F" stroke-width="1.03125" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
