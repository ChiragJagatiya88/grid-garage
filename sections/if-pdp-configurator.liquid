      if (popupActive) {
        if (!popupWasSeen) console.log('👀 [DEBUG] now Popup showing (Visible).');
        popupWasSeen = true; // now Popup showing on screen
      } 
      else {
        //if popup if show early, and now in DOM not having, means has closed
        if (popupWasSeen) {
          console.log('❌ [DEBUG] Popup  (Closed). Redirecting...');
          stopPopupTracker();
          continueToCheckout();
        }
      }
    }, 500); // 500 milliseconds ki heartbeat
  }

  function stopPopupTracker() {
    if (popupChecker) {
      clearInterval(popupChecker);
    }
  }

  // 3. MAIN CHECKOUT FUNCTION
  function continueToCheckout() {
    if (isProcessingCheckout) return;
    isProcessingCheckout = true;
    
    console.log('⚡ [DEBUG] now Configurator data adding in Cart ...');

    const formData = new FormData(form);

    fetch('/cart/add.js', {
      method: 'POST',
      body: formData,
      headers: {
        'Accept': 'application/json'
      }
    })
    .then(response => {
      if (!response.ok) throw new Error('Cart Add Failed');
      return response.json();
    })
    .then(data => {
      console.log('✅ [DEBUG] Success! redirect to direct on checkout...');
      window.location.href = '/cart';
    })
    .catch(err => {
      console.error('⚠️ [DEBUG] AJAX Cart failed, using fallback redirect...', err);
      // Fallback: Custom hidden input add  form submit on checkout
      let returnInput = form.querySelector('input[name="return_to"]');
      if (!returnInput) {
        returnInput = document.createElement('input');
        returnInput.type = 'hidden';
        returnInput.name = 'return_to';
        form.appendChild(returnInput);
      }
      returnInput.value = '/cart';
      form.submit();
    });
  }

});
</script> {% endcomment %}
</div>

{% style %}
  #shopify-section-{{ section.id }},
  .section_{{ section.id }},
  .section_{{ section.id }}.if-cfg {
    /* sticky preview requires overflow visible on all ancestors */
    overflow: visible !important;
  }
  .section_{{ section.id }} {
    {% if section.settings.section_bg != blank %}background: {{ section.settings.section_bg }};{% endif %}
    {% if section.settings.section_gradient_bg != blank %}background: {{ section.settings.section_gradient_bg }};{% endif %}
    {% if section.settings.enable_custom_padding %}padding-block: {{ section.settings.padding_desk }};{% endif %}
  }
  @media screen and (max-width: 767px) {
    .section_{{ section.id }} {
      {% if section.settings.enable_custom_padding %}padding-block: {{ section.settings.padding_mob }};{% endif %}
    }
  }
{% endstyle %}

