              "tags": {{ tp.tags | json }},
              "product": {{ tp | json }},
              "colors": {% render 'if-pdp-product-colors-json', tile_product: tp %}
            }
          {%- endif -%}
        {%- endfor -%}
      {%- elsif if_collection != blank -%}
        {%- for tp in if_collection.products -%}
          {%- liquid
            assign tile_size_raw = tp.metafields.custom.tile_size
            if tile_size_raw == blank
              assign tile_size = '12" x 12" inch'
            else
              assign tile_size = tile_size_raw | strip
              unless tile_size contains 'inch'
                assign tile_size = tile_size | append: ' inch'
              endunless
            endif
          -%}
          {%- unless forloop.first -%},{%- endunless -%}
          {{ tp.handle | json }}: {
            "id": {{ tp.id | json }},
            "handle": {{ tp.handle | json }},
            "title": {{ tp.title | json }},
            "url": {{ tp.url | json }},
            "tileSize": {{ tile_size | json }},
            "tags": {{ tp.tags | json }},
            "product": {{ tp | json }},
            "colors": {% render 'if-pdp-product-colors-json', tile_product: tp %}
