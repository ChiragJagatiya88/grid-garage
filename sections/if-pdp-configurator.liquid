<script>
document.addEventListener('DOMContentLoaded', function () {

  const form = document.querySelector('[data-if-cfg-atc-form]');
  const popup = document.querySelector('#discount-popup');
  const closeBtn = document.querySelector('.discount-close');
  const discountForm = document.querySelector('#discount-form');

  if (!form || !popup) return;


  let isProcessing = false;


  function checkCookie(name) {
    const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
    return match ? match[2] : null;
  }


  // ADD TO CART INTERCEPT
  form.addEventListener('submit', function(e){

    if(isProcessing) return;


    const claimed =
      checkCookie('klaviyo_50_claimed') ||
      localStorage.getItem('klaviyo_50_claimed');


    if(claimed){
      e.preventDefault();
      continueToCheckout();
      return;
    }


    e.preventDefault();

    // Open Custom Popup
    popup.classList.add('active');

  });



  // EMAIL SUBMIT
  discountForm.addEventListener('submit', function(e){

    e.preventDefault();


    const email =
      document.querySelector('#discount-email').value;


    if(!email) return;


    /*
      Yahan Klaviyo API / Shopify customer event add hoga
    */


    // save claim
    document.cookie =
    "klaviyo_50_claimed=true; path=/; max-age=604800";

    localStorage.setItem(
      'klaviyo_50_claimed',
      'true'
    );


    popup.classList.remove('active');


    continueToCheckout();


  });



  // CLOSE POPUP
  closeBtn.addEventListener('click', function(){

    popup.classList.remove('active');

    continueToCheckout();

  });



  // CONTINUE CART
  function continueToCheckout(){

    if(isProcessing) return;

    isProcessing = true;

    const root = form.closest('[data-if-cfg]') || document.querySelector('[data-if-cfg]');
    const addFn = root && root._ifCfgAddToCart;
    const redirect = form.getAttribute('data-if-cfg-redirect') || '/cart';

    if (typeof addFn === 'function') {
      addFn({ redirect: redirect }).catch(function () {
        isProcessing = false;
        form.submit();
      });
      return;
    }

    const formData = new FormData(form);

    fetch('/cart/add.js',{
      method:'POST',
      body:formData,
      headers:{
        'Accept':'application/json'
      }
    })
    .then(res=>res.json())
    .then(()=>{
      
      window.location.href='/cart';

    })
    .catch(()=>{

      form.submit();

    });

  }


});
</script>
  
