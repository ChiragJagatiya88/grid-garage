            </div>
            {%- endif -%}
          </div>
        </div>

        {%- comment -%} Pattern {%- endcomment -%}
        <div class="if-cfg__panel" data-if-cfg-pattern-panel>
          <h3 class="if-cfg__panel-title">
            {{ section.settings.pattern_heading | default: 'Choose Pattern' | escape }}:
            <strong data-if-cfg-pattern-name>Checkered</strong>
          </h3>
          <div class="if-cfg__pat-grid" data-if-cfg-pat-grid>
            {%- comment -%} Filled by JS from pattern config {%- endcomment -%}
          </div>
        </div>

        {%- comment -%} Color {%- endcomment -%}
        <div class="if-cfg__panel if-cfg__panel--last" data-if-cfg-color-panel>
          <h3 class="if-cfg__panel-title">{{ section.settings.color_heading | default: 'Choose Color' | escape }}</h3>
          <div class="if-cfg__color-grid">
            <div class="if-cfg__zone-chips" data-if-cfg-zone-chips></div>
            <div class="if-cfg__zone-rows" data-if-cfg-zone-rows></div>
            <p class="if-cfg__zone-warn" data-if-cfg-dup-warn hidden role="alert"></p>
          </div>
        </div>
      </div>
    </div>

    {%- if if_ugc_blocks.size > 0 -%}
      <ul class="if-cfg__ugc" role="list">
        {%- for block in if_ugc_blocks -%}
          <li class="if-cfg__ugc-item" {{ block.shopify_attributes }}>
            <span class="if-cfg__ugc-icon" aria-hidden="true">
              {%- if block.settings.icon != blank -%}
                {{
                  block.settings.icon
                  | image_url: width: 96
                  | image_tag: loading: 'lazy', width: 24, height: 24, alt: ''
                }}
              {%- else -%}
                {%- case block.settings.icon_preset -%}
                  {%- when 'truck' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                  {%- when 'clean' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                  {%- when 'package' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3.3 7.5L12 12l8.7-4.5"/><path d="M12 22V12"/></svg>
                  {%- when 'return' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><polyline points="3 4 3 10 9 10"/></svg>
                  {%- when 'clock' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                  {%- when 'water' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5S6 9 6 13.5a6 6 0 0 0 12 0C18 9 12 2.5 12 2.5z"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                {%- endcase -%}
              {%- endif -%}
            </span>
            {%- if block.settings.text != blank -%}
              <span class="if-cfg__ugc-text">{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- comment -%} Great for these spaces + Your Dream Garage summary {%- endcomment -%}
    <div class="if-cfg__footer" data-if-cfg-footer>
      {%- if section.settings.show_spaces -%}
        <div class="if-cfg__spaces">
          <h3 class="if-cfg__spaces-title">
            {{ section.settings.spaces_heading | default: 'Great for these spaces' | escape }}
          </h3>
          <p class="if-cfg__spaces-text">
            {{
              section.settings.spaces_text
              | default: 'Garage Floors, Gyms, Workshops, Auto Detailing, Showrooms, Basements, Patios, Man Caves & more.'
              | escape
            }}
          </p>
        </div>
      {%- endif -%}

      <div class="if-cfg__dream" data-if-cfg-dream>
        <div class="if-cfg__dream-head">
          <h3 class="if-cfg__dream-title">
            {{ section.settings.summary_heading | default: 'Your Dream Garage' | escape }}
          </h3>
        </div>

        <div class="if-cfg__dream-body">
          <div class="if-cfg__sel-list" data-if-cfg-sel-list>
            {%- comment -%} Filled by JS from live configurator state {%- endcomment -%}
            <div class="if-cfg__sel-item">
              <span class="if-cfg__sel-l">Size</span>
              <span class="if-cfg__sel-v" data-if-sel="size">2-Car Garage</span>
            </div>
            <div class="if-cfg__sel-item">
              <span class="if-cfg__sel-l">Project</span>
              <span class="if-cfg__sel-v" data-if-sel="project">—</span>
            </div>
            <div class="if-cfg__sel-item">
              <span class="if-cfg__sel-l">Total Sq Ft</span>
              <span class="if-cfg__sel-v" data-if-sel="sqft">400 sq ft</span>
            </div>
            <div class="if-cfg__sel-item">
              <span class="if-cfg__sel-l">Collection</span>
              <span class="if-cfg__sel-v" data-if-sel="collection">{{ product.title | escape }}</span>
            </div>
            <div class="if-cfg__sel-item">
              <span class="if-cfg__sel-l">Tile Size</span>
              <span class="if-cfg__sel-v" data-if-sel="tile-size">{{ if_product_tile_size | escape }}</span>
            </div>
            <div class="if-cfg__sel-item">
              <span class="if-cfg__sel-l">Pattern</span>
              <span class="if-cfg__sel-v" data-if-sel="pattern">Checkered Classic</span>
            </div>
            <div class="if-cfg__sel-item if-cfg__sel-item--color">
              <span class="if-cfg__sel-color">
                <span class="if-cfg__sel-dot" style="background:#1a1a1a"></span>
                <span class="if-cfg__sel-color-name">Black</span>
                <span class="if-cfg__sel-color-tag">color a</span>
              </span>
              <span class="if-cfg__sel-qty">—</span>
            </div>
            <div class="if-cfg__sel-item if-cfg__sel-item--color">
              <span class="if-cfg__sel-color">
                <span class="if-cfg__sel-dot" style="background:#1f4e9c"></span>
                <span class="if-cfg__sel-color-name">Blue</span>
                <span class="if-cfg__sel-color-tag">color b</span>
              </span>
              <span class="if-cfg__sel-qty">—</span>
            </div>
            <div class="if-cfg__sel-item if-cfg__sel-item--total">
              <span class="if-cfg__sel-l">Total tiles</span>
              <span class="if-cfg__sel-qty if-cfg__sel-qty--total">—</span>
            </div>
          </div>

          {%- assign if_is_consultation = false -%}
          {%- assign if_pbc_tags = product.tags | join: ',' | downcase -%}
          {%- if if_pbc_tags contains 'price by consultation' -%}
            {%- assign if_is_consultation = true -%}
          {%- endif -%}
          {%- assign if_quote_url = section.settings.quote_url | default: '/pages/contact' -%}

          <div class="if-cfg__dream-actions" data-if-cfg-buy>

            {%- if section.settings.show_edge_notice and section.settings.edge_notice_text != blank -%}
              <div
                class="if-cfg__info-box if-cfg__info-box--edge"
                style="
                  --if-cfg-info-bg: {{ section.settings.edge_notice_bg | default: '#FFFFFF' }};
                  --if-cfg-info-border: {{ section.settings.edge_notice_border | default: '#E8E8E8' }};
                "
              >
                <div class="if-cfg__info-box-text">{{ section.settings.edge_notice_text | newline_to_br }}</div>
              </div>
            {%- endif -%}

            <div
              class="if-cfg__buy-quote"
              data-if-cfg-buy-quote
              {% unless if_is_consultation %}hidden{% endunless %}
            >
              <div class="if-cfg__quote-block">
                {% comment %} <p class="if-cfg__quote-label">Pricing</p> {% endcomment %}
                <p class="if-cfg__quote-title">Please Call or Email for Pricing</p>
                <p class="if-cfg__quote-foot">Contact us for a custom quote tailored to your project.</p>
              </div>
              <div class="if-cfg__quote-actions">
                <a
                  href="{{ if_quote_url }}"
                  class="if-cfg__btn if-cfg__btn--primary if-cfg__quote-btn"
                  data-if-cfg-quote-btn
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                  </svg>
                  REQUEST A QUOTE
                </a>
                <p class="if-cfg__quote-hint">Our team will follow up with pricing tailored to your custom design.</p>
              </div>
            </div>

            <div
              class="if-cfg__buy-cart"
              data-if-cfg-buy-cart
              {% if if_is_consultation %}hidden{% endif %}
            >
              <form
                method="post"
                action="/cart/add"
                class="if-cfg__dream-form"
                data-if-cfg-atc-form
                accept-charset="UTF-8"
                enctype="multipart/form-data"
              >
                <input type="hidden" name="form_type" value="product">
