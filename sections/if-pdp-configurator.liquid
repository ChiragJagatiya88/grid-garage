            <div class="if-cfg__presets" data-if-cfg-presets>
              <button type="button" class="if-cfg__preset" data-w="20" data-d="20" aria-pressed="false">
                20x20
              </button>
              <button type="button" class="if-cfg__preset" data-w="24" data-d="24" aria-pressed="false">24x24</button>
              <button type="button" class="if-cfg__preset" data-w="30" data-d="30" aria-pressed="false">30x30</button>
              <button type="button" class="if-cfg__preset" data-w="40" data-d="40" aria-pressed="false">40x40</button>
            </div>

            <div class="if-cfg__shape">
              <h4 class="if-cfg__shape-title">Floor Shape</h4>
              <p class="if-cfg__shape-help">
                Most garages are a rectangle. If yours has a set-back bay or cut-out corner (an L-shape), switch to
                L-shape below and remove that section — the tile counts and edges update to match.
              </p>
              <div class="if-cfg__shape-row" data-if-cfg-shape-row>
                <button type="button" class="if-cfg__shape-btn is-selected" data-shape="rect" aria-pressed="true">
                  Rectangle
                </button>
                <button type="button" class="if-cfg__shape-btn" data-shape="lshape" aria-pressed="false">
                  L-shape (cut-out)
                </button>
              </div>
              <div class="if-cfg__cutouts" data-if-cfg-cutouts hidden></div>
            </div>

            {%- if section.settings.custom_banner_text != blank -%}
