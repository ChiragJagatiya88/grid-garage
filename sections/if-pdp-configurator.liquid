                      <path d="M6.53125 3.52344V5.24219C6.53125 6.18716 7.30469 6.96094 8.25 6.96094H12.547C13.4923 6.96094 14.2657 6.1875 14.2657 5.24219V3.52344" stroke="black" stroke-width="1.89062" stroke-miterlimit="22.9256" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M5.24219 20.0664H15.5548" stroke="black" stroke-width="1.89062" stroke-miterlimit="22.9256" stroke-linecap="round" stroke-linejoin="round"/>
