{{ 'gg-cart-trust-badges.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign gg_pad_d = section.settings.padding_desk | default: '40px'
  assign gg_pad_m = section.settings.padding_mob | default: '28px'
  assign gg_card_bg = section.settings.card_bg | default: '#f2f2f2'
-%}

{%- if section.blocks.size > 0 -%}
  <div
    id="gg-cart-trust-{{ section.id }}"
    class="gg-cart-trust{% if section.settings.enable_custom_class and section.settings.section_class != blank %} {{ section.settings.section_class }}{% endif %}"
    style="--gg-ct-pad-d: {{ gg_pad_d }}; --gg-ct-pad-m: {{ gg_pad_m }}; --gg-ct-card: {{ gg_card_bg }};"
  >
    <div class="{% if section.settings.enable_container %}page-width{% endif %} gg-cart-trust__inner">
      <ul class="gg-cart-trust__grid" role="list">
        {%- for block in section.blocks -%}
          <li class="gg-cart-trust__card" {{ block.shopify_attributes }}>
            <span class="gg-cart-trust__icon" aria-hidden="true">
              {%- if block.settings.icon != blank -%}
                {{
                  block.settings.icon
                  | image_url: width: 120
                  | image_tag: loading: 'lazy', widths: '60,90,120', sizes: '56px', alt: '', class: 'gg-cart-trust__icon-img'
                }}
              {%- else -%}
                {%- case block.settings.icon_preset -%}
