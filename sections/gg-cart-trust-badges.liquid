                    </svg>
                  {%- else -%}
                    <svg class="gg-cart-trust__badge" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="32" cy="32" r="28" fill="#0E100F"/>
                      <path stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" d="M20 33l8 8 16-16"/>
                    </svg>
                {%- endcase -%}
              {%- endif -%}
            </span>
            {%- if block.settings.text != blank -%}
              <p class="gg-cart-trust__text">{{ block.settings.text | escape | newline_to_br }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Cart trust badges",
  "tag": "section",
  "class": "section-gg-cart-trust",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_container",
      "label": "Enable page width container",
      "default": true
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#f2f2f2"
    },
    {
      "type": "text",
      "id": "padding_desk",
      "label": "Desktop padding",
      "default": "40px"
    },
    {
      "type": "text",
      "id": "padding_mob",
      "label": "Mobile padding",
      "default": "28px"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_class",
      "label": "Enable custom class",
      "default": false
    },
    {
      "type": "text",
      "id": "section_class",
      "label": "Custom class",
      "visible_if": "{{ section.settings.enable_custom_class }}"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Free Shipping, Ships in 3-6 days"
        },
        {
          "type": "select",
          "id": "icon_preset",
          "label": "Icon preset",
          "options": [
            { "value": "shipping", "label": "Free shipping" },
            { "value": "warranty", "label": "20 Year warranty" },
            { "value": "moneyback", "label": "Money back" },
            { "value": "secure", "label": "Secure checkout" },
            { "value": "check", "label": "Check" }
          ],
          "default": "shipping"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Custom icon (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cart trust badges",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "text": "Free Shipping, Ships in 3-6 days",
            "icon_preset": "shipping"
          }
        },
        {
          "type": "badge",
          "settings": {
            "text": "20 Year Warranty",
            "icon_preset": "warranty"
          }
        },
        {
          "type": "badge",
          "settings": {
            "text": "30 Days Money Back Guarantee",
            "icon_preset": "moneyback"
          }
        },
        {
          "type": "badge",
          "settings": {
            "text": "Secure Checkout",
            "icon_preset": "secure"
          }
        }
      ]
    }
  ]
}
{% endschema %}
