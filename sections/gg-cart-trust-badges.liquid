                      <path fill="#fff" d="M22.5 40.5c0-2.2 1.4-4 3.8-4.8 1.1-2.8 3.5-4.7 6.7-4.7 3.8 0 6.5 2.6 6.5 6.2 0 .6-.1 1.2-.2 1.7 2.1.7 3.5 2.4 3.5 4.5 0 2.6-2.2 4.6-5.2 4.6H27.2c-2.7 0-4.7-1.9-4.7-4.5 0-1.1.4-2.1 1-2.9-.5-.7-.8-1.5-.8-2.4z"/>
                      <circle cx="33" cy="28.5" r="6.2" fill="#fff"/>
                      <circle cx="33" cy="28.5" r="4.6" fill="none" stroke="#0E100F" stroke-width="1.4"/>
                      <text x="33" y="31.2" fill="#0E100F" font-size="7.5" font-weight="800" font-family="system-ui,sans-serif" text-anchor="middle">$</text>
                    </svg>
                  {%- when 'secure' -%}
                    <svg class="gg-cart-trust__badge" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path fill="#0E100F" d="M32 2.5c2.4 0 4.3 1.2 6.1 2.7 1.8 1.5 3.7 2.1 5.8 1.8 2.1-.3 3.9.7 5.5 2.1 1.6 1.4 3.5 1.9 5.4 1.5 1.9-.4 3.5.6 4.8 2.1 1.3 1.5 1.9 3.4 1.5 5.4-.4 1.9.1 3.8 1.5 5.4 1.4 1.6 2.4 3.4 2.1 5.5-.3 2.1.3 4 1.8 5.8 1.5 1.8 2.7 3.7 2.7 6.1s-1.2 4.3-2.7 6.1c-1.5 1.8-2.1 3.7-1.8 5.8.3 2.1-.7 3.9-2.1 5.5-1.4 1.6-1.9 3.5-1.5 5.4.4 1.9-.6 3.5-2.1 4.8-1.5 1.3-3.4 1.9-5.4 1.5-1.9-.4-3.8.1-5.4 1.5-1.6 1.4-3.4 2.4-5.5 2.1-2.1-.3-4 .3-5.8 1.8-1.8 1.5-3.7 2.7-6.1 2.7s-4.3-1.2-6.1-2.7c-1.8-1.5-3.7-2.1-5.8-1.8-2.1.3-3.9-.7-5.5-2.1-1.6-1.4-3.5-1.9-5.4-1.5-1.9.4-3.5-.6-4.8-2.1-1.3-1.5-1.9-3.4-1.5-5.4.4-1.9-.1-3.8-1.5-5.4-1.4-1.6-2.4-3.4-2.1-5.5.3-2.1-.3-4-1.8-5.8C3.7 36.3 2.5 34.4 2.5 32s1.2-4.3 2.7-6.1c1.5-1.8 2.1-3.7 1.8-5.8-.3-2.1.7-3.9 2.1-5.5 1.4-1.6 1.9-3.5 1.5-5.4-.4-1.9.6-3.5 2.1-4.8 1.5-1.3 3.4-1.9 5.4-1.5 1.9.4 3.8-.1 5.4-1.5 1.6-1.4 3.4-2.4 5.5-2.1 2.1.3 4-.3 5.8-1.8C27.7 3.7 29.6 2.5 32 2.5z"/>
                      <path fill="#fff" d="M32 18.5l12 4.2v8.8c0 7.2-4.6 12.2-12 14.8-7.4-2.6-12-7.6-12-14.8v-8.8l12-4.2z"/>
