        },
        {
          "type": "text",
          "id": "accent_word",
          "label": "Accent word (must match text inside heading)",
          "default": "Masterpiece.",
          "info": "Matching is case-insensitive (heading can say masterpiece. and accent Masterpiece.)."
        },
        {
          "type": "color",
          "id": "accent_color",
          "label": "Primary button color",
          "default": "#E61E43",
          "info": "Fill color for the primary CTA button."
        },
        {
          "type": "color",
          "id": "heading_accent_color",
          "label": "Accent word color",
          "default": "#E61E43",
          "info": "Color for the highlighted word in the heading (for example Masterpiece.)."
        },
        {
          "type": "richtext",
          "id": "subtext",
          "label": "Description",
          "default": "<p>Premium interlocking flooring designed for the ultimate man cave, home gym, and professional workshop. Built to endure, styled to impress.</p>"
        },
        {
          "type": "text",
          "id": "primary_label",
          "label": "Primary button label",
          "default": "Shop flooring"
        },
        {
          "type": "url",
          "id": "primary_link",
          "label": "Primary button link"
        },
        {
          "type": "text",
          "id": "secondary_label",
          "label": "Secondary button label",
          "default": "Build your garage"
        },
        {
          "type": "url",
          "id": "secondary_link",
          "label": "Secondary button link"
        },
        {
          "type": "text",
          "id": "samples_label",
          "label": "Samples link label",
          "default": "Order samples"
        },
        {
          "type": "url",
          "id": "samples_link",
          "label": "Samples link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grid Garage: Hero banner",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "media_type": "image",
            "eyebrow": "Premium engineered surfaces",
            "heading": "Transform your garage into a masterpiece.",
            "accent_word": "Masterpiece.",
            "accent_color": "#E61E43",
            "heading_accent_color": "#E61E43",
            "subtext": "<p>Premium interlocking flooring designed for the ultimate man cave, home gym, and professional workshop. Built to endure, styled to impress.</p>",
