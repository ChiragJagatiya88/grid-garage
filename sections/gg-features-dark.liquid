{%- comment -%}
  Dark themed feature section — 2x2 grid of cards with image + text.
  Background: black, Cards: charcoal, Rounded corners, Hover scale effect.
{%- endcomment -%}
{{ 'gg-features-dark.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  class="gg-fd section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  data-section-id="{{ section.id }}"
>
  <div class="gg-page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="gg-fd__heading gg-font-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="gg-fd__grid">
      {%- for block in section.blocks -%}
        <article
          class="gg-fd__card{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {{ block.shopify_attributes }}
          style="{% if settings.animations_reveal_on_scroll %}--animation-order: {{ forloop.index }}{% endif %}"
        >
          <div class="gg-fd__card-image">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 750px) 45vw, 100vw',
                  widths: '375,550,750,1100',
                  alt: block.settings.image.alt | default: block.settings.title | escape
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>

          <div class="gg-fd__card-content">
            {%- if block.settings.title != blank -%}
              <h3 class="gg-fd__card-title gg-font-heading">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="gg-fd__card-desc gg-font-body">{{ block.settings.description | escape }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GG: Dark Features",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Upgrade Your Garage Floor"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Short description of this feature goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GG: Dark Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "No More Cracked Concrete",
            "description": "Cover worn, stained, or damaged floors instantly."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Skip Epoxy Hassles",
            "description": "No prep, no drying time, no peeling or chipping."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "No Oil Stains",
            "description": "Resistant to spills and easy to clean."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Built for More Than Garages",
            "description": "Perfect for man caves, workshops, patios, and more."
          }
        }
      ]
    }
  ]
}
{% endschema %}
