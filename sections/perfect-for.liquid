{%- comment -%}
  Perfect For — selectable list swaps the featured image (no reload).
{%- endcomment -%}

{%- liquid
  assign heading_id = 'PerfectFor-heading-' | append: section.id
  assign image_id = 'perfect-image-' | append: section.id
  assign list_id = 'PerfectFor-list-' | append: section.id
  assign first_block_image = blank
  assign first_block_alt = ''
  for block in section.blocks
    if block.type == 'item' and block.settings.image != blank and first_block_image == blank
      assign first_block_image = block.settings.image
      assign first_block_alt = block.settings.image.alt | default: block.settings.image_alt | default: ''
      break
    endif
  endfor
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .perfect-for__grid {
    gap: {{ section.settings.column_gap }}px;
  }
{%- endstyle -%}

<div class="perfect-for section-{{ section.id }}-padding" data-perfect-for-root>
  <div class="perfect-for__inner page-width">
    <div class="perfect-for__grid">
      <div class="perfect-for__list-wrap">
        {%- if section.settings.heading != blank -%}
          <h2 class="perfect-for__heading" id="{{ heading_id }}">
            {{- section.settings.heading | escape -}}
          </h2>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          {%- assign perfect_for_first_placed = false -%}
          <ul
            class="perfect-for__list perfect-list list-unstyled"
            id="{{ list_id }}"
            role="list"
            aria-label="{{ 'sections.perfect_for.list_label' | t }}"
          >
            {%- for block in section.blocks -%}
              {%- if block.type != 'item' -%}
                {%- continue -%}
              {%- endif -%}
              {%- liquid
                assign item_image = block.settings.image
                if item_image == blank
                  continue
                endif
                assign item_alt = item_image.alt | default: block.settings.image_alt | default: ''
                assign is_active = false
                unless perfect_for_first_placed
                  assign is_active = true
                  assign perfect_for_first_placed = true
                endunless
                assign img_w375 = item_image | image_url: width: 375
                assign img_w550 = item_image | image_url: width: 550
                assign img_w750 = item_image | image_url: width: 750
                assign img_w1100 = item_image | image_url: width: 1100
                assign img_w1500 = item_image | image_url: width: 1500
                assign img_src = item_image | image_url: width: 1500
                assign item_srcset = img_w375 | append: ' 375w, ' | append: img_w550 | append: ' 550w, ' | append: img_w750 | append: ' 750w, ' | append: img_w1100 | append: ' 1100w, ' | append: img_w1500 | append: ' 1500w'
                assign item_sizes = '(min-width: 750px) 50vw, 100vw'
              -%}
              <li class="perfect-for__list-item" role="listitem" {{ block.shopify_attributes }}>
                <button
                  type="button"
                  class="perfect-for__item item{% if is_active %} is-active{% endif %}"
                  data-perfect-for-item
                  data-image="{{ img_src | escape }}"
                  data-image-src="{{ img_src | escape }}"
                  data-image-srcset="{{ item_srcset | strip | escape }}"
                  data-image-sizes="{{ item_sizes | escape }}"
                  data-image-alt="{{ item_alt | escape }}"
                  aria-pressed="{% if is_active %}true{% else %}false{% endif %}"
                  aria-controls="{{ image_id }}"
                >
                  <span class="perfect-for__item-inner">
                    <span class="perfect-for__icon" aria-hidden="true">
                      {%- if block.settings.icon_image != blank -%}
                        {{
                          block.settings.icon_image
                          | image_url: width: 64
                          | image_tag:
                            widths: '32, 48, 64',
                            sizes: '32px',
                            class: 'perfect-for__icon-img',
                            alt: '',
                            loading: 'lazy',
                            decoding: 'async'
                        }}
                      {%- else -%}
                        {%- case block.settings.icon -%}
                          {%- when 'car' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="16" viewBox="0 0 18 16" fill="none">
                              <path d="M3 14V15C3 15.2833 2.90417 15.5208 2.7125 15.7125C2.52083 15.9042 2.28333 16 2 16H1C0.716667 16 0.479167 15.9042 0.2875 15.7125C0.0958333 15.5208 0 15.2833 0 15V7L2.1 1C2.2 0.7 2.37917 0.458333 2.6375 0.275C2.89583 0.0916667 3.18333 0 3.5 0H14.5C14.8167 0 15.1042 0.0916667 15.3625 0.275C15.6208 0.458333 15.8 0.7 15.9 1L18 7V15C18 15.2833 17.9042 15.5208 17.7125 15.7125C17.5208 15.9042 17.2833 16 17 16H16C15.7167 16 15.4792 15.9042 15.2875 15.7125C15.0958 15.5208 15 15.2833 15 15V14H3ZM2.8 5H15.2L14.15 2H3.85L2.8 5ZM2 7V12V7ZM4.5 11C4.91667 11 5.27083 10.8542 5.5625 10.5625C5.85417 10.2708 6 9.91667 6 9.5C6 9.08333 5.85417 8.72917 5.5625 8.4375C5.27083 8.14583 4.91667 8 4.5 8C4.08333 8 3.72917 8.14583 3.4375 8.4375C3.14583 8.72917 3 9.08333 3 9.5C3 9.91667 3.14583 10.2708 3.4375 10.5625C3.72917 10.8542 4.08333 11 4.5 11ZM13.5 11C13.9167 11 14.2708 10.8542 14.5625 10.5625C14.8542 10.2708 15 9.91667 15 9.5C15 9.08333 14.8542 8.72917 14.5625 8.4375C14.2708 8.14583 13.9167 8 13.5 8C13.0833 8 12.7292 8.14583 12.4375 8.4375C12.1458 8.72917 12 9.08333 12 9.5C12 9.91667 12.1458 10.2708 12.4375 10.5625C12.7292 10.8542 13.0833 11 13.5 11ZM2 12H16V7H2V12Z" fill="#fff"/>
                            </svg>
                          {%- when 'dumbbell' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                              <path d="M11.3 19.8L9.9 18.4L13.45 14.85L4.95 6.35L1.4 9.9L0 8.5L1.4 7.05L0 5.65L2.1 3.55L0.7 2.1L2.1 0.7L3.55 2.1L5.65 0L7.05 1.4L8.5 0L9.9 1.4L6.35 4.95L14.85 13.45L18.4 9.9L19.8 11.3L18.4 12.75L19.8 14.15L17.7 16.25L19.1 17.7L17.7 19.1L16.25 17.7L14.15 19.8L12.75 18.4L11.3 19.8Z" fill="white"/>
                            </svg>
                          {%- when 'wrench' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
                              <path d="M14.15 17.7L8.1 11.6C7.76667 11.7333 7.42917 11.8333 7.0875 11.9C6.74583 11.9667 6.38333 12 6 12C4.33333 12 2.91667 11.4167 1.75 10.25C0.583333 9.08333 0 7.66667 0 6C0 5.4 0.0833333 4.82917 0.25 4.2875C0.416667 3.74583 0.65 3.23333 0.95 2.75L4.6 6.4L6.4 4.6L2.75 0.95C3.23333 0.65 3.74583 0.416667 4.2875 0.25C4.82917 0.0833333 5.4 0 6 0C7.66667 0 9.08333 0.583333 10.25 1.75C11.4167 2.91667 12 4.33333 12 6C12 6.38333 11.9667 6.74583 11.9 7.0875C11.8333 7.42917 11.7333 7.76667 11.6 8.1L17.7 14.15C17.9 14.35 18 14.5917 18 14.875C18 15.1583 17.9 15.4 17.7 15.6L15.6 17.7C15.4 17.9 15.1583 18 14.875 18C14.5917 18 14.35 17.9 14.15 17.7ZM14.875 15.575L15.55 14.9L9.15 8.5C9.45 8.16667 9.66667 7.77917 9.8 7.3375C9.93333 6.89583 10 6.45 10 6C10 5 9.67917 4.12917 9.0375 3.3875C8.39583 2.64583 7.6 2.2 6.65 2.05L8.5 3.9C8.7 4.1 8.8 4.33333 8.8 4.6C8.8 4.86667 8.7 5.1 8.5 5.3L5.3 8.5C5.1 8.7 4.86667 8.8 4.6 8.8C4.33333 8.8 4.1 8.7 3.9 8.5L2.05 6.65C2.2 7.6 2.64583 8.39583 3.3875 9.0375C4.12917 9.67917 5 10 6 10C6.43333 10 6.86667 9.93333 7.3 9.8C7.73333 9.66667 8.125 9.45833 8.475 9.175L14.875 15.575Z" fill="white"/>
                            </svg>
                          {%- when 'crate' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                              <path d="M3 20C2.45 20 1.97917 19.8042 1.5875 19.4125C1.19583 19.0208 1 18.55 1 18V6.725C0.7 6.54167 0.458333 6.30417 0.275 6.0125C0.0916667 5.72083 0 5.38333 0 5V2C0 1.45 0.195833 0.979167 0.5875 0.5875C0.979167 0.195833 1.45 0 2 0H18C18.55 0 19.0208 0.195833 19.4125 0.5875C19.8042 0.979167 20 1.45 20 2V5C20 5.38333 19.9083 5.72083 19.725 6.0125C19.5417 6.30417 19.3 6.54167 19 6.725V18C19 18.55 18.8042 19.0208 18.4125 19.4125C18.0208 19.8042 17.55 20 17 20H3ZM3 7V18H17V7H3ZM2 5H18V2H2V5ZM7 12H13V10H7V12Z" fill="white"/>
                            </svg>
                          {%- when 'controller' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="14" viewBox="0 0 20 14" fill="none">
                              <path d="M2.535 14C1.685 14 1.02667 13.7042 0.56 13.1125C0.0933333 12.5208 -0.0816667 11.8 0.035 10.95L1.085 3.45C1.235 2.45 1.68083 1.625 2.4225 0.975C3.16417 0.325 4.035 0 5.035 0H14.935C15.935 0 16.8058 0.325 17.5475 0.975C18.2892 1.625 18.735 2.45 18.885 3.45L19.935 10.95C20.0517 11.8 19.8767 12.5208 19.41 13.1125C18.9433 13.7042 18.285 14 17.435 14C17.085 14 16.76 13.9375 16.46 13.8125C16.16 13.6875 15.885 13.5 15.635 13.25L13.385 11H6.585L4.335 13.25C4.085 13.5 3.81 13.6875 3.51 13.8125C3.21 13.9375 2.885 14 2.535 14ZM2.935 11.85L5.785 9H14.185L17.035 11.85C17.0683 11.8833 17.2017 11.9333 17.435 12C17.6183 12 17.7642 11.9458 17.8725 11.8375C17.9808 11.7292 18.0183 11.5833 17.985 11.4L16.885 3.7C16.8183 3.21667 16.6017 2.8125 16.235 2.4875C15.8683 2.1625 15.435 2 14.935 2H5.035C4.535 2 4.10167 2.1625 3.735 2.4875C3.36833 2.8125 3.15167 3.21667 3.085 3.7L1.985 11.4C1.95167 11.5833 1.98917 11.7292 2.0975 11.8375C2.20583 11.9458 2.35167 12 2.535 12C2.56833 12 2.70167 11.95 2.935 11.85ZM14.985 8C15.2683 8 15.5058 7.90417 15.6975 7.7125C15.8892 7.52083 15.985 7.28333 15.985 7C15.985 6.71667 15.8892 6.47917 15.6975 6.2875C15.5058 6.09583 15.2683 6 14.985 6C14.7017 6 14.4642 6.09583 14.2725 6.2875C14.0808 6.47917 13.985 6.71667 13.985 7C13.985 7.28333 14.0808 7.52083 14.2725 7.7125C14.4642 7.90417 14.7017 8 14.985 8ZM12.985 5C13.2683 5 13.5058 4.90417 13.6975 4.7125C13.8892 4.52083 13.985 4.28333 13.985 4C13.985 3.71667 13.8892 3.47917 13.6975 3.2875C13.5058 3.09583 13.2683 3 12.985 3C12.7017 3 12.4642 3.09583 12.2725 3.2875C12.0808 3.47917 11.985 3.71667 11.985 4C11.985 4.28333 12.0808 4.52083 12.2725 4.7125C12.4642 4.90417 12.7017 5 12.985 5ZM5.735 8H7.235V6.25H8.985V4.75H7.235V3H5.735V4.75H3.985V6.25H5.735V8Z" fill="white"/>
                            </svg>
                          {%- else -%}
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" focusable="false">
                              <circle cx="12" cy="12" r="3"/>
                              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
                            </svg>
                        {%- endcase -%}
                      {%- endif -%}
                    </span>
                    <span class="perfect-for__label">{{ block.settings.title | escape }}</span>
                  </span>
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="perfect-for__media">
        <figure class="perfect-for__figure">
          {%- if first_block_image != blank -%}
            {%- liquid
              if first_block_alt == blank
                assign display_alt = 'sections.perfect_for.image_fallback_alt' | t
              else
                assign display_alt = first_block_alt
              endif
            -%}
            {{
              first_block_image
              | image_url: width: 1500
              | image_tag:
                id: image_id,
                widths: '375, 550, 750, 1100, 1500',
                sizes: '(min-width: 750px) 50vw, 100vw',
                class: 'perfect-for__image',
                alt: display_alt,
                loading: 'lazy',
                decoding: 'async'
            }}
          {%- else -%}
            <div
              class="perfect-for__image perfect-for__image--placeholder"
              id="{{ image_id }}"
              role="img"
              aria-label="{{ 'sections.perfect_for.placeholder_label' | t }}"
            >
              {{ 'lifestyle-1' | placeholder_svg_tag: 'perfect-for__placeholder-svg' }}
            </div>
          {%- endif -%}
        </figure>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .perfect-for {
    --pf-bg: 0, 0, 0;
    --pf-item-bg: 26, 26, 26;
    --pf-item-bg-active: 42, 42, 42;
    --pf-text: 255, 255, 255;
    --pf-accent: 255, 0, 0;
    --pf-radius-item: 0.8rem;
    --pf-radius-image: 1.4rem;
    width: 100%;
    background-color: rgb(var(--pf-bg));
    color: rgb(var(--pf-text));
  }
  .perfect-for__grid {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .perfect-for__media {
    width: 100%;
    min-width: 0;
    order: -1;
  }

  .perfect-for__list-wrap {
    width: 100%;
    min-width: 0;
    order: 1;
        max-width: 560px;
  }

  @media screen and (min-width: 750px) {
    .perfect-for__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }

    .perfect-for__media,
    .perfect-for__list-wrap {
      order: unset;
    }
  }

  .perfect-for__heading {
      margin: 0 0 3.2rem;
      font-size: clamp(2rem, 1.2rem + 2vw, 4rem);
      font-weight: 700;
      line-height: 1.2;
      color: rgb(var(--pf-text));
  }

  .perfect-for__list {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .perfect-for__list-item {
    margin: 0;
  }

  .perfect-for__item {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    border: none;
    border-radius: var(--pf-radius-item);
    background-color: rgb(var(--pf-item-bg));
    color: rgb(var(--pf-text));
    text-align: start;
    cursor: pointer;
    transition: background-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
    box-shadow: inset 0 0 0 0 rgb(var(--pf-accent));
  }

  .perfect-for__item:focus-visible {
    outline: 0.2rem solid rgb(var(--pf-accent));
    outline-offset: 0.2rem;
  }

  .perfect-for__item-inner {
    display: flex;
    align-items: center;
    gap: 2.4rem;
    padding: clamp(1.2rem, 2vw, 1.6rem);
    border-radius: var(--pf-radius-item);
    border-left: .35rem solid transparent;
}

  .perfect-for__item.is-active .perfect-for__item-inner {
    background-color: rgb(var(--pf-item-bg-active));
        border-left-color: #B90014;
  }

  .perfect-for__item.is-active {
    color: rgb(var(--pf-text));
  }

  .perfect-for__item.is-active .perfect-for__icon {
    color: rgb(var(--pf-accent));
  }

  @media (prefers-reduced-motion: no-preference) {
    .perfect-for__item:hover:not(.is-active) {
      background-color: rgba(var(--pf-text), 0.08);
    }

    .perfect-for__item.is-active {
      transform: scale(1.015);
    }
  }

  .perfect-for__icon {
    flex-shrink: 0;
    width: 1.9rem;
    height: 1.9rem;
    color: rgba(var(--pf-text), 0.85);
  }

  .perfect-for__item.is-active .perfect-for__icon {
    color: rgb(var(--pf-accent));
  }
  .perfect-for__item.is-active .perfect-for__icon svg path{
    fill: #E11D48;
  }

  .perfect-for__icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .perfect-for__icon-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .perfect-for__label {
    font-size: 20px;
    font-weight: 700;
    line-height: 28px;
    letter-spacing: -0.45px;
}

  .perfect-for__figure {
    margin: 0;
    border-radius: var(--pf-radius-image);
    overflow: hidden;
    background-color: rgba(var(--pf-text), 0.06);
  }

  .perfect-for__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: center;
    border-radius: var(--pf-radius-image);
    transition: opacity 0.35s ease;
  }

  .perfect-for__image.is-fading {
    opacity: 0;
  }

  .perfect-for__image--placeholder {
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .perfect-for__placeholder-svg {
    width: 45%;
    height: auto;
    opacity: 0.35;
  }
  @media screen and (max-width:749px){
    .perfect-for {
    padding: 30px 0 !important;
}
.perfect-for__heading {
    margin: 0 0 1rem;
}
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function prefersReducedMotion() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    function setActiveItem(items, activeBtn) {
      items.forEach(function (btn) {
        var on = btn === activeBtn;
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
    }

    function swapImage(img, src, srcset, sizes, alt) {
      if (!img || !src) return;

      var isPlaceholder = img.classList && img.classList.contains('perfect-for__image--placeholder');
      if (isPlaceholder) {
        var figure = img.closest('.perfect-for__figure');
        if (!figure) return;
        var ph = img;
        var newImg = document.createElement('img');
        newImg.id = ph.id;
        newImg.className = 'perfect-for__image';
        newImg.src = src;
        if (srcset) newImg.srcset = srcset;
        if (sizes) newImg.sizes = sizes;
        newImg.alt = alt || '';
        newImg.loading = 'lazy';
        newImg.decoding = 'async';
        figure.replaceChild(newImg, ph);
        return;
      }

      var done = false;
      var safetyTimer;

      var finish = function () {
        if (done) return;
        done = true;
        if (safetyTimer) window.clearTimeout(safetyTimer);
        img.removeEventListener('transitionend', onEnd);
        img.src = src;
        if (srcset) {
          img.srcset = srcset;
        } else {
          img.removeAttribute('srcset');
        }
        if (sizes) img.sizes = sizes;
        else img.removeAttribute('sizes');
        img.alt = alt || '';
        requestAnimationFrame(function () {
          img.classList.remove('is-fading');
        });
      };

      var onEnd = function (e) {
        if (e.propertyName !== 'opacity') return;
        finish();
      };

      if (prefersReducedMotion()) {
        finish();
        return;
      }

      img.classList.add('is-fading');
      img.addEventListener('transitionend', onEnd);
      safetyTimer = window.setTimeout(finish, 450);
    }

    function bindRoot(root) {
      var items = root.querySelectorAll('[data-perfect-for-item]');
      if (!items.length) return;

      items.forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (btn.classList.contains('is-active')) return;
          var img = root.querySelector('.perfect-for__image');
          if (!img) return;
          var src = btn.getAttribute('data-image-src');
          var srcset = btn.getAttribute('data-image-srcset') || '';
          var sizes = btn.getAttribute('data-image-sizes') || '';
          var alt = btn.getAttribute('data-image-alt') || '';
          setActiveItem(items, btn);
          swapImage(img, src, srcset, sizes, alt);
        });
      });
    }

    function initAll() {
      document.querySelectorAll('[data-perfect-for-root]').forEach(bindRoot);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', function (event) {
      var root = event.target.querySelector && event.target.querySelector('[data-perfect-for-root]');
      if (root) bindRoot(root);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.perfect-for.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.perfect-for.settings.heading.label",
      "default": "Perfect For:"
    },
    {
      "type": "header",
      "content": "t:sections.perfect-for.settings.header_layout.content"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 16,
