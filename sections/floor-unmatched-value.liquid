{%- comment -%}
  Figma node 551:1042 — Floor page: background image, circular inset, dark value panel.
{%- endcomment -%}
{{ 'floor-garage-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign panel_a = section.settings.panel_opacity | times: 0.01
  assign row_class = 'flr-value__row'
  if section.settings.panel_position == 'left'
    assign row_class = row_class | append: ' flr-value__row--panel-right'
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .flr-value {
    --floor-accent: {{ section.settings.accent_color.red }},{{ section.settings.accent_color.green }},{{ section.settings.accent_color.blue }};
    --floor-value-panel-rgb: {{ section.settings.panel_color.red }},{{ section.settings.panel_color.green }},{{ section.settings.panel_color.blue }};
    --floor-value-panel-a: {{ panel_a }};
    --floor-value-min-h: {{ section.settings.min_height }}px;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="floor-sec flr-value section-{{ section.id }}-padding" aria-labelledby="FloorValueTitle-{{ section.id }}">
  <div class="flr-value__bg" aria-hidden="true">
    {%- if section.settings.background_image != blank -%}
      {{
        section.settings.background_image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          sizes: '100vw',
          widths: '750,1100,1500,2000,2400',
          alt: section.settings.background_image.alt | escape
      }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="page-width flr-value__inner">
    <div class="{{ row_class }}">
      <div class="flr-value__left">
        <div class="flr-value__circle-wrap">
          {%- if section.settings.circle_image != blank -%}
            {{
              section.settings.circle_image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 990px) 448px, 85vw',
                widths: '400,600,900',
                alt: section.settings.circle_image.alt | escape
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>

      <div class="flr-value__panel">
        {%- if section.settings.heading != blank -%}
          <h2 id="FloorValueTitle-{{ section.id }}" class="flr-value__panel-title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'point' -%}
              <div class="flr-value__feature" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  {{
                    block.settings.icon
                    | image_url: width: 100
                    | image_tag:
                      loading: 'lazy',
                      class: 'flr-value__feature-icon',
                      widths: '80,100',
                      alt: ''
                  }}
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <h3 class="flr-value__feature-title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="flr-value__feature-body rte">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Floor: Unmatched value",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "circle_image",
      "label": "Circular image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Unmatched value"
    },
    {
      "type": "select",
      "id": "panel_position",
      "label": "Panel position (large screens)",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Panel color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "panel_opacity",
      "min": 50,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Panel opacity",
      "default": 70
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 400,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "label": "Minimum height",
      "default": 600
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#E11D48"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Easy to clean"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Grid Garage tiles have a built-in channeling system to allow liquids and debris to wash out from under the flooring system.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Floor: Unmatched value",
      "blocks": [
        {
          "type": "point",
          "settings": {
            "title": "Easy to clean",
            "text": "<p>Grid Garage tiles have a ¾\" understructure with a built-in advanced channeling system.</p>"
          }
        },
        {
          "type": "point",
          "settings": {
            "title": "Easy to maintain",
            "text": "<p>Perforations allow dirt and liquids to flow through to keep the surface clean and dry.</p>"
          }
        },
        {
          "type": "point",
          "settings": {
            "title": "Easy to replace",
            "text": "<p>Easily remove a single tile if you need to access the subsurface.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
