{{ 'if-promise-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign if_bg = section.settings.section_bg | default: '#DC1C1B'
  assign if_text = section.settings.text_color | default: '#FFFFFF'
  assign if_icon_bg = section.settings.icon_bg | default: '#FFFFFF'
  assign if_icon_color = section.settings.icon_color | default: '#DC1C1B'
-%}

<div
  id="if-promise-{{ section.id }}"
  class="section_{{ section.id }} if-prm{% if section.settings.bg_image != blank or section.settings.bg_image_mobile != blank %} has-bg-img{% endif %}{% if section.settings.enable_custom_class and section.settings.section_class != blank %} {{ section.settings.section_class }}{% endif %}"
  style="--if-prm-bg: {{ if_bg }}; --if-prm-text: {{ if_text }}; --if-prm-icon-bg: {{ if_icon_bg }}; --if-prm-icon: {{ if_icon_color }};"
>
  {%- if section.settings.bg_image != blank or section.settings.bg_image_mobile != blank -%}
    {%- liquid
      assign if_bg_desk = section.settings.bg_image
      if if_bg_desk == blank
        assign if_bg_desk = section.settings.bg_image_mobile
      endif
      assign if_bg_mob = section.settings.bg_image_mobile
      if if_bg_mob == blank
        assign if_bg_mob = section.settings.bg_image
      endif
    -%}
    <div class="if-prm__bg" aria-hidden="true">
      {%- if if_bg_desk != blank -%}
        {{
          if_bg_desk
          | image_url: width: 2400
          | image_tag:
            class: 'if-prm__bg-img if-prm__bg-img--desk',
            loading: 'lazy',
            sizes: '100vw',
            widths: '800,1200,1600,2400',
            alt: ''
        }}
      {%- endif -%}
      {%- if if_bg_mob != blank -%}
        {{
          if_bg_mob
          | image_url: width: 1200
          | image_tag:
            class: 'if-prm__bg-img if-prm__bg-img--mob',
            loading: 'lazy',
            sizes: '100vw',
            widths: '480,750,1000,1200',
            alt: ''
        }}
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="if-prm__pattern"{% unless section.settings.show_pattern %} hidden{% endunless %} aria-hidden="true"></div>
  <div class="{% if section.settings.enable_container %}if-prm__inner{% else %}if-prm__inner if-prm__inner--fluid{% endif %}">
    <div class="if-prm__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'promise' -%}
          <div class="if-prm__item" {{ block.shopify_attributes }}>
            <div class="if-prm__icon" aria-hidden="true">
              {%- if block.settings.icon != blank -%}
                {{
                  block.settings.icon
                  | image_url: width: 96
                  | image_tag: loading: 'lazy', widths: '48,72,96', alt: ''
                }}
              {%- else -%}
                {%- case block.settings.icon_preset -%}
                  {%- when 'money' -%}
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <rect x="2.5" y="6" width="19" height="12" rx="2" stroke="currentColor" stroke-width="1.7"/>
                      <path d="M2.5 9.5h19M2.5 14.5h19" stroke="currentColor" stroke-width="1.7"/>
                      <circle cx="12" cy="12" r="2.2" stroke="currentColor" stroke-width="1.7"/>
                      <path d="M6 12h.01M18 12h.01" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                    </svg>
                  {%- when 'gift' -%}
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M20 12v8a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                      <path d="M3 8h18v4H3V8z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                      <path d="M12 21V8M12 8c0-2.2-1-4-2.6-4S7 5.8 7 8c0 0 2.2.8 5 0zm0 0c0-2.2 1-4 2.6-4S17 5.8 17 8c0 0-2.2.8-5 0z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                      <circle cx="17.5" cy="17.5" r="3.2" fill="var(--if-prm-icon-bg)" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M16.2 17.5h2.6M17.5 16.2v2.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  {%- else -%}
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M9 11.2V7.5a2.5 2.5 0 0 1 5 0V12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                      <path d="M14 11.5V10a1.8 1.8 0 0 1 3.6 0v2.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                      <path d="M8.2 12.2V11a1.5 1.5 0 0 0-3 0v3.8a5.8 5.8 0 0 0 5.8 5.8h1.4c3.4 0 5.8-2 6.6-4.4.4-1.2.7-2.7.7-3.6V12a1.4 1.4 0 0 0-2.8 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                      <circle cx="17.8" cy="6.2" r="2.4" stroke="currentColor" stroke-width="1.5"/>
                      <circle cx="17.8" cy="6.2" r="0.7" fill="currentColor"/>
                    </svg>
                {%- endcase -%}
              {%- endif -%}
            </div>
            {%- if block.settings.title != blank -%}
              <h3 class="if-prm__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="if-prm__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% style %}
  .section_{{ section.id }} {
    {% if section.settings.section_bg != blank %}background: {{ section.settings.section_bg }};{% endif %}
    {% if section.settings.section_gradient_bg != blank %}background: {{ section.settings.section_gradient_bg }};{% endif %}
    {% if section.settings.enable_custom_padding %}padding-block: {{ section.settings.padding_desk }};{% endif %}
  }
  @media screen and (max-width: 767px) {
    .section_{{ section.id }} {
      {% if section.settings.enable_custom_padding %}padding-block: {{ section.settings.padding_mob }};{% endif %}
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "IF Promise Banner",
  "tag": "section",
  "class": "if_promise_banner",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_class",
      "label": "Enable custom class",
      "default": false
    },
    {
      "type": "text",
      "id": "section_class",
      "label": "Custom class",
      "visible_if": "{{ section.settings.enable_custom_class == true }}"
    },
    {
      "type": "checkbox",
      "id": "enable_container",
      "label": "Enable container",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#DC1C1B"
    },
    {
      "type": "color_background",
      "id": "section_gradient_bg",
      "label": "Section gradient background"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image (desktop)",
      "info": "Full-cover background. Color/gradient still show behind if image has transparency."
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background image (mobile)",
      "info": "Uses the desktop image if left empty"
    },
    {
      "type": "checkbox",
      "id": "show_pattern",
      "label": "Show arc pattern overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "icon_bg",
      "label": "Icon circle background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#DC1C1B"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_padding",
      "label": "Enable custom padding",
      "default": true
    },
    {
      "type": "text",
      "id": "padding_desk",
      "label": "Padding desktop",
      "default": "56px 0",
      "visible_if": "{{ section.settings.enable_custom_padding == true }}"
    },
    {
      "type": "text",
      "id": "padding_mob",
      "label": "Padding mobile",
      "default": "40px 0",
      "visible_if": "{{ section.settings.enable_custom_padding == true }}"
    }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "settings": [
        {
          "type": "select",
          "id": "icon_preset",
          "label": "Icon preset",
          "options": [
            { "value": "click", "label": "One Click (hand)" },
            { "value": "money", "label": "One Price (cash)" },
            { "value": "gift", "label": "No Surprises (gift)" }
          ],
          "default": "click"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Custom icon (optional)",
          "info": "Overrides the preset icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "One Click"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "No measuring or calculators needed"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IF Promise Banner",
      "blocks": [
        {
          "type": "promise",
          "settings": {
            "icon_preset": "click",
            "title": "One Click",
            "text": "No measuring or calculators needed"
          }
        },
        {
          "type": "promise",
          "settings": {
            "icon_preset": "money",
            "title": "One Price",
            "text": "Shipping and essentials included"
          }
        },
        {
          "type": "promise",
          "settings": {
            "icon_preset": "gift",
            "title": "No Surprises",
            "text": "Everything arrives ready to install"
          }
        }
      ]
    }
  ]
}
{% endschema %}
