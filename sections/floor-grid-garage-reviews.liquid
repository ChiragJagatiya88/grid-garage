{%- comment -%}
  Figma node 551:1148 — Floor page: testimonials; carousel when more than 2 reviews.
{%- endcomment -%}
{{ 'floor-garage-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'floor-grid-garage-reviews.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign review_count = 0
  for block in section.blocks
    if block.type == 'review'
      assign review_count = review_count | plus: 1
    endif
  endfor
  assign use_slider = false
  if section.settings.reviews_slider_when_more_than_two and review_count > 2
    assign use_slider = true
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .flr-rev {
    --floor-accent: {{ section.settings.accent_color.red }},{{ section.settings.accent_color.green }},{{ section.settings.accent_color.blue }};
    --floor-rev-bg: {{ section.settings.background_color.red }},{{ section.settings.background_color.green }},{{ section.settings.background_color.blue }};
    --floor-rev-gap: {{ section.settings.grid_gap }}px;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="floor-sec flr-rev section-{{ section.id }}-padding" aria-labelledby="FloorRevTitle-{{ section.id }}">
  <div class="floor-sec__inner">
    <div class="flr-rev__head">
      {%- if section.settings.heading != blank -%}
        <h2 id="FloorRevTitle-{{ section.id }}" class="flr-rev__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="flr-rev__sub rte">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>

    <div
      class="flr-rev__outer{% if use_slider %} flr-rev__outer--slider{% endif %}{% if use_slider and section.settings.reviews_slider_show_arrows %} flr-rev__outer--has-arrows{% endif %}{% if use_slider and section.settings.reviews_slider_show_arrows and section.settings.reviews_slider_arrows_mobile == false %} flr-rev__outer--hide-arrows-mobile{% endif %}"
      data-flr-rev-root
      data-should-slider="{% if use_slider %}true{% else %}false{% endif %}"
      data-autoplay="{% if section.settings.reviews_slider_autoplay %}true{% else %}false{% endif %}"
      data-interval="{{ section.settings.reviews_slider_speed | times: 1000 }}"
      data-show-dots="{% if section.settings.reviews_slider_show_dots %}true{% else %}false{% endif %}"
      data-dot-label="{{ 'sections.floor_garage.reviews_dot_label' | t }}"
      data-live-template="{{ 'sections.floor_garage.reviews_live_region' | t }}"
    >
      <span class="visually-hidden" data-flr-rev-live aria-live="polite"></span>

      {%- if use_slider and section.settings.reviews_slider_show_arrows -%}
        <button
          type="button"
          class="flr-rev__arrow flr-rev__arrow--prev{% if section.settings.reviews_slider_arrow_transparent %} flr-rev__arrow--ghost{% else %} flr-rev__arrow--solid{% endif %}"
          data-flr-rev-prev
          aria-label="{{ 'sections.floor_garage.reviews_prev' | t }}"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true" focusable="false">
            <path stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6"/>
          </svg>
        </button>
      {%- endif -%}

      <div class="flr-rev__viewport" data-flr-rev-viewport>
        <div
          class="flr-rev__track{% if use_slider %} flr-rev__track--slider{% else %} flr-rev__track--static{% endif %}"
          data-flr-rev-track
          {% if use_slider %}role="list"{% endif %}
        >
          {%- for block in section.blocks -%}
            {%- if block.type == 'review' -%}
              <div class="flr-rev__slide" {% if use_slider %}role="listitem"{% endif %} {{ block.shopify_attributes }}>
                <blockquote class="flr-rev-card">
                  <div class="flr-rev-card__quote-icon" aria-hidden="true">
                    <img
                      class="flr-rev-card__quote-img"
                      src="{{ 'gg-quotation-icon.svg' | asset_url }}"
                      width="30"
                      height="30"
                      loading="lazy"
                      decoding="async"
                      alt=""
                    >
                  </div>
                  {%- assign star_n = block.settings.star_count | at_most: 5 | at_least: 1 -%}
                  <div class="flr-rev-card__stars" role="img" aria-label="{{ 'sections.floor_garage.stars_rating' | t: count: star_n }}">
                    {%- for i in (1..star_n) -%}
                      <img
                        class="flr-rev-card__star-img"
                        src="{{ 'icon-star-rounded-black.svg' | asset_url }}"
                        width="25"
                        height="25"
                        loading="lazy"
                        decoding="async"
                        alt=""
                      >
                    {%- endfor -%}
                  </div>
                  {%- if block.settings.quote != blank -%}
                    <p class="flr-rev-card__quote">{{ block.settings.quote | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.author != blank -%}
                    <p class="flr-rev-card__author">
                      <span class="flr-rev-card__author-name">{{ block.settings.author | escape }}</span>
                    </p>
                  {%- endif -%}
                </blockquote>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- if use_slider and section.settings.reviews_slider_show_arrows -%}
        <button
          type="button"
          class="flr-rev__arrow flr-rev__arrow--next{% if section.settings.reviews_slider_arrow_transparent %} flr-rev__arrow--ghost{% else %} flr-rev__arrow--solid{% endif %}"
          data-flr-rev-next
          aria-label="{{ 'sections.floor_garage.reviews_next' | t }}"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true" focusable="false">
            <path stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/>
          </svg>
        </button>
      {%- endif -%}

      {%- if use_slider and section.settings.reviews_slider_show_dots -%}
        <div class="flr-rev__dots" data-flr-rev-dots aria-label="{{ 'sections.floor_garage.reviews_carousel' | t }}"></div>
      {%- endif -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="flr-rev__cta">
        <a class="floor-sec__btn floor-sec__btn--solid" href="{{ section.settings.button_link | default: '#' }}">
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Floor: Testimonials",
  "tag": "section",
  "class": "section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Grid Garage Reviews"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>We take immense pride in showcasing the unfiltered voices of those who have chosen to be a part of the Grid Garage family. Explore the customer reviews below that speak to the quality, durability and trustworthiness that defines the Grid Garage brand.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Read all reviews"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "paragraph",
      "content": "Carousel activates when there are more than 2 review blocks."
    },
    {
      "type": "checkbox",
      "id": "reviews_slider_when_more_than_two",
      "label": "Use slider when more than 2 reviews",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "reviews_slider_show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "reviews_slider_arrows_mobile",
      "label": "Show arrows on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "reviews_slider_arrow_transparent",
      "label": "Transparent arrow background",
      "info": "When on, arrows only show the icon so content behind stays visible.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "reviews_slider_show_dots",
      "label": "Show dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "reviews_slider_autoplay",
      "label": "Auto-advance slides",
      "default": false
    },
    {
      "type": "range",
      "id": "reviews_slider_speed",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Auto-advance speed",
      "default": 5
    },
    {
      "type": "header",
      "content": "Colors and layout"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "info": "Used for buttons, arrows, author rules, and quotation circle.",
      "default": "#E11D48"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Space between review cards",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "star_count",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Stars",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Their product is absolutely outstanding! Very easy to install."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Jim K."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Floor: Testimonials",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "quote": "Their product is absolutely outstanding! I was considering an epoxy floor but the Grid Garage product has so many benefits over epoxy.",
            "author": "Jim K."
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "Incredible quality and customer service. Helped me through the entire process of picking the design, ordering and installation.",
            "author": "Mohammad S."
          }
        }
      ]
    }
  ]
}
{% endschema %}
