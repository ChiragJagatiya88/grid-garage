{%- comment -%}
  Full-width size guide banner: background image, dark overlay + vertical gradient, centered stack (icon, heading, sublines, highlight card).
{%- endcomment -%}

{%- liquid
  assign overlay_alpha = section.settings.overlay_opacity | times: 0.01
  assign gradient_top = section.settings.gradient_strength | times: 0.0045
  assign gradient_bottom = section.settings.gradient_strength | times: 0.0045

  assign img_desktop = section.settings.image
  assign img_mobile = section.settings.image_mobile
  assign img_fallback = img_desktop
  if img_fallback == blank
    assign img_fallback = img_mobile
  endif

  assign img_loading = 'lazy'
  if section.settings.image_loading == 'eager'
    assign img_loading = 'eager'
  endif

  assign show_sublist = false
  if section.settings.subtext_line_1 != blank or section.settings.subtext_line_2 != blank
    assign show_sublist = true
  endif

  assign max_w = section.settings.content_max_width
  if max_w <= 0
    assign max_w_css = 'none'
  else
    assign max_w_css = max_w | append: 'rem'
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .gg-size-banner__shell {
    --gg-size-banner-overlay-rgb: {{ section.settings.overlay_color.red }},{{ section.settings.overlay_color.green }},{{ section.settings.overlay_color.blue }};
    --gg-size-banner-overlay-alpha: {{ overlay_alpha }};
    --gg-size-banner-gradient-top: {{ gradient_top }};
    --gg-size-banner-gradient-bottom: {{ gradient_bottom }};
    --gg-size-banner-highlight-rgb: {{ section.settings.highlight_bg_color.red }},{{ section.settings.highlight_bg_color.green }},{{ section.settings.highlight_bg_color.blue }};
    --gg-size-banner-accent-rgb: {{ section.settings.accent_color.red }},{{ section.settings.accent_color.green }},{{ section.settings.accent_color.blue }};
    --gg-size-banner-img-pos: {{ section.settings.image_position }};
    --gg-size-banner-content-max: {{ max_w_css }};
    --gg-size-banner-inner-pt-m: {{ section.settings.inner_padding_top_mobile }}rem;
    --gg-size-banner-inner-pb-m: {{ section.settings.inner_padding_bottom_mobile }}rem;
    --gg-size-banner-inner-pt-d: {{ section.settings.inner_padding_top_desktop }}rem;
    --gg-size-banner-inner-pb-d: {{ section.settings.inner_padding_bottom_desktop }}rem;
  }

  {% if section.settings.min_height_desktop > 0 %}
    @media screen and (min-width: 990px) {
      #shopify-section-{{ section.id }} .gg-size-banner__shell {
        min-height: {{ section.settings.min_height_desktop }}rem;
      }
    }
  {% endif %}

  {%- comment -%}
    Fluid scale: 375px → 0, 990px → 1.
    Rem math: theme.liquid sets html font-size to ~62.5% × body_scale (Dawn ≈ 10px per rem), not 16px.
    Convert admin "px" targets with ×0.1 so 40px → 4rem ≈ 40px visually at default scale.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .gg-size-banner__stack {
    --gg-scale: clamp(0, (100vw - 23.4375rem) / 38.4375rem, 1);
    --gg-heading-min: {{ section.settings.heading_font_mobile | times: 0.1 }}rem;
    --gg-heading-max: {{ section.settings.heading_font_desktop | times: 0.1 }}rem;
    --gg-subtext-min: {{ section.settings.subtext_font_mobile | times: 0.1 }}rem;
    --gg-subtext-max: {{ section.settings.subtext_font_desktop | times: 0.1 }}rem;
    --gg-highlight-min: {{ section.settings.highlight_font_mobile | times: 0.1 }}rem;
    --gg-highlight-max: {{ section.settings.highlight_font_desktop | times: 0.1 }}rem;
    --gg-stack-gap-min: {{ section.settings.stack_gap_mobile | times: 0.1 }}rem;
    --gg-stack-gap-max: {{ section.settings.stack_gap_desktop | times: 0.1 }}rem;
    --gg-before-highlight-min: {{ section.settings.gap_before_highlight_mobile | times: 0.1 }}rem;
    --gg-before-highlight-max: {{ section.settings.gap_before_highlight_desktop | times: 0.1 }}rem;
    --gg-sublist-gap-min: {{ section.settings.sublist_row_gap_mobile | times: 0.1 }}rem;
    --gg-sublist-gap-max: {{ section.settings.sublist_row_gap_desktop | times: 0.1 }}rem;
    --gg-icon-w-min: {{ section.settings.icon_width_min }}px;
    --gg-icon-w-max: {{ section.settings.icon_width_max }}px;
  }
{%- endstyle -%}

{% stylesheet %}
  .gg-size-banner {
    max-width: 100%;
    overflow-x: clip;
    box-sizing: border-box;
  }

  .gg-size-banner__shell {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    min-height: 0;
  }

  .gg-size-banner__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .gg-size-banner__media img,
  .gg-size-banner__media .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--gg-size-banner-img-pos, center center);
    display: block;
  }

  .gg-size-banner__overlay-stack {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .gg-size-banner__overlay--base {
    position: absolute;
    inset: 0;
    background-color: rgb(var(--gg-size-banner-overlay-rgb) / var(--gg-size-banner-overlay-alpha, 0.6));
  }

  .gg-size-banner__overlay--gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / var(--gg-size-banner-gradient-top, 0.22)) 0%,
      rgb(0 0 0 / calc(var(--gg-size-banner-gradient-top, 0.22) * 0.45)) 28%,
      transparent 42%,
      transparent 58%,
      rgb(0 0 0 / var(--gg-size-banner-gradient-bottom, 0.22)) 100%
    );
  }

  .gg-size-banner__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--gg-size-banner-content-max, none);
    min-width: 0;
    margin-inline: auto;
    padding-top: var(--gg-size-banner-inner-pt-m, 2rem);
    padding-bottom: var(--gg-size-banner-inner-pb-m, 2rem);
    padding-inline: min(1.5rem, 5vw);
    box-sizing: border-box;
  }

  @media screen and (min-width: 990px) {
    .gg-size-banner__inner {
      padding-top: var(--gg-size-banner-inner-pt-d, 3rem);
      padding-bottom: var(--gg-size-banner-inner-pb-d, 3rem);
      padding-inline: 2rem;
    }
  }

  .gg-size-banner__stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  /* Tight vertical rhythm: icon → heading → bullets (matches design ~15–20px / ~20px) */
  .gg-size-banner__stack-primary {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-x: clip;
    gap: calc(
      var(--gg-stack-gap-min, 1.6rem) + (var(--gg-stack-gap-max, 2rem) - var(--gg-stack-gap-min, 1.6rem)) * var(--gg-scale, 1)
    );
  }

  .gg-size-banner__icon {
    display: flex;
    line-height: 0;
    color: rgb(var(--gg-size-banner-accent-rgb));
  }

  .gg-size-banner__icon svg {
    display: block;
    width: calc(
      var(--gg-icon-w-min, 36px) + (var(--gg-icon-w-max, 50px) - var(--gg-icon-w-min, 36px)) * var(--gg-scale, 1)
    );
    height: auto;
    aspect-ratio: 50 / 30;
    overflow: visible;
  }

  .gg-size-banner__icon svg path {
    fill: currentColor;
  }

  /* h2 + two classes: beat base.css h2 and .gg-font-heading line-height */
  h2.gg-size-banner__heading.gg-font-heading {
    margin: 0;
    font-weight: 700;
    color: rgb(255, 255, 255);
    line-height: 1.2;
    max-width: 100%;
    width: 100%;
    min-width: 0;
    letter-spacing: 0;
    font-size: calc(
      var(--gg-heading-min, 2.8rem) + (var(--gg-heading-max, 4rem) - var(--gg-heading-min, 2.8rem)) * var(--gg-scale, 1)
    );
    white-space: normal;
    overflow-wrap: break-word;
    word-wrap: break-word;
    hyphens: auto;
  }

  @media screen and (min-width: 990px) {
    h2.gg-size-banner__heading.gg-font-heading {
      font-size: var(--gg-heading-max);
    }
  }

  .gg-size-banner__sublist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: calc(
      var(--gg-stack-gap-min, 1.6rem) + (var(--gg-stack-gap-max, 2rem) - var(--gg-stack-gap-min, 1.6rem)) * var(--gg-scale, 1)
    );
    color: rgb(255, 255, 255);
    font-weight: 400;
    font-size: calc(
      var(--gg-subtext-min, 1.6rem) + (var(--gg-subtext-max, 1.8rem) - var(--gg-subtext-min, 1.6rem)) * var(--gg-scale, 1)
    );
    line-height: 1.45;
    max-width: 100%;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    overflow-x: clip;
  }

  @media screen and (min-width: 750px) {
    .gg-size-banner__sublist {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      column-gap: calc(
        var(--gg-sublist-gap-min, 2.4rem) + (var(--gg-sublist-gap-max, 4rem) - var(--gg-sublist-gap-min, 2.4rem)) * var(--gg-scale, 1)
      );
    }
  }

  @media screen and (min-width: 990px) {
    .gg-size-banner__sublist {
      font-size: var(--gg-subtext-max);
      column-gap: var(--gg-sublist-gap-max);
    }
  }

  .gg-size-banner__subitem {
    max-width: 100%;
    min-width: 0;
    padding-inline: 0;
    text-align: center;
    white-space: normal;
    overflow-wrap: break-word;
    word-wrap: break-word;
    box-sizing: border-box;
  }

  .gg-size-banner__subitem::before {
    content: '• ';
    font-weight: 700;
  }

  /* Extra space above callout (~40px desktop vs ~20px between icon/heading/bullets) */
  .gg-size-banner__highlight {
    position: relative;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin-inline: auto;
    margin-top: calc(
      var(--gg-before-highlight-min, 2.8rem) + (var(--gg-before-highlight-max, 4rem) - var(--gg-before-highlight-min, 2.8rem)) * var(--gg-scale, 1)
    );
    padding-block: 1.25rem;
    padding-inline: 1.25rem;
    padding-left: calc(1.25rem + 5px);
    border-radius: 0.25rem;
    background-color: rgb(var(--gg-size-banner-highlight-rgb, 26, 26, 26));
    box-sizing: border-box;
  }

  .gg-size-banner__highlight-track {
    display: block;
    width: 100%;
    min-width: 0;
    overflow-x: clip;
  }

  @media screen and (min-width: 750px) {
    .gg-size-banner__highlight {
      padding-block: 5rem;
      padding-inline: 2.5rem;
      padding-left: calc(2.5rem + 5px);
    }
  }

  .gg-size-banner__highlight::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px;
    background-color: rgb(var(--gg-size-banner-accent-rgb));
    border-radius: 0.25rem 0 0 0.25rem;
  }

  .gg-size-banner__highlight-text {
    margin: 0;
    text-align: center;
    color: rgb(255, 255, 255);
    font-style: italic;
    font-weight: 700;
    font-size: calc(
      var(--gg-highlight-min, 1.7rem) + (var(--gg-highlight-max, 1.8rem) - var(--gg-highlight-min, 1.7rem)) * var(--gg-scale, 1)
    );
    line-height: 1.35;
    max-width: 100%;
    white-space: normal;
    overflow-wrap: break-word;
    word-wrap: break-word;
    hyphens: auto;
  }

  @media screen and (min-width: 990px) {
    .gg-size-banner__highlight-text {
      font-size: var(--gg-highlight-max);
    }

    .gg-size-banner__stack-primary {
      gap: var(--gg-stack-gap-max);
    }

    .gg-size-banner__highlight {
      margin-top: var(--gg-before-highlight-max);
    }
  }
{% endstylesheet %}

<section
  class="gg-size-banner section-{{ section.id }}-padding"
  {% if section.settings.heading != blank %}
    aria-labelledby="gg-size-banner-title-{{ section.id }}"
  {% endif %}
>
  <div class="gg-size-banner__shell">
    <div class="gg-size-banner__media">
      {%- if img_fallback != blank -%}
        <picture>
          {%- if img_mobile != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="
                {{- img_mobile | image_url: width: 375 }} 375w,
                {{- img_mobile | image_url: width: 550 }} 550w,
                {{- img_mobile | image_url: width: 750 }} 750w,
                {{- img_mobile | image_url: width: 1100 }} 1100w
              "
              sizes="100vw"
            >
          {%- endif -%}
          {%- liquid
            assign banner_alt = img_fallback.alt | default: section.settings.image_alt
          -%}
          {{
            img_fallback
            | image_url: width: 3840
            | image_tag:
              loading: img_loading,
              sizes: '100vw',
              widths: '375,550,750,1100,1500,1780,2000,3000,3840',
              alt: banner_alt | escape
          }}
        </picture>
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    <div class="gg-size-banner__overlay-stack" aria-hidden="true">
      <div class="gg-size-banner__overlay gg-size-banner__overlay--base"></div>
      <div class="gg-size-banner__overlay gg-size-banner__overlay--gradient"></div>
    </div>

    <div class="gg-size-banner__inner">
      <div class="gg-size-banner__stack">
        <div class="gg-size-banner__stack-primary">
          {%- if section.settings.show_icon -%}
            <span class="gg-size-banner__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 50 30" fill="none" focusable="false" aria-hidden="true">
                <path
                  d="M5 30C3.625 30 2.44792 29.5104 1.46875 28.5312C0.489583 27.5521 0 26.375 0 25V5C0 3.625 0.489583 2.44792 1.46875 1.46875C2.44792 0.489583 3.625 0 5 0H45C46.375 0 47.5521 0.489583 48.5312 1.46875C49.5104 2.44792 50 3.625 50 5V25C50 26.375 49.5104 27.5521 48.5312 28.5312C47.5521 29.5104 46.375 30 45 30H5ZM5 25H45V5H37.5V15H32.5V5H27.5V15H22.5V5H17.5V15H12.5V5H5V25ZM12.5 15H17.5H12.5ZM22.5 15H27.5H22.5ZM32.5 15H37.5H32.5Z"
                  fill="currentColor"
                />
              </svg>
            </span>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="gg-size-banner__heading gg-font-heading" id="gg-size-banner-title-{{ section.id }}">
              {{- section.settings.heading | escape -}}
            </h2>
          {%- endif -%}

          {%- if show_sublist -%}
            <ul class="gg-size-banner__sublist" role="list">
              {%- if section.settings.subtext_line_1 != blank -%}
                <li class="gg-size-banner__subitem">{{ section.settings.subtext_line_1 | escape }}</li>
              {%- endif -%}
              {%- if section.settings.subtext_line_2 != blank -%}
                <li class="gg-size-banner__subitem">{{ section.settings.subtext_line_2 | escape }}</li>
              {%- endif -%}
            </ul>
          {%- endif -%}
        </div>

        {%- if section.settings.highlight_text != blank -%}
          <aside
            class="gg-size-banner__highlight"
            aria-label="{{ 'sections.gg_size_guide_banner.highlight_aria' | t | escape }}"
          >
            <div class="gg-size-banner__highlight-track">
              <p class="gg-size-banner__highlight-text">{{ section.settings.highlight_text | escape }}</p>
            </div>
          </aside>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GG: Size guide banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image — large screens"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image — mobile (optional)"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Garage floor with grid tiles"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focal point",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "image_loading",
      "label": "Image loading",
      "options": [
        { "value": "lazy", "label": "Lazy" },
        { "value": "eager", "label": "Eager" }
      ],
      "default": "lazy",
      "info": "Use Eager when this section is above the fold."
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 60
    },
    {
      "type": "range",
      "id": "gradient_strength",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Top and bottom gradient strength",
      "default": 85,
      "info": "Darkens the top and bottom of the banner for depth."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": true
    },
    {
      "type": "range",
      "id": "icon_width_min",
      "min": 28,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Icon width — small screens",
      "default": 40,
      "info": "Scales up toward max width. Artwork is 50×30 px."
    },
    {
      "type": "range",
      "id": "icon_width_max",
      "min": 40,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Icon width — large screens",
      "default": 52,
      "info": "Height follows 50:30 (30 px at 50 px width)."
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "Not sure which size you need?"
    },
    {
      "type": "range",
      "id": "heading_font_mobile",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Heading font size — small screens",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_font_desktop",
      "min": 18,
      "max": 52,
      "step": 1,
      "unit": "px",
      "label": "Heading font size — large screens",
      "default": 40
    },
    {
      "type": "header",
      "content": "Subtext lines"
    },
    {
      "type": "text",
      "id": "subtext_line_1",
      "label": "Line 1",
      "default": "2-car garage = most homes"
    },
    {
      "type": "text",
      "id": "subtext_line_2",
      "label": "Line 2",
      "default": "3-car garage = larger or extended garages"
    },
    {
      "type": "range",
      "id": "subtext_font_mobile",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtext font size — small screens",
      "default": 16
    },
    {
      "type": "range",
      "id": "subtext_font_desktop",
      "min": 14,
      "max": 26,
      "step": 1,
      "unit": "px",
      "label": "Subtext font size — large screens",
      "default": 18,
      "info": "Design reference: 16–18 px on large screens."
    },
    {
      "type": "header",
      "content": "Highlight message"
    },
    {
      "type": "textarea",
      "id": "highlight_text",
      "label": "Highlight text",
      "default": "When in doubt, size up — every kit includes extra tiles"
    },
    {
      "type": "range",
      "id": "highlight_font_mobile",
      "min": 14,
      "max": 26,
      "step": 1,
      "unit": "px",
      "label": "Highlight font size — small screens",
      "default": 17
    },
    {
      "type": "range",
      "id": "highlight_font_desktop",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Highlight font size — large screens",
      "default": 18,
      "info": "Bold italic callout; ~18 px on large screens."
    },
    {
      "type": "header",
      "content": "Spacing between blocks"
    },
    {
      "type": "range",
      "id": "stack_gap_mobile",
      "min": 8,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Gap — icon, heading, bullets (small screens)",
      "default": 16,
      "info": "Space between icon, title, and bullet lines only."
    },
    {
      "type": "range",
      "id": "stack_gap_desktop",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Gap — icon, heading, bullets (large screens)",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap_before_highlight_mobile",
      "min": 16,
      "max": 56,
      "step": 2,
      "unit": "px",
