{% render 'if-swiper' %}
{{ 'if-spaces-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign if_accent = section.settings.accent_color | default: '#DC1C1B'
  assign if_bg = section.settings.section_bg | default: '#FFFFFF'
  assign if_space_blocks = section.blocks | where: 'type', 'space'
  assign if_per_page = section.settings.mobile_per_page | default: 3
-%}

<div
  id="if-spc-{{ section.id }}"
  class="section_{{ section.id }} if-spc{% if section.settings.enable_custom_class and section.settings.section_class != blank %} {{ section.settings.section_class }}{% endif %}"
  data-if-spc
  data-per-page="{{ if_per_page }}"
  style="--if-spc-accent: {{ if_accent }}; --if-spc-bg: {{ if_bg }};"
>
  <div class="{% if section.settings.enable_container %}if-spc__inner{% else %}if-spc__inner if-spc__inner--fluid{% endif %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="if-spc__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- comment -%} Desktop grid {%- endcomment -%}
    <div class="if-spc__grid" data-if-spc-grid>
      {%- for block in if_space_blocks -%}
        {%- if block.settings.link != blank -%}
          <a class="if-spc__card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
        {%- else -%}
          <div class="if-spc__card" {{ block.shopify_attributes }}>
        {%- endif -%}
          <div class="if-spc__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 990px) 30vw, 90vw',
                  widths: '400,600,900,1200',
                  alt: block.settings.title | escape
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          {%- if block.settings.title != blank -%}
            <span class="if-spc__label">{{ block.settings.title | escape }}</span>
          {%- endif -%}
        {%- if block.settings.link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Mobile: Swiper pages (N cards per slide) {%- endcomment -%}
    <div class="if-spc__mobile" data-if-spc-mobile>
      <div class="if-spc__slider swiper" data-if-spc-slider>
        <div class="swiper-wrapper">
          {%- assign if_page_end = if_per_page | minus: 1 -%}
          {%- for block in if_space_blocks -%}
            {%- assign if_idx0 = forloop.index0 -%}
            {%- assign if_mod = if_idx0 | modulo: if_per_page -%}
            {%- if if_mod == 0 -%}
              <div class="swiper-slide">
                <div class="if-spc__page">
            {%- endif -%}

                  {%- if block.settings.link != blank -%}
                    <a class="if-spc__card" href="{{ block.settings.link }}">
                  {%- else -%}
                    <div class="if-spc__card">
                  {%- endif -%}
                    <div class="if-spc__media">
                      {%- if block.settings.image != blank -%}
                        {{
                          block.settings.image
                          | image_url: width: 1000
                          | image_tag:
                            loading: 'lazy',
                            sizes: '90vw',
                            widths: '400,600,900,1000',
                            alt: block.settings.title | escape
                        }}
                      {%- else -%}
                        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      {%- endif -%}
                    </div>
                    {%- if block.settings.title != blank -%}
                      <span class="if-spc__label">{{ block.settings.title | escape }}</span>
                    {%- endif -%}
                  {%- if block.settings.link != blank -%}
                    </a>
                  {%- else -%}
                    </div>
                  {%- endif -%}

            {%- if if_mod == if_page_end or forloop.last -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- if if_space_blocks.size > if_per_page -%}
        <div class="if-spc__pager" data-if-spc-pager>
          <button type="button" class="if-spc__nav-btn" data-if-spc-prev aria-label="Previous page">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="if-spc__pages" data-if-spc-pages></div>
          <button type="button" class="if-spc__nav-btn" data-if-spc-next aria-label="Next page">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script src="{{ 'if-spaces-grid.js' | asset_url }}" defer></script>

{% style %}
  .section_{{ section.id }} {
    {% if section.settings.section_bg != blank %}background: {{ section.settings.section_bg }};{% endif %}
    {% if section.settings.section_gradient_bg != blank %}background: {{ section.settings.section_gradient_bg }};{% endif %}
    {% if section.settings.enable_custom_padding %}padding-block: {{ section.settings.padding_desk }};{% endif %}
  }
  @media screen and (max-width: 767px) {
    .section_{{ section.id }} {
      {% if section.settings.enable_custom_padding %}padding-block: {{ section.settings.padding_mob }};{% endif %}
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "IF Spaces Grid",
  "tag": "section",
  "class": "if_spaces_grid",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_class",
      "label": "Enable custom class",
      "default": false
    },
    {
      "type": "text",
      "id": "section_class",
      "label": "Custom class",
      "visible_if": "{{ section.settings.enable_custom_class == true }}"
    },
    {
      "type": "checkbox",
      "id": "enable_container",
      "label": "Enable container",
      "default": true
    },
    {
      "type": "range",
      "id": "mobile_per_page",
      "label": "Mobile cards per page",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More Than Just a Garage Floor"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color_background",
      "id": "section_gradient_bg",
      "label": "Section gradient background"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Label / pagination accent",
      "default": "#DC1C1B"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_padding",
      "label": "Enable custom padding",
      "default": true
    },
    {
      "type": "text",
      "id": "padding_desk",
      "label": "Padding desktop",
      "default": "56px 0",
      "visible_if": "{{ section.settings.enable_custom_padding == true }}"
    },
    {
      "type": "text",
      "id": "padding_mob",
      "label": "Padding mobile",
      "default": "36px 0",
      "visible_if": "{{ section.settings.enable_custom_padding == true }}"
    }
  ],
  "blocks": [
    {
      "type": "space",
      "name": "Space",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Garage"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IF Spaces Grid",
      "blocks": [
        { "type": "space", "settings": { "title": "Garage" } },
        { "type": "space", "settings": { "title": "Home Gyms" } },
        { "type": "space", "settings": { "title": "Man Caves" } },
        { "type": "space", "settings": { "title": "Workshops" } },
        { "type": "space", "settings": { "title": "Basements" } },
        { "type": "space", "settings": { "title": "Patios" } }
      ]
    }
  ]
}
{% endschema %}
