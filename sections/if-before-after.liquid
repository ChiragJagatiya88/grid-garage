{{ 'if-before-after.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign if_accent = section.settings.accent_color | default: '#DC1C1B'
  assign if_bg = section.settings.section_bg | default: '#F7F7F7'
  assign if_pos = section.settings.initial_position | default: 50
-%}

<div
  id="if-ba-{{ section.id }}"
  class="section_{{ section.id }} if-ba{% if section.settings.enable_custom_class and section.settings.section_class != blank %} {{ section.settings.section_class }}{% endif %}"
  data-if-ba
  style="
    --if-ba-accent: {{ if_accent }};
    --if-ba-bg: {{ if_bg }};
    --if-ba-pos: {{ if_pos }}%;
    --if-ba-ratio: {{ section.settings.aspect_w | default: 16 }} / {{ section.settings.aspect_h | default: 9 }};
  "
>
  <div class="{% if section.settings.enable_container %}if-ba__inner{% else %}if-ba__inner if-ba__inner--fluid{% endif %}">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="if-ba__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="if-ba__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="if-ba__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div
      class="if-ba__viewport"
      data-if-ba-viewport
      role="region"
      aria-label="Before and after image comparison"
      style="--if-ba-pos: {{ if_pos }}%;"
    >
      {%- comment -%} After sits underneath (full width) {%- endcomment -%}
      <div class="if-ba__layer if-ba__layer--after" aria-hidden="true">
        {%- if section.settings.after_image != blank -%}
          {{
            section.settings.after_image
            | image_url: width: 2400
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 990px) min(100vw, var(--page-width)), 100vw',
              widths: '750,1100,1500,2000,2400',
              alt: section.settings.after_image.alt | default: section.settings.after_label | escape
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      {%- comment -%} Before clipped from the left by --if-ba-pos {%- endcomment -%}
      <div class="if-ba__layer if-ba__layer--before" data-if-ba-before>
        {%- if section.settings.before_image != blank -%}
          {{
            section.settings.before_image
            | image_url: width: 2400
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 990px) min(100vw, var(--page-width)), 100vw',
              widths: '750,1100,1500,2000,2400',
              alt: section.settings.before_image.alt | default: section.settings.before_label | escape
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      {%- if section.settings.before_label != blank -%}
        <span class="if-ba__label if-ba__label--before">
          <span class="if-ba__label-text">{{ section.settings.before_label | escape }}</span>
        </span>
      {%- endif -%}
      {%- if section.settings.after_label != blank -%}
        <span class="if-ba__label if-ba__label--after">
          <span class="if-ba__label-text">{{ section.settings.after_label | escape }}</span>
        </span>
      {%- endif -%}

      <div class="if-ba__divider" aria-hidden="true"></div>

      <button
        type="button"
        class="if-ba__handle"
        data-if-ba-handle
        aria-label="Drag to compare before and after"
      >
        <svg width="22" height="14" viewBox="0 0 22 14" fill="none" aria-hidden="true">
          <path d="M8 1L2 7l6 6M14 1l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<script src="{{ 'if-before-after.js' | asset_url }}" defer></script>

{% style %}
  .section_{{ section.id }} {
    {% if section.settings.section_bg != blank %}background: {{ section.settings.section_bg }};{% endif %}
    {% if section.settings.section_gradient_bg != blank %}background: {{ section.settings.section_gradient_bg }};{% endif %}
    {% if section.settings.enable_custom_padding %}padding-block: {{ section.settings.padding_desk }};{% endif %}
  }
  @media screen and (max-width: 767px) {
    .section_{{ section.id }} {
      {% if section.settings.enable_custom_padding %}padding-block: {{ section.settings.padding_mob }};{% endif %}
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "IF Before After Slider",
  "tag": "section",
  "class": "if_before_after",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_class",
      "label": "Enable custom class",
      "default": false
    },
    {
      "type": "text",
      "id": "section_class",
      "label": "Custom class",
      "visible_if": "{{ section.settings.enable_custom_class == true }}"
    },
    {
      "type": "checkbox",
      "id": "enable_container",
      "label": "Enable container",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "BEFORE"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "AFTER"
    },
    {
      "type": "range",
      "id": "initial_position",
      "min": 5,
      "max": 95,
      "step": 1,
      "unit": "%",
      "label": "Starting position",
      "default": 50
    },
    {
      "type": "range",
      "id": "aspect_w",
      "min": 1,
      "max": 32,
      "step": 1,
      "label": "Aspect ratio width",
      "default": 16
    },
    {
      "type": "range",
      "id": "aspect_h",
      "min": 1,
      "max": 24,
      "step": 1,
      "label": "Aspect ratio height",
      "default": 9
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#F7F7F7"
    },
    {
      "type": "color_background",
      "id": "section_gradient_bg",
      "label": "Section gradient background"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Handle / After badge",
      "default": "#DC1C1B"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_padding",
      "label": "Enable custom padding",
      "default": true
    },
    {
      "type": "text",
      "id": "padding_desk",
      "label": "Padding desktop",
      "default": "48px 0",
      "visible_if": "{{ section.settings.enable_custom_padding == true }}"
    },
    {
      "type": "text",
      "id": "padding_mob",
      "label": "Padding mobile",
      "default": "32px 0",
      "visible_if": "{{ section.settings.enable_custom_padding == true }}"
    }
  ],
  "presets": [
    {
      "name": "IF Before After Slider"
    }
  ]
}
{% endschema %}
