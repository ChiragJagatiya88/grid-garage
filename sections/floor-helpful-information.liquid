{%- comment -%}
  Figma node 551:1229 — Floor page: black support column + full-height image.
{%- endcomment -%}
{{ 'floor-garage-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign grid_class = 'flr-help__grid'
  if section.settings.image_position == 'left'
    assign grid_class = grid_class | append: ' flr-help__grid--media-left'
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .flr-help {
    --floor-accent: {{ section.settings.accent_color.red }},{{ section.settings.accent_color.green }},{{ section.settings.accent_color.blue }};
    --floor-help-min-h: {{ section.settings.min_height }}px;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="floor-sec flr-help section-{{ section.id }}-padding" aria-labelledby="FloorHelpTitle-{{ section.id }}">
  <div class="{{ grid_class }}">
    <div class="flr-help__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="flr-help__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 id="FloorHelpTitle-{{ section.id }}" class="flr-help__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="flr-help__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}

      <ul class="flr-help__list">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'link' -%}
              <li class="flr-help__item" {{ block.shopify_attributes }}>
                <span class="flr-help__item-icon">
                  {%- if block.settings.icon != blank -%}
                    {{
                      block.settings.icon
                      | image_url: width: 64
                      | image_tag:
                        loading: 'lazy',
                        widths: '32,64',
                        alt: ''
                    }}
                  {%- else -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <circle cx="8" cy="8" r="7" stroke="white" stroke-width="1.5"/>
                      <path d="M8 11V8M8 5h.01" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  {%- endif -%}
                </span>
                {%- if block.settings.label != blank -%}
                  <a href="{{ block.settings.link | default: '#' }}">{{ block.settings.label | escape }}</a>
                {%- endif -%}
              </li>
          {%- endcase -%}
        {%- endfor -%}
      </ul>

      {%- if section.settings.button_label != blank -%}
        <a class="floor-sec__btn floor-sec__btn--solid" href="{{ section.settings.button_link | default: '#' }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    <div class="flr-help__media">
      {%- if section.settings.video != blank -%}
        {%- liquid
          assign flr_help_autoplay = section.settings.video_autoplay
        -%}
        {{
          section.settings.video
          | video_tag:
            image_size: '2000x',
            autoplay: flr_help_autoplay,
            loop: flr_help_autoplay,
            muted: flr_help_autoplay,
            controls: true,
            class: 'flr-help__video'
        }}
      {%- elsif section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 2000
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 990px) 50vw, 100vw',
            widths: '750,1100,1500,2000',
            alt: section.settings.image.alt | escape
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Floor: Help + image",
  "tag": "section",
  "class": "section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Garage floor tiles /"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Helpful information"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>From start to finish, we strive to support Grid Garage customers from the initial interest phase, through installation and maintenance.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View support resources"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Used when no video is selected."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Optional. When added, it replaces the image."
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "Autoplay video",
      "info": "When on, the video plays muted and loops (required for autoplay in browsers). When off, visitors use the play control.",
      "default": false
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (large screens)",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#E11D48"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Minimum height (large screens)",
      "default": 680
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Use white artwork on transparent background for best results."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Garage floor tile FAQs"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Floor: Help + image",
      "blocks": [
        { "type": "link", "settings": { "label": "Garage floor tile FAQs" } },
        { "type": "link", "settings": { "label": "Order sample tile packs" } },
        { "type": "link", "settings": { "label": "Installing Grid Garage garage floor tiles" } },
        { "type": "link", "settings": { "label": "Cleaning" } },
        { "type": "link", "settings": { "label": "Garage flooring knowledge center" } }
      ]
    }
  ]
}
{% endschema %}
