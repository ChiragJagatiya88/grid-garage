{{ 'if-product-details.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign if_accent = section.settings.accent_color | default: '#DC1C1B'
  assign if_bg = section.settings.section_bg | default: '#FFFFFF'
  assign if_card_bg = section.settings.card_bg | default: '#FFFFFF'
  assign if_card_glow = section.settings.card_glow | default: '#DC1C1B'
  assign if_detail_image = section.settings.image
  if if_detail_image == blank and product.featured_image != blank
    assign if_detail_image = product.featured_image
  endif
-%}

<div
  id="if-pd-{{ section.id }}"
  class="section_{{ section.id }} if-pd{% if section.settings.enable_custom_class and section.settings.section_class != blank %} {{ section.settings.section_class }}{% endif %}"
  style="
    --if-pd-accent: {{ if_accent }};
    --if-pd-bg: {{ if_bg }};
    --if-pd-card-bg: {{ if_card_bg }};
    --if-pd-card-glow: {{ if_card_glow }};
    --if-pd-leader: {{ if_accent }};
  "
>
  <div class="{% if section.settings.enable_container %}if-pd__inner{% else %}if-pd__inner if-pd__inner--fluid{% endif %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="if-pd__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="if-pd__layout">
      <div class="if-pd__media">
        {%- if if_detail_image != blank -%}
          {{
            if_detail_image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 990px) 420px, 90vw',
              widths: '400,600,800,1200',
              alt: section.settings.heading | default: product.title | escape
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'detail' -%}
          {%- assign pos = block.settings.position | default: 'bottom' -%}
          <article
            class="if-pd__card if-pd__card--{{ pos }}"
            {{ block.shopify_attributes }}
          >
            <div class="if-pd__card-content">
              {%- if block.settings.title != blank -%}
                <h3 class="if-pd__card-title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.value != blank -%}
                <p class="if-pd__card-value">{{ block.settings.value | escape }}</p>
              {%- endif -%}
            </div>
            <svg class="if-pd__leader" viewBox="0 0 72 48" fill="none" aria-hidden="true" focusable="false">
              {%- case pos -%}
                {%- when 'tl' -%}
                  <path d="M2 22 C28 22 44 10 66 8" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3.2 4.2" stroke-linecap="round"/>
                  <circle cx="68" cy="8" r="3" fill="currentColor"/>
                {%- when 'ml' -%}
                  <path d="M2 24 C28 24 44 34 66 40" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3.2 4.2" stroke-linecap="round"/>
                  <circle cx="68" cy="40" r="3" fill="currentColor"/>
                {%- when 'tr' -%}
                  <path d="M70 22 C44 22 28 10 6 8" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3.2 4.2" stroke-linecap="round"/>
                  <circle cx="4" cy="8" r="3" fill="currentColor"/>
                {%- when 'mr' -%}
                  <path d="M70 24 C44 24 28 34 6 40" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3.2 4.2" stroke-linecap="round"/>
                  <circle cx="4" cy="40" r="3" fill="currentColor"/>
              {%- endcase -%}
            </svg>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% style %}
  .section_{{ section.id }} {
    {% if section.settings.section_bg != blank %}background: {{ section.settings.section_bg }};{% endif %}
    {% if section.settings.section_gradient_bg != blank %}background: {{ section.settings.section_gradient_bg }};{% endif %}
    {% if section.settings.enable_custom_padding %}padding-block: {{ section.settings.padding_desk }};{% endif %}
  }
  @media screen and (max-width: 767px) {
    .section_{{ section.id }} {
      {% if section.settings.enable_custom_padding %}padding-block: {{ section.settings.padding_mob }};{% endif %}
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "IF Product Details",
  "tag": "section",
  "class": "if_product_details",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_class",
      "label": "Enable custom class",
      "default": false
    },
    {
      "type": "text",
      "id": "section_class",
      "label": "Custom class",
      "visible_if": "{{ section.settings.enable_custom_class == true }}"
    },
    {
      "type": "checkbox",
      "id": "enable_container",
      "label": "Enable container",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product Details"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image",
      "info": "Falls back to the current product image if empty"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color_background",
      "id": "section_gradient_bg",
      "label": "Section gradient background"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#DC1C1B"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Pill background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_glow",
      "label": "Pill edge glow",
      "default": "#DC1C1B"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_padding",
      "label": "Enable custom padding",
      "default": true
    },
    {
      "type": "text",
      "id": "padding_desk",
      "label": "Padding desktop",
      "default": "56px 0",
      "visible_if": "{{ section.settings.enable_custom_padding == true }}"
    },
    {
      "type": "text",
      "id": "padding_mob",
      "label": "Padding mobile",
      "default": "36px 0",
      "visible_if": "{{ section.settings.enable_custom_padding == true }}"
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Detail",
      "settings": [
        {
          "type": "select",
          "id": "position",
          "label": "Desktop position",
          "options": [
            { "value": "tl", "label": "Top left" },
            { "value": "ml", "label": "Middle left" },
            { "value": "tr", "label": "Top right" },
            { "value": "mr", "label": "Middle right" },
            { "value": "bottom", "label": "Bottom center" }
          ],
          "default": "bottom"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Tile Size"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "17\" X 17\""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IF Product Details",
      "blocks": [
        {
          "type": "detail",
          "settings": {
            "position": "tl",
            "title": "Tile Size",
            "value": "17\" X 17\""
          }
        },
        {
          "type": "detail",
          "settings": {
            "position": "tr",
            "title": "Use",
            "value": "Indoor / Garage"
          }
        },
        {
          "type": "detail",
          "settings": {
            "position": "ml",
            "title": "Material",
            "value": "Premium Polypropylene"
          }
        },
        {
          "type": "detail",
          "settings": {
            "position": "mr",
            "title": "Drainage",
            "value": "Maximum Perforated"
          }
        },
        {
          "type": "detail",
          "settings": {
            "position": "bottom",
            "title": "Durability",
            "value": "Up to 75,000 lbs"
          }
        }
      ]
    }
  ]
}
{% endschema %}
