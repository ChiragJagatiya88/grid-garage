{%- comment -%}
  CTA hero: full-bleed image, dark overlay, heading, dual primary CTAs. Alignment: left / center / right (desktop); mobile stacks and centers.
{%- endcomment -%}
{%- liquid
  assign overlay_op = section.settings.overlay_opacity | times: 0.01
  assign grad_op = section.settings.gradient_opacity | times: 0.01

  case section.settings.content_alignment
    when 'left'
      assign align_class = 'gg-cta-hero--align-left'
    when 'right'
      assign align_class = 'gg-cta-hero--align-right'
    else
      assign align_class = 'gg-cta-hero--align-center'
  endcase

  assign has_desktop = false
  if section.settings.image != blank
    assign has_desktop = true
  endif

-%}

<style>
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .gg-cta-hero {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    color: rgb(255, 255, 255);
    --gg-cta-overlay-opacity: {{ overlay_op }};
    --gg-cta-gradient-opacity: {{ grad_op }};
    --gg-cta-min-h-desktop: {{ section.settings.min_height_desktop }}px;
    --gg-cta-inner-pad-x: {{ section.settings.inner_padding_horizontal }}px;
    --gg-cta-content-max: {{ section.settings.content_max_width }}px;
    --gg-cta-heading-mt-buttons: {{ section.settings.heading_button_gap }}px;
    --gg-cta-btn-gap: {{ section.settings.button_gap }}px;
    /* Figma (px → Dawn rem, 1rem ≈ 10px): 58×205.64, pad 17 / 31 / 31.64 */
    --gg-cta-btn-min-h: 5.8rem;
    --gg-cta-btn-min-w: 20.564rem;
    --gg-cta-btn-pad-y: 1.7rem;
    --gg-cta-btn-pad-x-l: 3.1rem;
    --gg-cta-btn-pad-x-r: 3.164rem;
    --gg-cta-btn-fs: 1.6rem;
    /* Heading: 40px desktop (4rem); scales down on small viewports (Dawn 1rem ≈ 10px) */
    --gg-cta-heading-fs-min: 2.4rem;
    --gg-cta-heading-fs-max: 4rem;
    --gg-cta-overlay-rgb: {{ section.settings.overlay_color.red }},{{ section.settings.overlay_color.green }},{{ section.settings.overlay_color.blue }};
    --gg-cta-btn-rgb: {{ section.settings.button_color.red }},{{ section.settings.button_color.green }},{{ section.settings.button_color.blue }};
    --gg-cta-btn-hover-rgb: {{ section.settings.button_hover_color.red }},{{ section.settings.button_hover_color.green }},{{ section.settings.button_hover_color.blue }};
    --gg-cta-img-pos: {{ section.settings.image_position }};
  }

  #shopify-section-{{ section.id }} .gg-cta-hero__media .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .gg-cta-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .gg-cta-hero__media picture,
  #shopify-section-{{ section.id }} .gg-cta-hero__media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: var(--gg-cta-img-pos, center center);
  }

  #shopify-section-{{ section.id }} .gg-cta-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: rgb(var(--gg-cta-overlay-rgb, 0, 0, 0));
    opacity: var(--gg-cta-overlay-opacity, 0.55);
  }

  #shopify-section-{{ section.id }} .gg-cta-hero__overlay-gradient {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: var(--gg-cta-gradient-opacity, 0);
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.75) 100%);
  }

  #shopify-section-{{ section.id }} .gg-cta-hero__overlay-gradient.is-hidden {
    display: none;
  }

  #shopify-section-{{ section.id }} .gg-cta-hero__inner {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    min-height: var(--gg-cta-min-h-desktop, 448px);
    padding-left: var(--gg-cta-inner-pad-x, 24px);
    padding-right: var(--gg-cta-inner-pad-x, 24px);
    padding-top: 3rem;
    padding-bottom: 3rem;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .gg-cta-hero--align-left .gg-cta-hero__inner {
    justify-content: flex-start;
  }

  #shopify-section-{{ section.id }} .gg-cta-hero--align-center .gg-cta-hero__inner {
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .gg-cta-hero--align-right .gg-cta-hero__inner {
    justify-content: flex-end;
  }

  #shopify-section-{{ section.id }} .gg-cta-hero__content {
    width: 100%;
    max-width: var(--gg-cta-content-max, 800px);
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .gg-cta-hero--align-left .gg-cta-hero__content {
    text-align: left;
  }

  #shopify-section-{{ section.id }} .gg-cta-hero--align-center .gg-cta-hero__content {
    text-align: center;
  }

  #shopify-section-{{ section.id }} .gg-cta-hero--align-right .gg-cta-hero__content {
    text-align: right;
  }

  #shopify-section-{{ section.id }} .gg-cta-hero__heading {
    margin: 0;
    font-weight: 700;
    font-size: clamp(
      var(--gg-cta-heading-fs-min, 2.4rem),
      1.8rem + 2.9vw,
      var(--gg-cta-heading-fs-max, 4rem)
    );
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: rgb(255, 255, 255);
  }

  #shopify-section-{{ section.id }} .gg-cta-hero__actions {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gg-cta-btn-gap, 24px);
    margin-top: var(--gg-cta-heading-mt-buttons, 26px);
  }

  #shopify-section-{{ section.id }} .gg-cta-hero--align-left .gg-cta-hero__actions {
    justify-content: flex-start;
  }

  #shopify-section-{{ section.id }} .gg-cta-hero--align-center .gg-cta-hero__actions {
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .gg-cta-hero--align-right .gg-cta-hero__actions {
    justify-content: flex-end;
  }

  #shopify-section-{{ section.id }} .gg-cta-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--gg-cta-btn-min-h, 5.8rem);
    padding: var(--gg-cta-btn-pad-y, 1.7rem) var(--gg-cta-btn-pad-x-r, 3.164rem) var(--gg-cta-btn-pad-y, 1.7rem)
      var(--gg-cta-btn-pad-x-l, 3.1rem);
    border-radius: 0;
    font-weight: 700;
    font-size: var(--gg-cta-btn-fs, 1.6rem);
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    color: rgb(255, 255, 255);
    background-color: rgb(var(--gg-cta-btn-rgb, 239, 43, 72));
    border: none;
    box-sizing: border-box;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .gg-cta-hero__button:hover {
    background-color: rgb(var(--gg-cta-btn-hover-rgb, 214, 31, 58));
    color: rgb(255, 255, 255);
  }

  #shopify-section-{{ section.id }} .gg-cta-hero__button:focus {
    outline: 0.2rem solid rgba(255, 255, 255, 0.85);
    outline-offset: 0.2rem;
  }

  #shopify-section-{{ section.id }} .gg-cta-hero__button:focus:not(:focus-visible) {
    outline: none;
  }

  #shopify-section-{{ section.id }} .gg-cta-hero__button:focus-visible {
    outline: 0.2rem solid rgba(255, 255, 255, 0.85);
    outline-offset: 0.2rem;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .gg-cta-hero__actions {
      flex-wrap: nowrap;
    }

    /* Figma-sized CTAs: fixed min footprint, not stretched full row */
    #shopify-section-{{ section.id }} .gg-cta-hero__button {
      flex: 0 0 auto;
      min-width: var(--gg-cta-btn-min-w, 20.564rem);
      white-space: nowrap;
    }

    #shopify-section-{{ section.id }} .gg-cta-hero--align-center .gg-cta-hero__actions {
      width: 100%;
      max-width: calc(2 * var(--gg-cta-btn-min-w, 20.564rem) + var(--gg-cta-btn-gap, 24px));
      margin-left: auto;
      margin-right: auto;
    }
  }

  /* Tablet: row may wrap so labels are not clipped. */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    #shopify-section-{{ section.id }} .gg-cta-hero__actions {
      flex-wrap: wrap;
    }

    #shopify-section-{{ section.id }} .gg-cta-hero__button {
      min-width: min(100%, var(--gg-cta-btn-min-w, 20.564rem));
      white-space: normal;
      text-align: center;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .gg-cta-hero__inner {
      min-height: 0;
      padding-top: 2.5rem;
      padding-bottom: 2.5rem;
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .gg-cta-hero__content {
      text-align: center;
    }

    #shopify-section-{{ section.id }} .gg-cta-hero__actions {
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      justify-content: center;
      margin-top: 1.5rem;
    }

    #shopify-section-{{ section.id }} .gg-cta-hero__button {
      width: 100%;
      min-width: 0;
      white-space: normal;
      text-align: center;
    }
  }
</style>

<section
  class="gg-cta-hero section-{{ section.id }}-padding {{ align_class }}"
  {% if section.settings.heading != blank %}
    aria-labelledby="gg-cta-hero-title-{{ section.id }}"
  {% endif %}
>
  <div class="gg-cta-hero__media" aria-hidden="true">
    {%- if has_desktop -%}
      {%- assign gg_cta_img_alt = section.settings.image.alt | default: section.settings.image_alt | default: section.settings.heading | default: shop.name | escape -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{- section.settings.image_mobile | image_url: width: 375 }} 375w,
              {{- section.settings.image_mobile | image_url: width: 550 }} 550w,
              {{- section.settings.image_mobile | image_url: width: 750 }} 750w,
              {{- section.settings.image_mobile | image_url: width: 1100 }} 1100w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{
          section.settings.image
          | image_url: width: 3840
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '100vw',
            widths: '375,550,750,1100,1500,1780,2000,3000,3840',
            alt: gg_cta_img_alt,
            class: 'gg-cta-hero__img'
        }}
      </picture>
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="gg-cta-hero__overlay"></div>
  <div
    class="gg-cta-hero__overlay-gradient{% unless section.settings.show_gradient_overlay %} is-hidden{% endunless %}"
  ></div>

  <div class="gg-cta-hero__inner">
    <div class="gg-cta-hero__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="gg-cta-hero__heading" id="gg-cta-hero-title-{{ section.id }}">
          {{- section.settings.heading | escape | newline_to_br -}}
        </h2>
      {%- endif -%}

      <div class="gg-cta-hero__actions">
        {%- if section.settings.button_1_label != blank and section.settings.button_1_link != blank -%}
          <a
            class="gg-cta-hero__button"
            href="{{ section.settings.button_1_link }}"
          >
            {{- section.settings.button_1_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank and section.settings.button_2_link != blank -%}
          <a
            class="gg-cta-hero__button"
            href="{{ section.settings.button_2_link }}"
          >
            {{- section.settings.button_2_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GG: CTA hero banner",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Background image — mobile",
      "info": "Optional. Uses desktop image when empty."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Garage with interlocking tile flooring"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focal point",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ],
      "default": "center center"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 55,
      "info": "About 50–60% matches the reference design."
    },
    {
      "type": "checkbox",
      "id": "show_gradient_overlay",
      "label": "Gradient overlay",
      "default": false,
      "info": "Adds a subtle dark gradient from top to bottom."
    },
    {
      "type": "range",
      "id": "gradient_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Gradient strength",
      "default": 40
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "info": "Large screens. Mobile is always centered with stacked buttons."
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 520,
      "max": 960,
      "step": 8,
      "unit": "px",
      "label": "Content max width",
      "default": 800
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Pick Your Kit. Transform Your Garage."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button 1 label",
      "default": "SHOP 2-CAR KIT"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 label",
      "default": "SHOP 3-CAR KIT"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#ef2b48"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover background",
      "default": "#d61f3a"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "min": 320,
      "max": 640,
      "step": 8,
      "unit": "px",
      "label": "Minimum height — large screens",
      "default": 448,
      "info": "Mobile height follows content (not fixed)."
    },
    {
      "type": "range",
      "id": "inner_padding_horizontal",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Inner horizontal padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_button_gap",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Space below heading",
      "default": 26
    },
    {
      "type": "range",
      "id": "button_gap",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Gap between buttons",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section padding bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "GG: CTA hero banner"
    }
  ]
}
{% endschema %}
