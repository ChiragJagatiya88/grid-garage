{{ 'if-choose-style.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign if_accent = section.settings.accent_color | default: '#DC1C1B'
  assign if_bg = section.settings.section_bg | default: '#FFFFFF'
  assign if_panel = section.settings.panel_bg | default: '#F3F3F3'
  assign if_first = true
-%}

<div
  id="if-style-{{ section.id }}"
  class="section_{{ section.id }} if-sty{% if section.settings.enable_custom_class and section.settings.section_class != blank %} {{ section.settings.section_class }}{% endif %}"
  data-if-sty
  style="--if-sty-accent: {{ if_accent }}; --if-sty-bg: {{ if_bg }}; --if-sty-panel: {{ if_panel }};"
>
  <div class="{% if section.settings.enable_container %}if-sty__inner{% else %}if-sty__inner if-sty__inner--fluid{% endif %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="if-sty__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="if-sty__panel">
      {%- comment -%} Desktop preview (left) {%- endcomment -%}
      <div class="if-sty__preview" data-if-sty-preview aria-hidden="false">
        {%- for block in section.blocks -%}
          {%- if block.type == 'style' -%}
            <div
              class="if-sty__preview-item{% if if_first %} is-active{% endif %}"
              data-if-sty-preview-item
              data-style-id="{{ block.id }}"
              {% unless if_first %}hidden{% endunless %}
            >
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 750px) 45vw, 90vw',
                    widths: '400,600,900,1200',
                    alt: block.settings.title | escape
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            {%- assign if_first = false -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- assign if_first = true -%}
      <div class="if-sty__list" role="list" data-if-sty-list>
        {%- for block in section.blocks -%}
          {%- if block.type == 'style' -%}
            <div
              class="if-sty__item{% if if_first %} is-active{% endif %}"
              role="listitem"
              data-if-sty-item
              data-style-id="{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              <button
                type="button"
                class="if-sty__btn"
                data-if-sty-btn
                aria-expanded="{% if if_first %}true{% else %}false{% endif %}"
              >
                <span class="if-sty__btn-label">{{ block.settings.title | escape }}</span>
                <span class="if-sty__btn-icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 56 56" fill="none">
                  <path d="M16.3335 39.6668V16.3335H39.6668" stroke="#DF2D2C" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M39.6668 39.6668L16.3335 16.3335" stroke="#DF2D2C" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </button>

              <div class="if-sty__mobile-media" data-if-sty-mobile-media {% unless if_first %}hidden{% endunless %}>
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      sizes: '90vw',
                      widths: '400,600,900',
                      alt: block.settings.title | escape
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
            </div>
            {%- assign if_first = false -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script src="{{ 'if-choose-style.js' | asset_url }}" defer></script>

{% style %}
  .section_{{ section.id }} {
    {% if section.settings.section_bg != blank %}background: {{ section.settings.section_bg }};{% endif %}
    {% if section.settings.section_gradient_bg != blank %}background: {{ section.settings.section_gradient_bg }};{% endif %}
    {% if section.settings.enable_custom_padding %}padding-block: {{ section.settings.padding_desk }};{% endif %}
  }
  @media screen and (max-width: 767px) {
    .section_{{ section.id }} {
      {% if section.settings.enable_custom_padding %}padding-block: {{ section.settings.padding_mob }};{% endif %}
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "IF Choose Your Style",
  "tag": "section",
  "class": "if_choose_style",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_class",
      "label": "Enable custom class",
      "default": false
    },
    {
      "type": "text",
      "id": "section_class",
      "label": "Custom class",
      "visible_if": "{{ section.settings.enable_custom_class == true }}"
    },
    {
      "type": "checkbox",
      "id": "enable_container",
      "label": "Enable container",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose Your Style"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color_background",
      "id": "section_gradient_bg",
      "label": "Section gradient background"
    },
    {
      "type": "color",
      "id": "panel_bg",
      "label": "Panel background",
      "default": "#F3F3F3"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Active accent",
      "default": "#DC1C1B"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_padding",
      "label": "Enable custom padding",
      "default": true
    },
    {
      "type": "text",
      "id": "padding_desk",
      "label": "Padding desktop",
      "default": "56px 0",
      "visible_if": "{{ section.settings.enable_custom_padding == true }}"
    },
    {
      "type": "text",
      "id": "padding_mob",
      "label": "Padding mobile",
      "default": "36px 0",
      "visible_if": "{{ section.settings.enable_custom_padding == true }}"
    }
  ],
  "blocks": [
    {
      "type": "style",
      "name": "Style",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Grid Garage X"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IF Choose Your Style",
      "blocks": [
        {
          "type": "style",
          "settings": { "title": "Grid Garage X" }
        },
        {
          "type": "style",
          "settings": { "title": "DiamondTrax" }
        },
        {
          "type": "style",
          "settings": { "title": "Ribtrax Smooth" }
        },
        {
          "type": "style",
          "settings": { "title": "Ribtrax Pro" }
        }
      ]
    }
  ]
}
{% endschema %}
