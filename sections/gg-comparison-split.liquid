          "default": "3-5 days"
        },
        {
          "type": "text",
          "id": "competitor_b_value",
          "label": "Competitor B",
          "default": "N/A"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GG: Comparison split",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "feature_label": "Installation time",
            "brand_value": "2-4 hours",
            "competitor_a_value": "3-5 days",
            "competitor_b_value": "N/A"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature_label": "Durability",
            "brand_value": "Lifetime guarantee",
            "competitor_a_value": "Peels over time",
            "competitor_b_value": "Cracks and stains"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature_label": "DIY friendly",
            "brand_value": "Snap and go",
            "competitor_a_value": "Professional needed",
            "competitor_b_value": "Standard"
          }
        },
        {
          "type": "row",
