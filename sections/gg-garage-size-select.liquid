{%- comment -%}
  Garage size selector — 2 cards for 2-car and 3-car garage kits.
  Light grey background, white cards, icon + title + description.
{%- endcomment -%}
{{ 'gg-garage-size-select.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .gg-gss {
    --gg-gss-bg: {{ section.settings.background_color.red }},{{ section.settings.background_color.green }},{{ section.settings.background_color.blue }};
    --gg-gss-card-bg: {{ section.settings.card_background_color.red }},{{ section.settings.card_background_color.green }},{{ section.settings.card_background_color.blue }};
    --gg-gss-heading: {{ section.settings.heading_color.red }},{{ section.settings.heading_color.green }},{{ section.settings.heading_color.blue }};
    --gg-gss-title: {{ section.settings.title_color.red }},{{ section.settings.title_color.green }},{{ section.settings.title_color.blue }};
    --gg-gss-desc: {{ section.settings.description_color.red }},{{ section.settings.description_color.green }},{{ section.settings.description_color.blue }};
    --gg-gss-border: {{ section.settings.border_color.red }},{{ section.settings.border_color.green }},{{ section.settings.border_color.blue }};
    --gg-gss-accent: {{ section.settings.accent_color.red }},{{ section.settings.accent_color.green }},{{ section.settings.accent_color.blue }};
  }
{%- endstyle -%}

<section
  class="gg-gss section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  data-section-id="{{ section.id }}"
>
  <div class="gg-gss__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="gg-gss__heading gg-font-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="gg-gss__grid">
      {%- for block in section.blocks -%}
        <div
          class="gg-gss__card{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {{ block.shopify_attributes }}
          style="{% if settings.animations_reveal_on_scroll %}--animation-order: {{ forloop.index }}{% endif %}"
        >
          {%- if block.settings.link != blank -%}
            <a
              href="{{ block.settings.link }}"
              class="gg-gss__card-link"
              {% if block.settings.open_new_tab %}
                target="_blank"
                rel="noopener noreferrer"
              {% endif %}
            >
          {%- else -%}
            <div class="gg-gss__card-inner">
          {%- endif -%}

              <div class="gg-gss__card-icon">
                {%- if block.settings.icon != blank -%}
                  {{
                    block.settings.icon
                    | image_url: width: 120
                    | image_tag:
                      loading: 'lazy',
                      width: 40,
                      height: 40,
                      alt: block.settings.icon.alt | default: block.settings.title | escape
                  }}
                {%- else -%}
                  <span class="gg-gss__card-icon-placeholder" aria-hidden="true">
                    <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <rect width="40" height="40" rx="8" fill="rgba(230,30,67,0.1)"/>
                      <path d="M10 28V18L14 14H26L30 18V28H26V24H14V28H10Z" stroke="rgb(230,30,67)" stroke-width="2" fill="none"/>
                      <circle cx="14" cy="28" r="2" fill="rgb(230,30,67)"/>
                      <circle cx="26" cy="28" r="2" fill="rgb(230,30,67)"/>
                    </svg>
                  </span>
                {%- endif -%}
              </div>

              {%- if block.settings.title != blank -%}
                <h3 class="gg-gss__card-title gg-font-heading">{{ block.settings.title | escape }}</h3>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="gg-gss__card-desc gg-font-body">{{ block.settings.description | escape }}</p>
              {%- endif -%}

          {%- if block.settings.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GG: Garage size select",
  "tag": "section",
  "class": "section",
  "max_blocks": 2,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Select Your Garage Size"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Card title",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description text",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card border",
      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (hover/active)",
      "default": "#E61E43"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "size_card",
      "name": "Garage size card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Recommended: 80x80px SVG or PNG"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "2-Car Garage Kit"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Fits standard 2-car garage (approx. 400 sq ft)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "URL to product page or specific variant"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GG: Garage size select",
      "blocks": [
        {
          "type": "size_card",
          "settings": {
            "title": "2-Car Garage Kit",
            "description": "Fits standard 2-car garage (approx. 400 sq ft)"
          }
        },
        {
          "type": "size_card",
          "settings": {
            "title": "3-Car Garage Kit",
            "description": "Fits standard 3-car garage (approx. 600 sq ft)"
          }
        }
      ]
    }
  ]
}
{% endschema %}
