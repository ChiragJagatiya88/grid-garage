{%- layout none -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ product.title }} - Configurator</title>
  {{ content_for_header }}
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  {{ 'gg-react-configurator-custom.css' | asset_url | stylesheet_tag }}
  {%- render 'gg-product-json-ld', product: product -%}
  
  <style>
    /* Add any custom overrides here */
  </style>
</head>
<body class="gg">
  
  <!-- Announcement -->
  <div class="gg-announce">
    <div class="gg-track">
      <span>✓ <b>Free shipping on all 2-Car & 3-Car kits</b></span>
      <span>✓ <b>One premium price. No surprises.</b></span>
      <span>✓ <b>5 premium tile collections</b></span>
      <span>✓ <b>DIY installation in hours</b></span>
      <span>✓ <b>Lifetime tile warranty</b></span>
      <span>✓ <b>Financing options available at checkout</b></span>

      <span>✓ <b>Free shipping on all 2-Car & 3-Car kits</b></span>
      <span>✓ <b>One premium price. No surprises.</b></span>
      <span>✓ <b>5 premium tile collections</b></span>
      <span>✓ <b>DIY installation in hours</b></span>
      <span>✓ <b>Lifetime tile warranty</b></span>
      <span>✓ <b>Financing options available at checkout</b></span>
    </div>
  </div>

  <!-- Header -->
  <header class="gg-header">
    <div class="gg-header-in">
      <a href="/">
        <img class="gg-logo" src="https://www.gridgarageinc.com/cdn/shop/files/Logo.svg?v=1775124764&width=600" alt="Grid Garage">
      </a>
      <nav class="gg-nav">
        <a href="#configure">Configure</a>
        <a href="#">Why GridGarage</a>
        <a href="#">Specs</a>
        <a href="#">FAQ</a>
      </nav>
      <div class="gg-contact">
        <a href="tel:+18888988022">📞 (888) 898-8022</a>
        <a href="mailto:info@gridgarageinc.com">✉️ info@gridgarageinc.com</a>
      </div>
      <div style="display: flex; align-items: center; gap: 20px; font-size: 13px; font-weight: 500;">
        <a href="#configure" style="font-family: var(--f-disp); font-weight: 700; letter-spacing: .04em;">Design yours</a>
        <a href="/cart" class="gg-cart" id="gg-cart-link">Cart · <span class="gg-cart-count">{{ cart.item_count }}</span></a>
      </div>
    </div>
  </header>

  <main class="gg-shell" id="configure">
    <!-- Product Header -->
    <section class="gg-phead">
      <div>
        <span class="gg-eyebrow">Premium Interlocking Floor Kit</span>
        <h1 class="gg-ptitle">Design Your<br>Perfect Garage</h1>
      </div>
      <div class="gg-phead-right">
        <div class="gg-showcase">
          <h3 class="gg-sc-title">GRIDGARAGE SHOWCASE PROGRAM</h3>
          <p class="gg-sc-desc">Share your completed garage, before & after photos, and a short video after installation and receive a $100 reward.</p>
          <div class="gg-sc-banner">Available on orders over 300 sq. ft.</div>
          <ul class="gg-sc-list">
            <li><span class="gg-sc-check">✅</span> Free Shipping Nationwide</li>
            <li><span class="gg-sc-check">✅</span> 30-Day Money-Back Guarantee</li>
            <li><span class="gg-sc-check">✅</span> Ships in 3–5 Business Days</li>
            <li><span class="gg-sc-check">✅</span> DIY Installation in 3–4 Hours</li>
            <li><span class="gg-sc-check">✅</span> Financing options available at checkout</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- CUSTOMER REVIEWS -->
    <section class="gg-reviews" id="reviews">
      <div class="gg-reviews-head">
        <div>
          <span class="gg-eyebrow" style="display: block; margin-bottom: 8px;">Customer Reviews</span>
          <h2 class="gg-coll-h">Loved by garage owners nationwide</h2>
        </div>
        <div class="gg-reviews-avg">
          <span class="gg-stars">★★★★★</span>
          <span>4.9 average &middot; 1,200+ verified reviews</span>
        </div>
      </div>
      <div class="gg-reviews-grid">
        <figure class="gg-review-card">
          <div class="gg-stars" aria-label="5 out of 5 stars">★★★★★</div>
          <blockquote>&ldquo;Install took an afternoon. The floor completely transforms the garage &mdash; it looks like a showroom.&rdquo;</blockquote>
          <figcaption><b>Michael R.</b><em>Verified Buyer</em></figcaption>
        </figure>
        <figure class="gg-review-card">
          <div class="gg-stars" aria-label="5 out of 5 stars">★★★★★</div>
          <blockquote>&ldquo;Ordering was easy, kit arrived in 4 days, and the edge pieces were pre-cut perfectly for our L-shaped bay.&rdquo;</blockquote>
          <figcaption><b>Jennifer K.</b><em>Verified Buyer</em></figcaption>
        </figure>
        <figure class="gg-review-card">
          <div class="gg-stars" aria-label="5 out of 5 stars">★★★★★</div>
          <blockquote>&ldquo;Rolled the truck straight onto it after install. Rock solid, no shifting, no cracking. Worth every dollar.&rdquo;</blockquote>
          <figcaption><b>David P.</b><em>Google Review</em></figcaption>
        </figure>
        <figure class="gg-review-card">
          <div class="gg-stars" aria-label="5 out of 5 stars">★★★★★</div>
          <blockquote>&ldquo;The checkered pattern looks incredible. Our neighbors keep asking who did the floor.&rdquo;</blockquote>
          <figcaption><b>Sarah L.</b><em>Previous Site</em></figcaption>
        </figure>
        <figure class="gg-review-card">
          <div class="gg-stars" aria-label="5 out of 5 stars">★★★★★</div>
          <blockquote>&ldquo;Had it 3 years &mdash; spilled oil, dropped tools, dragged a jack across it. Still looks brand new.&rdquo;</blockquote>
          <figcaption><b>Tom W.</b><em>Previous Site</em></figcaption>
        </figure>
        <figure class="gg-review-card">
          <div class="gg-stars" aria-label="5 out of 5 stars">★★★★★</div>
          <blockquote>&ldquo;Great customer service walked me through the layout. The finished result is beautiful.&rdquo;</blockquote>
          <figcaption><b>Amanda C.</b><em>Previous Site</em></figcaption>
        </figure>
      </div>
    </section>

    <!-- STEP 01 · CHOOSE YOUR GARAGE -->
    <section class="gg-kit-section">
      <div class="gg-kit-head">
        <div>
          <span class="gg-eyebrow" style="display: block; margin-bottom: 8px;">Step 01 · Garage</span>
          <h2 class="gg-coll-h">Choose Your Garage</h2>
        </div>
        <span class="gg-coll-hint">Pick a kit size — or start a custom project</span>
      </div>
      
      <div class="gg-kit-grid" id="gg-kit-grid">
        <!-- 2-Car Kit -->
        <button class="gg-kit-card sel" data-kit="2car">
          <span class="gg-kit-check">✓</span>
          <div class="gg-kit-img">
            <img src="https://swatch-whisper.lovable.app/assets/garage-showroom-BnsTZ9kb.jpg" alt="2-Car Garage" loading="lazy">
            <span class="gg-kit-badge">Most Popular</span>
          </div>
          <div class="gg-kit-body">
            <div class="gg-kit-name">2-Car Garage</div>
            <div class="gg-kit-tag">Fits most standard two-car garages</div>
            <div class="gg-kit-spec">Up to ~430 sq ft · ships free</div>
          </div>
        </button>

        <!-- Custom Build -->
        <button class="gg-kit-card" data-kit="custom">
          <span class="gg-kit-check">✓</span>
          <div class="gg-kit-img">
            <img src="https://swatch-whisper.lovable.app/assets/garage-double-border-D9FIEXjN.jpg" alt="Design My Space" loading="lazy">
            <span class="gg-kit-badge">Custom Build</span>
          </div>
          <div class="gg-kit-body">
            <div class="gg-kit-name">Design My Space</div>
            <div class="gg-kit-tag">Gym Floors, Commercial Space, Basement, Showroom, Auto Detailing, Patio, Mancave and more</div>
            <div class="gg-kit-spec">We size your kit to fit — Ships Free.</div>
          </div>
        </button>

        <!-- 3-Car Kit -->
        <button class="gg-kit-card" data-kit="3car">
          <span class="gg-kit-check">✓</span>
          <div class="gg-kit-img">
            <img src="https://swatch-whisper.lovable.app/assets/garage-checkered-BK9qb5dY.jpg" alt="3-Car Garage" loading="lazy">
            <span class="gg-kit-badge">Premium</span>
          </div>
          <div class="gg-kit-body">
            <div class="gg-kit-name">3-Car Garage</div>
            <div class="gg-kit-tag">Wide bays, extra depth, more storage</div>
            <div class="gg-kit-spec">Up to ~630 sq ft · ships free</div>
          </div>
        </button>
      </div>
    </section>

    <!-- STEP 02 · TILE COLLECTION -->
    <section class="gg-coll-section">
      <div class="gg-coll-head">
        <div>
          <span class="gg-eyebrow" style="display: block; margin-bottom: 8px;">Step 02 · Tile Collection</span>
          <h2 class="gg-coll-h">Choose Your Collection</h2>
        </div>
        <span class="gg-coll-hint">Swipe to compare · GridGarage X is our best value</span>
      </div>

      <div class="gg-coll-rail" id="gg-coll-rail">
        {% assign collection = collections['complete-garage-floor-kits'] %}
        {% for coll_product in collection.products %}
          {% assign is_selected = false %}
          {% if product.id == coll_product.id %}
            {% assign is_selected = true %}
          {% endif %}
          
          <button class="gg-coll-card {% if is_selected %}sel{% endif %}" data-product-handle="{{ coll_product.handle }}" data-product-id="{{ coll_product.id }}" onclick="window.location.href='{{ coll_product.url }}'">
            {% if coll_product.tags contains 'Best Value' %}
              <span class="gg-coll-badge gg-bb-value">Best Value</span>
            {% elsif coll_product.tags contains 'Classic Diamond' %}
              <span class="gg-coll-badge gg-bb-classic-diamond">Classic Diamond Plate</span>
            {% elsif coll_product.tags contains 'Most Popular' %}
              <span class="gg-coll-badge gg-bb-pop">Most Popular</span>
            {% elsif coll_product.tags contains 'Premium' %}
              <span class="gg-coll-badge gg-bb-prem">Premium</span>
            {% elsif coll_product.tags contains 'Bold Unique' %}
              <span class="gg-coll-badge gg-bb-bold">Bold Unique Design</span>
            {% endif %}
            
            <span class="gg-coll-check">✓</span>
            <div class="gg-coll-img">
              <img src="{{ coll_product.featured_image | img_url: '400x' }}" alt="{{ coll_product.title }}" loading="lazy">
            </div>
            <div>
              <div class="gg-coll-name">{{ coll_product.title }}</div>
              <div class="gg-coll-sub">{{ coll_product.metafields.custom.short_description | default: coll_product.description | truncatewords: 8 }}</div>
            </div>
            <div class="gg-coll-meta">
              <span class="gg-coll-size">{{ coll_product.metafields.custom.tile_size | default: '12" × 12"' }}</span>
              {%- assign _ltags = coll_product.tags | join: ',' | downcase | split: ',' -%}
              {%- if _ltags contains 'price by consultation' -%}
                <span class="gg-coll-price" style="font-size: 11px; font-weight: 600; color: var(--muted); text-transform: none; letter-spacing: normal;">Please Call or Email for Pricing</span>
              {%- else -%}
                {%- assign coll_v2 = nil -%}
                {%- assign coll_v3 = nil -%}
                {%- for v in coll_product.variants -%}
                  {%- assign v_norm = v.title | downcase | replace: '-', '' | replace: ' ', '' -%}
                  {%- if coll_v2 == nil and v_norm contains '2car' -%}
                    {%- assign coll_v2 = v -%}
                  {%- endif -%}
                  {%- if coll_v3 == nil and v_norm contains '3car' -%}
                    {%- assign coll_v3 = v -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- assign coll_price_2car = coll_v2.price | default: coll_product.price -%}
                {%- assign coll_price_3car = coll_v3.price | default: coll_product.price -%}
                <span
                  class="gg-coll-price"
                  data-price-2car="{{ coll_price_2car }}"
                  data-price-3car="{{ coll_price_3car }}"
                  data-price-per-sqft="{{ coll_product.price }}"
                >{{ coll_price_2car | money }}</span>
              {%- endif -%}
            </div>
            <div class="gg-coll-sw" id="gg-coll-sw-{{ coll_product.id }}">
              <!-- Filled by JS based on product variants -->
            </div>
          </button>
        {% endfor %}
      </div>
    </section>

    <!-- 3-COLUMN CONFIGURATOR -->
    <section class="gg-cfg">
      
      <!-- LEFT: Controls -->
      <div class="gg-col">
        <!-- Pattern -->
        <div class="gg-panel">
          <div class="gg-panel-h">
            <span class="gg-num">03</span> Pattern
          </div>
          <div class="gg-pat-grid" id="gg-pat-grid">
            <!-- Rendered by JS -->
          </div>
        </div>

        <!-- Colors -->
        <div class="gg-panel">
          <div class="gg-panel-h">
            <span class="gg-num">04</span> Choose Your Colors
          </div>
          <div class="gg-cp-hint">Watch the sticky zone diagram above update as you pick colors for each zone.</div>
          <div id="gg-zones-container">
            <!-- Rendered by JS -->
          </div>
        </div>
      </div>

      <!-- CENTER: Stage -->
      <div class="gg-stage">
        <div class="gg-stage-img">
          <img id="gg-hero-img" src="{{ product.featured_image | img_url: '1000x' }}" alt="{{ product.title }}">
          <div class="gg-stage-grad"></div>
          <div class="gg-nameplate">
            <div>
              <div class="gg-np-eyebrow">Design Mode · Your Floor</div>
              <div class="gg-np-name" id="gg-np-name">Pattern Name</div>
              <div class="gg-np-colors" id="gg-np-colors">Color 1 + Color 2</div>
            </div>
          </div>
        </div>

        <!-- Live Zone Diagram -->
        <div class="gg-stage-diagram">
          <div class="gg-stage-diagram-h">
            <span>Zone Guide</span>
            <em><span id="gg-diag-name">Pattern</span> · updates live</em>
          </div>
          <div id="gg-svg-container">
            <!-- SVG rendered by JS -->
          </div>
          <div class="gg-stage-legend" id="gg-stage-legend">
            <!-- Rendered by JS -->
          </div>
        </div>
      </div>

      <!-- RIGHT: Buy Panel -->
      <aside class="gg-buy-panel">
        <div>
          <div class="gg-sel-head">Your Selections</div>
          <div class="gg-sel-list" id="gg-sel-list">
            <!-- Rendered by JS -->
          </div>
        </div>

        {%- assign _is_consultation = false -%}
        {%- assign _pbc_tags = product.tags | join: ',' | downcase -%}
        {%- if _pbc_tags contains 'price by consultation' -%}
          {%- assign _is_consultation = true -%}
        {%- endif -%}

        {%- if _is_consultation -%}
          <div class="gg-price-block">
            <div class="gg-price-label">Pricing</div>
            <div style="font-size:22px;font-weight:800;font-family:var(--f-disp);letter-spacing:-.01em;color:var(--ink);margin-top:8px;">Please Call or Email for Pricing</div>
            <div class="gg-price-foot">Contact us for a custom quote tailored to your project.</div>
          </div>
          <a href="/pages/contact" id="gg-request-quote-btn" class="gg-add-btn" style="text-decoration:none;margin-top:0;">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            Request a Quote
          </a>
          <p class="gg-quote-hint">Our team will follow up with pricing tailored to your custom design.</p>
        {%- else -%}
          <div class="gg-price-block">
            <div class="gg-price-label">Total Price</div>
            <div class="gg-price-amt" id="gg-price-amt">{{ product.price | money }}</div>
            <div class="gg-price-foot">All-in price · Shipping included · No surprises</div>
          </div>

          <div class="gg-buy-contact">
            <div class="gg-buy-contact-l"></div>
            <div class="gg-buy-contact-row">
              <a href="tel:+18888988022">📞 (888) 898-8022</a>
              <a href="mailto:info@gridgarageinc.com">✉️ info@gridgarageinc.com</a>
            </div>
          </div>

          <form method="post" action="/cart/add" id="gg-add-to-cart-form">
            <!-- Hidden inputs for Variant ID and Line Item Properties -->
            <input type="hidden" name="id" id="gg-variant-id" value="{{ product.variants.first.id }}">
            <input type="hidden" name="quantity" id="gg-add-qty" value="1">
            <div id="gg-properties-container"></div>

            <button type="submit" class="gg-add-btn">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
              Add to Cart
            </button>
          </form>

          <div class="gg-pay" aria-label="Accepted payment methods">
            {%- for type in shop.enabled_payment_types -%}
              <span class="gg-pay-pill">{{ type | payment_type_svg_tag: class: 'gg-pay-icon' }}</span>
            {%- endfor -%}
          </div>
          <button type="button" class="gg-pay-shop-btn">Shop Pay Financing</button>
        {%- endif -%}

        <button class="gg-samples" onclick="window.open('https://www.gridgarageinc.com/collections/sample-packs', '_blank');">
  Order Sample Pack
</button>

        <div class="gg-trust">
          <span>Lifetime Warranty</span>
          <span>Financing Available</span>
          <span>Free Shipping Nationwide</span>
          <span>Ships in 3&ndash;5 Business Days</span>
          <span>30-Day Money-Back Guarantee</span>
        </div>
      </aside>
    </section>

  </main>

  <!-- Sticky mobile bar -->
  <div class="gg-sticky">
    <div>
      <div class="l">Total</div>
      <div class="a" id="gg-sticky-price">{{ product.price | money }}</div>
    </div>
    <button class="gg-add-btn" onclick="document.getElementById('gg-add-to-cart-form').submit();">
      Add to Cart
    </button>
  </div>

  <div class="gg-toast" id="gg-toast"></div>
  <div class="gg-quote-toast" id="gg-quote-toast"></div>

  <!-- Product Data JSON -->
  <script type="application/json" id="gg-product-json">
    {{ product | json }}
  </script>

  <!-- Tile Colors JSON — every color option value on this product, pulled dynamically -->
  <script type="application/json" id="gg-colors-json">
    [
      {%- liquid
        assign gg_color_opt = nil
        for opt in product.options_with_values
          assign gg_has_sw = opt.values | map: 'swatch' | compact | size
          if gg_has_sw > 0 and gg_color_opt == nil
            assign gg_color_opt = opt
          endif
        endfor
        if gg_color_opt == nil
          for opt in product.options_with_values
            assign gg_oname = opt.name | downcase
            if gg_oname == 'color' or gg_oname == 'colour' or gg_oname == 'tile color' or gg_oname == 'tile colour'
              assign gg_color_opt = opt
              break
            endif
          endfor
        endif
      -%}
      {%- if gg_color_opt -%}
        {%- assign gg_opt_pos = gg_color_opt.position -%}
        {%- for val in gg_color_opt.values -%}
          {%- assign gg_val_str = val.name | default: val | strip -%}
          {%- assign gg_mv = nil -%}
          {%- for v in product.variants -%}
            {%- if gg_mv == nil -%}
              {%- assign gg_v_opt = '' -%}
              {%- if gg_opt_pos == 1 -%}{%- assign gg_v_opt = v.option1 -%}
              {%- elsif gg_opt_pos == 2 -%}{%- assign gg_v_opt = v.option2 -%}
              {%- elsif gg_opt_pos == 3 -%}{%- assign gg_v_opt = v.option3 -%}
              {%- endif -%}
              {%- if gg_v_opt == gg_val_str -%}{%- assign gg_mv = v -%}{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {%- assign gg_sw_img = blank -%}
          {%- if val.swatch.image -%}
            {%- assign gg_sw_img = val.swatch.image | image_url: width: 200 -%}
          {%- elsif gg_mv.featured_media -%}
            {%- assign gg_sw_img = gg_mv.featured_media | image_url: width: 200 -%}
          {%- elsif gg_mv.featured_image -%}
            {%- assign gg_sw_img = gg_mv.featured_image | image_url: width: 200 -%}
          {%- endif -%}
          {%- assign gg_sw_rgb = '' -%}
          {%- if val.swatch.color -%}
            {%- assign gg_sw_rgb = val.swatch.color.rgb -%}
          {%- endif -%}
          {
            "name": {{ gg_val_str | json }},
            "image": {{ gg_sw_img | json }},
            "rgb": {{ gg_sw_rgb | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      {%- endif -%}
    ]
  </script>

  <!-- Script logic -->
  <script>
    window.GG_PATTERN_IMAGES = {
      checkered: {{ 'gg-pattern-checkered-classic.jpeg' | asset_url | json }},
      racetrack: {{ 'gg-pattern-racetrack.jpeg' | asset_url | json }},
      showroom: {{ 'gg-pattern-showroom.jpeg' | asset_url | json }},
      doubleborder: {{ 'gg-pattern-double-border.jpeg' | asset_url | json }},
      solid: {{ 'gg-pattern-stealth-solid.jpeg' | asset_url | json }}
    };
  </script>
  <script src="{{ 'gg-react-configurator-custom.js' | asset_url }}" defer></script>

</body>
</html>
