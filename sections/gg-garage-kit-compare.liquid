{%- comment -%}
  Figma 647:815 — two garage kit cards: product image link, badge, title/subtitle (product or custom), features, price + CTA.
{%- endcomment -%}
{{ 'gg-garage-kit-compare.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign head_align = 'center'
  if section.settings.heading_alignment == 'left'
    assign head_align = 'left'
  endif

  assign price_lbl = section.settings.price_label_override
  if price_lbl == blank
    assign price_lbl = 'sections.gg_garage_kit_compare.starting_at' | t
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .gg-gkc {
    --gg-gkc-accent: {{ section.settings.color_accent.red }},{{ section.settings.color_accent.green }},{{ section.settings.color_accent.blue }};
    --gg-gkc-card-bg: {{ section.settings.color_card_bg.red }},{{ section.settings.color_card_bg.green }},{{ section.settings.color_card_bg.blue }};
    --gg-gkc-heading: {{ section.settings.color_heading.red }},{{ section.settings.color_heading.green }},{{ section.settings.color_heading.blue }};
    --gg-gkc-title: {{ section.settings.color_title.red }},{{ section.settings.color_title.green }},{{ section.settings.color_title.blue }};
    --gg-gkc-text: {{ section.settings.color_body.red }},{{ section.settings.color_body.green }},{{ section.settings.color_body.blue }};
    --gg-gkc-subtitle: {{ section.settings.color_body.red }},{{ section.settings.color_body.green }},{{ section.settings.color_body.blue }};
    --gg-gkc-price-label: {{ section.settings.color_price_label.red }},{{ section.settings.color_price_label.green }},{{ section.settings.color_price_label.blue }};
    --gg-gkc-border: {{ section.settings.color_border.red }},{{ section.settings.color_border.green }},{{ section.settings.color_border.blue }};
    --gg-gkc-media-bg: {{ section.settings.color_media_bg.red }},{{ section.settings.color_media_bg.green }},{{ section.settings.color_media_bg.blue }};
    --gg-gkc-btn-text: {{ section.settings.color_button_text.red }},{{ section.settings.color_button_text.green }},{{ section.settings.color_button_text.blue }};
    --gg-gkc-badge-text: {{ section.settings.color_badge_text.red }},{{ section.settings.color_badge_text.green }},{{ section.settings.color_badge_text.blue }};
    --gg-gkc-check-fg: {{ section.settings.color_check_icon.red }},{{ section.settings.color_check_icon.green }},{{ section.settings.color_check_icon.blue }};
    --gg-gkc-head-align: {{ head_align }};
    --gg-gkc-head-m: {{ section.settings.heading_size_mobile }}rem;
    --gg-gkc-head-d: {{ section.settings.heading_size_desktop }}rem;
    --gg-gkc-grid-gap-m: {{ section.settings.grid_gap_mobile }}px;
    --gg-gkc-grid-gap-d: {{ section.settings.grid_gap_desktop }}px;
    --gg-gkc-list-check-mask: url('{{ 'gg-gkc-list-check.svg' | asset_url }}');
  }
{%- endstyle -%}

<section id="kit-section"
  class="color-{{ section.settings.color_scheme }} gradient"
  {% if section.settings.heading != blank %}
    aria-labelledby="gg-gkc-heading-{{ section.id }}"
  {% endif %}
>
  <div class="gg-gkc section-{{ section.id }}-padding">
    <div class="gg-gkc__inner">
        {%- if section.settings.heading != blank -%}
          <h2 class="gg-gkc__heading" id="gg-gkc-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        <ul class="gg-gkc__grid" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'garage_kit_card' -%}
              <li class="gg-gkc__cell">
                {% render 'gg-garage-kit-card',
                  block: block,
                  section: section,
                  card_product: block.settings.product,
                  price_label: price_lbl,
                  lazy_image: forloop.index > 1
                %}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GG: Garage kit compare",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 2,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose your garage size"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 2.4,
      "max": 4.5,
      "step": 0.1,
      "unit": "rem",
      "label": "Heading size — mobile",
      "default": 2.8
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 3,
      "max": 5.5,
      "step": 0.1,
      "unit": "rem",
      "label": "Heading size — desktop",
      "default": 4
    },
    {
      "type": "header",
      "content": "Price label"
    },
    {
      "type": "text",
      "id": "price_label_override",
      "label": "Text above price",
      "info": "Shown on every card above the price. Leave blank to use the theme translation (Starting at)."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent (buttons, badge, checks, price)",
      "default": "#E11D48"
    },
    {
      "type": "color",
      "id": "color_card_bg",
      "label": "Card background",
      "default": "#FAFAFA"
    },
    {
      "type": "color",
      "id": "color_heading",
      "label": "Section heading",
      "default": "#1B1C1C"
    },
    {
      "type": "color",
      "id": "color_title",
      "label": "Card title",
      "default": "#1B1C1C"
    },
    {
      "type": "color",
      "id": "color_body",
      "label": "Body and subtitle",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "color_price_label",
      "label": "Price label (small caps)",
      "default": "#5F5E5E"
    },
    {
      "type": "color",
      "id": "color_border",
      "label": "Divider above footer",
      "default": "#E4E2E1"
    },
    {
      "type": "color",
      "id": "color_media_bg",
      "label": "Image placeholder background",
      "default": "#F0F0F0"
    },
    {
      "type": "color",
      "id": "color_button_text",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_badge_text",
      "label": "Badge text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_check_icon",
      "label": "Checkmark icon",
      "default": "#FFFFFF",
      "info": "List bullets use the SVG check tinted with Accent. This color is reserved for future use."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Grid gap — mobile",
      "default": 16
    },
    {
      "type": "range",
      "id": "grid_gap_desktop",
      "min": 0,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Grid gap — desktop",
      "default": 25
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "garage_kit_card",
      "name": "Garage kit card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "select",
          "id": "product_body_mode",
          "label": "Product body content",
          "options": [
            { "value": "full_description", "label": "Full product description" },
            { "value": "subtitle_features", "label": "Subtitle and features (settings below)" }
          ],
          "default": "full_description",
          "info": "When a product is selected: show the catalog description, or use subtitle and features instead. Custom subtitle (or metafield) still appears above the full description when that mode is on and the subtitle field has content."
        },
        {
          "type": "header",
          "content": "When no product is selected"
        },
        {
          "type": "image_picker",
          "id": "placeholder_image",
          "label": "Custom image",
          "info": "Shown instead of the theme placeholder. Optional."
        },
        {
          "type": "url",
          "id": "placeholder_link",
          "label": "Custom link",
          "info": "Used for the image and primary button when no product is selected. Optional."
        },
        {
          "type": "header",
          "content": "Badge"
        },
        {
          "type": "checkbox",
          "id": "show_badge",
          "label": "Show badge on image",
          "default": true
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text",
          "info": "Leave blank to use the theme translation (Most popular)."
        },
        {
          "type": "header",
          "content": "Title"
        },
        {
          "type": "select",
          "id": "title_source",
          "label": "Title source",
          "options": [
            { "value": "product", "label": "Product title" },
            { "value": "custom", "label": "Custom title" }
          ],
          "default": "product"
        },
        {
          "type": "text",
          "id": "title_custom",
          "label": "Custom title",
          "info": "Used when title source is custom. If empty, falls back to the product title."
        },
        {
          "type": "header",
          "content": "Subtitle"
        },
        {
          "type": "select",
          "id": "subtitle_source",
          "label": "Subtitle source",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "from_description", "label": "From product description (short excerpt)" },
            { "value": "custom", "label": "Custom subtitle" }
          ],
          "default": "custom"
        },
        {
          "type": "richtext",
          "id": "subtitle_custom",
          "label": "Custom subtitle",
          "default": "<p>Fits most standard 2-car garages</p>",
          "info": "Rich text. Use the dynamic source icon to connect a product metafield (Rich text or compatible type)."
        },
        {
          "type": "header",
          "content": "Features list"
        },
        {
          "type": "select",
          "id": "features_source",
          "label": "Features source",
          "options": [
            { "value": "custom", "label": "Custom (rich text)" },
            { "value": "product", "label": "From product description" }
          ],
          "default": "custom",
          "info": "When a product is selected and body content is subtitle and features: custom uses the rich text below; product parses the catalog description. When no product is selected, use custom rich text."
        },
        {
          "type": "richtext",
          "id": "features_custom",
          "label": "Custom features",
          "default": "<ul><li>Covers up to 400 sq ft</li><li>Includes 8% extra tiles</li><li>Installs in hours, no tools</li></ul>",
          "info": "Use a bullet list for features (check icons). Connect a product metafield (Rich text) via dynamic source if needed."
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "select",
          "id": "button_label_source",
          "label": "Button label source",
          "options": [
            { "value": "product", "label": "Auto (Shop + product title)" },
            { "value": "custom", "label": "Custom label" }
          ],
          "default": "product"
        },
        {
          "type": "text",
          "id": "button_label_custom",
          "label": "Custom button label",
          "info": "Used when button label source is custom. If empty, uses auto label."
        },
        {
          "type": "header",
          "content": "Image"
        },
        {
          "type": "text",
          "id": "image_alt_override",
          "label": "Image alt text override",
          "info": "Optional. Used for the product image, custom placeholder image, or product title."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GG: Garage kit compare",
      "blocks": [
        { "type": "garage_kit_card" },
        { "type": "garage_kit_card" }
      ]
    }
  ]
}
{% endschema %}
