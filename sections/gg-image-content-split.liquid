{%- comment -%}
  Image + content split: reversible layout, light/dark themes, optional mobile image.
{%- endcomment -%}

{%- liquid
  assign theme_dark = false
  if section.settings.background_style == 'dark'
    assign theme_dark = true
  endif

  assign image_right = false
  if section.settings.layout_direction == 'image_right'
    assign image_right = true
  endif

  assign mobile_center = false
  if section.settings.mobile_text_alignment == 'center'
    assign mobile_center = true
  endif

  assign heading_id = 'gg-split-heading-' | append: section.id
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .gg-split__grid {
    gap: {{ section.settings.column_gap }}px;
  }
  @media screen and (min-width: 750px) and (max-width: 989px) {
    #shopify-section-{{ section.id }} .gg-split__grid {
      gap: {{ section.settings.column_gap_tablet }}px;
    }
  }
{%- endstyle -%}

{% stylesheet %}
  .gg-split {
    width: 100%;
  }

  .gg-split--theme-light {
    --gg-split-bg: 245, 245, 245;
    --gg-split-text: 17, 17, 17;
    --gg-split-bullet: 17, 17, 17;
  }

  .gg-split--theme-light.gg-split--light-bg-white {
    --gg-split-bg: 255, 255, 255;
  }

  .gg-split--theme-dark {
    --gg-split-bg: 0, 0, 0;
    --gg-split-text: 255, 255, 255;
    --gg-split-bullet: 255, 255, 255;
  }

  .gg-split__outer {
    background-color: rgb(var(--gg-split-bg));
    color: rgb(var(--gg-split-text));
  }

  .gg-split__inner {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: clamp(1.6rem, 4vw, 2.4rem);
  }

  .gg-split__grid {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .gg-split__media {
    position: relative;
    width: 100%;
    flex-shrink: 0;
  }

  .gg-split__figure {
    margin: 0;
    border-radius: 1.2rem;
    overflow: hidden;
    background-color: rgba(var(--gg-split-text), 0.06);
  }

  .gg-split__picture,
  .gg-split__figure img {
    display: block;
    width: 100%;
    height: auto;
  }

  .gg-split__figure img {
    border-radius: 1.2rem;
    object-fit: cover;
    aspect-ratio: 1 / 1;
  }

  .gg-split__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 0.4rem;
  }

  .gg-split__heading {
    margin: 0 0 clamp(1.6rem, 3vw, 2.4rem);
    font-size: clamp(2.4rem, 1.5rem + 2.5vw, 4.2rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: rgb(var(--gg-split-text));
  }

  .gg-split__body {
    --gg-split-block-gap: clamp(1.2rem, 2vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: var(--gg-split-block-gap);
    width: 100%;
  }

  /* Stack single-item bullet lists so spacing matches one continuous list */
  .gg-split__body > .gg-split__list--single + .gg-split__list--single {
    margin-top: calc(-1 * var(--gg-split-block-gap) + 0.8rem);
  }

  .gg-split__richtext {
    margin: 0;
    font-size: clamp(1.5rem, 1.4rem + 0.25vw, 1.8rem);
    line-height: 1.55;
    color: rgb(var(--gg-split-text));
  }

  .gg-split__richtext > *:first-child {
    margin-top: 0;
  }

  .gg-split__richtext > *:last-child {
    margin-bottom: 0;
  }

  .gg-split__richtext a {
    color: inherit;
    text-decoration-thickness: 0.1rem;
    text-underline-offset: 0.25em;
  }

  .gg-split__richtext.gg-split__richtext--plain ul,
  .gg-split__richtext.gg-split__richtext--plain ol {
    list-style: none;
    padding-inline-start: 0;
    margin: 0;
  }

  .gg-split__richtext.gg-split__richtext--plain li {
    margin: 0 0 0.8rem;
    padding-inline-start: 0;
  }

  .gg-split__richtext.gg-split__richtext--plain li:last-child {
    margin-bottom: 0;
  }

  .gg-split__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    font-size: clamp(1.5rem, 1.4rem + 0.25vw, 1.8rem);
    line-height: 1.55;
    color: rgb(var(--gg-split-text));
  }

  .gg-split__item {
    position: relative;
    padding-inline-start: 1.6rem;
    margin: 0;
  }

  .gg-split__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.85em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background-color: rgb(var(--gg-split-bullet));
    transform: translateY(-50%);
  }

  @media screen and (min-width: 750px) {
    .gg-split__grid {
      flex-direction: row;
      align-items: center;
    }

    .gg-split--image-right .gg-split__grid {
      flex-direction: row-reverse;
    }

    .gg-split__media,
    .gg-split__content {
      flex: 1 1 50%;
      min-width: 0;
      max-width: 50%;
    }

    .gg-split__figure img {
      aspect-ratio: 1 / 1;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .gg-split__heading {
      font-size: clamp(2.8rem, 2.4rem + 0.8vw, 3.6rem);
    }

    .gg-split__list,
    .gg-split__richtext {
      font-size: 1.6rem;
    }
  }

  @media screen and (max-width: 749px) {
    .gg-split__heading {
      font-size: clamp(2.4rem, 2.1rem + 0.9vw, 2.8rem);
    }

    .gg-split__list,
    .gg-split__richtext {
      font-size: 1.6rem;
    }

    .gg-split--mobile-text-center .gg-split__content {
      text-align: center;
      align-items: center;
    }

    .gg-split--mobile-text-center .gg-split__heading {
      text-align: center;
    }

    .gg-split--mobile-text-center .gg-split__list {
      text-align: left;
      max-width: 42rem;
      margin-inline: auto;
      align-self: stretch;
    }

    .gg-split--mobile-text-center .gg-split__richtext {
      text-align: left;
      max-width: 42rem;
      margin-inline: auto;
      align-self: stretch;
    }
  }
{% endstylesheet %}

<section
  class="gg-split gg-split__outer section-{{ section.id }}-padding{% if theme_dark %} gg-split--theme-dark{% else %} gg-split--theme-light{% if section.settings.light_background == 'white' %} gg-split--light-bg-white{% endif %}{% endif %}{% if image_right %} gg-split--image-right{% endif %}{% if mobile_center %} gg-split--mobile-text-center{% endif %}"
  {% if section.settings.heading != blank %}
    aria-labelledby="{{ heading_id }}"
  {% endif %}
>
  <div class="gg-split__inner">
    <div class="gg-split__grid">
      <div class="gg-split__media">
        {%- if section.settings.image != blank -%}
          {%- liquid
            assign gg_split_img_alt = section.settings.image.alt | default: section.settings.heading | escape
          -%}
          <figure class="gg-split__figure">
            {%- if section.settings.image_mobile != blank -%}
              <picture class="gg-split__picture">
                <source
                  media="(max-width: 749px)"
                  srcset="
                    {{- section.settings.image_mobile | image_url: width: 375 }} 375w,
                    {{- section.settings.image_mobile | image_url: width: 550 }} 550w,
                    {{- section.settings.image_mobile | image_url: width: 750 }} 750w
                  "
                  sizes="100vw"
                >
                {{
                  section.settings.image
                  | image_url: width: 1600
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 750px) 50vw, 100vw',
                    widths: '375,550,750,1100,1400,1600',
                    alt: gg_split_img_alt,
                    class: 'gg-split__img'
                }}
              </picture>
            {%- else -%}
              {{
                section.settings.image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 750px) 50vw, 100vw',
                  widths: '375,550,750,1100,1400,1600',
                  alt: gg_split_img_alt,
                  class: 'gg-split__img'
              }}
            {%- endif -%}
          </figure>
        {%- else -%}
          <figure class="gg-split__figure">
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          </figure>
        {%- endif -%}
      </div>

      <div class="gg-split__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="gg-split__heading" id="{{ heading_id }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="gg-split__body">
            {%- for block in section.blocks -%}
              {%- if block.type == 'bullet' and block.settings.text != blank -%}
                <ul class="gg-split__list gg-split__list--single" role="list">
                  <li class="gg-split__item" {{ block.shopify_attributes }}>
                    {{- block.settings.text | escape -}}
                  </li>
                </ul>
              {%- elsif block.type == 'richtext' and block.settings.content != blank -%}
                <div
                  class="gg-split__richtext rte{% if block.settings.list_style == 'plain' %} gg-split__richtext--plain{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{- block.settings.content -}}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GG: Image content split",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "select",
      "id": "background_style",
      "label": "Background style",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "dark"
    },
    {
      "type": "select",
      "id": "light_background",
      "label": "Light background color",
      "options": [
        { "value": "off_white", "label": "Off-white" },
        { "value": "white", "label": "White" }
      ],
      "default": "off_white",
      "info": "Applies when background style is light."
    },
    {
      "type": "select",
      "id": "layout_direction",
      "label": "Image position",
      "options": [
        { "value": "image_left", "label": "Image left" },
        { "value": "image_right", "label": "Image right" }
      ],
      "default": "image_left"
    },
    {
      "type": "select",
      "id": "mobile_text_alignment",
      "label": "Mobile text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (mobile)",
      "info": "Optional. Shown below 750px instead of the main image."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Installs in Hours, Not Days"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Space between image and text (desktop)",
      "default": 64
    },
    {
      "type": "range",
      "id": "column_gap_tablet",
      "min": 20,
      "max": 72,
      "step": 4,
      "unit": "px",
      "label": "Space between image and text (tablet)",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Snap-together system"
        }
      ]
    },
    {
      "type": "richtext",
      "name": "Rich text",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "Text",
          "default": "<p>Add paragraphs, emphasis, and links. Use lists in the editor, or set List appearance to Plain to show all lines without bullet markers.</p>"
        },
        {
          "type": "select",
          "id": "list_style",
          "label": "List appearance",
          "options": [
            {
              "value": "standard",
              "label": "Standard (editor list bullets and numbers)"
            },
            {
              "value": "plain",
              "label": "Plain (no list markers)"
            }
          ],
          "default": "standard",
          "info": "Plain hides bullets and numbers from list content so lines read as continuous text."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GG: Image content split",
      "blocks": [
        {
          "type": "bullet",
          "settings": { "text": "Snap-together system" }
        },
        {
          "type": "bullet",
          "settings": { "text": "No glue or special tools required" }
        },
        {
          "type": "bullet",
          "settings": { "text": "Beginner-friendly" }
        }
      ]
    }
  ]
}
{% endschema %}
