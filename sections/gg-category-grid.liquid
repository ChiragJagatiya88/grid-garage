{%- comment -%}
  Category image grid — "Designed for real garages" style row.
{%- endcomment -%}

<style>
  .gg-category-grid.section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: rgb(var(--color-background));
  }

  .gg-category-grid__inner {
    width: 100%;
  }

  .gg-category-grid__header {
    margin: 0 0 4rem;
    text-align: center;
  }

  .gg-category-grid__header--left {
    text-align: left;
  }

  .gg-category-grid__heading {
    margin: 0;
    font-size: clamp(2.6rem, 4vw, 3.6rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: rgb(var(--color-foreground));
  }

  @media screen and (min-width: 990px) {
    .gg-category-grid__header {
      margin-bottom: clamp(4rem, 5vw, 6rem);
    }
  }

  .gg-category-grid.section-{{ section.id }}-padding .gg-category-grid__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.grid_gap_mobile }}px;
    align-items: stretch;
  }

  @media screen and (min-width: 750px) {
    .gg-category-grid.section-{{ section.id }}-padding .gg-category-grid__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ section.settings.grid_gap_tablet }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .gg-category-grid.section-{{ section.id }}-padding .gg-category-grid__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: {{ section.settings.grid_gap_desktop }}px;
    }
  }

  .gg-category-grid__item {
    display: flex;
    min-width: 0;
    height: 100%;
  }

  .gg-category-grid__card {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }

  .gg-category-grid__card--link {
    cursor: pointer;
  }

  .gg-category-grid__card--link:focus-visible {
    outline: 0.2rem solid rgb(var(--color-foreground));
    outline-offset: 0.3rem;
    border-radius: 1.2rem;
  }

  .gg-category-grid__media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    flex-shrink: 0;
    border-radius: 1.2rem;
    overflow: hidden;
    background-color: rgba(var(--color-foreground), 0.06);
  }

  .gg-category-grid__media img,
  .gg-category-grid__media .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    transform: scale(1);
    transform-origin: center center;
  }

  @media (hover: hover) and (pointer: fine) {
    .gg-category-grid__card:hover .gg-category-grid__media img,
    .gg-category-grid__card:hover .gg-category-grid__media .placeholder-svg {
      transform: scale(1.04);
    }
  }

  .gg-category-grid__title-wrap {
    flex-grow: 1;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    text-align: center;
    padding-top: 1.2rem;
  }

  @media screen and (min-width: 750px) {
    .gg-category-grid__title-wrap {
      padding-top: 1.4rem;
    }
  }

  .gg-category-grid.section-{{ section.id }}-padding .gg-category-grid__title {
    margin: 0;
    font-size: {{ section.settings.card_title_size_mobile }}px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: rgb(var(--color-foreground));
  }

  @media screen and (min-width: 750px) {
    .gg-category-grid.section-{{ section.id }}-padding .gg-category-grid__title {
      font-size: {{ section.settings.card_title_size_desktop }}px;
    }
  }
</style>

<section
  class="gg-category-grid section-{{ section.id }}-padding"
  {% if section.settings.heading != blank %}
    aria-labelledby="CategoryGridHeading-{{ section.id }}"
  {% endif %}
>
  <div class="page-width gg-category-grid__inner">
    {%- if section.settings.heading != blank -%}
      <header
        class="gg-category-grid__header{% if section.settings.heading_alignment == 'left' %} gg-category-grid__header--left{% endif %}"
      >
        <h2 class="gg-category-grid__heading" id="CategoryGridHeading-{{ section.id }}">
          {{- section.settings.heading | escape -}}
        </h2>
      </header>
    {%- endif -%}

    <ul class="gg-category-grid__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="gg-category-grid__item" {{ block.shopify_attributes }}>
          {%- liquid
            assign card_link = block.settings.link
            assign has_link = false
            if card_link != blank
              assign has_link = true
            endif
          -%}

          {%- if has_link -%}
            <a
              class="gg-category-grid__card gg-category-grid__card--link"
              href="{{ card_link }}"
              {% if block.settings.open_new_tab %}
                target="_blank"
                rel="noopener noreferrer"
              {% endif %}
            >
          {%- else -%}
            <div class="gg-category-grid__card">
          {%- endif -%}

          <div class="gg-category-grid__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  decoding: 'async',
                  sizes: '(min-width: 990px) 22vw, (min-width: 750px) 45vw, 100vw',
                  widths: '375,550,750,900,1100,1200',
                  alt: block.settings.image.alt | default: block.settings.title | escape
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>

          {%- if block.settings.title != blank -%}
            <div class="gg-category-grid__title-wrap">
              <h3 class="gg-category-grid__title">{{ block.settings.title | escape }}</h3>
            </div>
          {%- endif -%}

          {%- if has_link -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "GG: Category image grid",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed For Real Garages"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Category card title"
    },
    {
      "type": "range",
      "id": "card_title_size_mobile",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Title size (mobile)",
      "default": 18
    },
    {
      "type": "range",
      "id": "card_title_size_desktop",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Title size (tablet and up)",
      "default": 20
    },
    {
      "type": "header",
      "content": "Grid spacing"
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Gap (mobile)",
      "default": 16
    },
    {
      "type": "range",
      "id": "grid_gap_tablet",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Gap (tablet)",
      "info": "750px and wider (two columns)",
      "default": 24
    },
    {
      "type": "range",
      "id": "grid_gap_desktop",
      "min": 8,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Gap (desktop)",
      "info": "990px viewport and wider (four columns)",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Category card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional — links the whole card"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GG: Category image grid",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Daily Parking"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Home Gyms"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Workshops"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Man Caves"
          }
        }
      ]
    }
  ]
}
{% endschema %}
