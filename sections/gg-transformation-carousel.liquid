{%- comment -%}
  Figma: The Transformation — before/after pairs + controls (node 279:3780).
{%- endcomment -%}
{{ 'gg-transformation-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gg-transformation-carousel.js' | asset_url }}" defer></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  class="gg-tc section-{{ section.id }}-padding"
  data-gg-tc="{{ section.id }}"
  style="--gg-accent: {{ section.settings.accent_color.red }},{{ section.settings.accent_color.green }},{{ section.settings.accent_color.blue }};"
>
  <div class="gg-tc__intro">
    {%- if section.settings.heading != blank -%}
      <h2 class="gg-tc__title gg-font-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="gg-tc__sub gg-font-body">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
  </div>

  <div class="gg-tc__viewport page-width">
  <div class="gg-tc__slider" tabindex="0" aria-label="Before and after gallery">
    {%- for block in section.blocks -%}
      <div class="gg-tc__pair" {{ block.shopify_attributes }}>

        <div class="gg-tc__card">
          {%- if block.settings.before_image != blank -%}
            {%- assign before_alt = block.settings.before_image.alt | default: block.settings.before_image.filename | escape -%}

            {{
              block.settings.before_image
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 750px) 25vw, 45vw',
                widths: '375,550,750',
                alt: before_alt
            }}
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}

          <span class="gg-tc__badge gg-tc__badge--before">Before</span>
        </div>

        <div class="gg-tc__card">
          {%- if block.settings.after_image != blank -%}
            {%- assign after_alt = block.settings.after_image.alt | default: block.settings.after_image.filename | escape -%}

            {{
              block.settings.after_image
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 750px) 25vw, 45vw',
                widths: '375,550,750',
                alt: after_alt
            }}
          {%- else -%}
            {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}

          <span class="gg-tc__badge gg-tc__badge--after">After</span>
        </div>

      </div>
    {%- endfor -%}
  </div>
</div>

  {%- if section.blocks.size > 0 -%}
    <div class="gg-tc__controls page-width">
      <div class="gg-tc__nav">
        <button
          type="button"
          class="gg-tc__prev"
          data-gg-tc-prev="{{ section.id }}"
          aria-label="Previous slide"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M12.5 15L7.5 10L12.5 5" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button
          type="button"
          class="gg-tc__next"
          data-gg-tc-next="{{ section.id }}"
          aria-label="Next slide"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M7.5 15L12.5 10L7.5 5" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
      <div class="gg-tc__progress">
        <div class="gg-tc__segments" role="tablist" aria-label="Slide indicators">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="gg-tc__segment{% if forloop.first %} is-active{% endif %}"
              data-gg-tc-seg="{{ section.id }}"
              aria-label="Go to slide {{ forloop.index }} of {{ section.blocks.size }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
            ></button>
          {%- endfor -%}
        </div>
        <span class="gg-tc__count gg-font-body" data-gg-tc-count="{{ section.id }}">
          01/{% if section.blocks.size < 10 %}0{% endif -%}
          {{- section.blocks.size -}}
        </span>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "GG: Transformation",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The transformation"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Engineered to withstand heavy vehicles and extreme conditions while maintaining a showroom finish."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "After badge color",
      "default": "#E61E43"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "pair",
      "name": "Before and after",
      "settings": [
        {
          "type": "image_picker",
          "id": "before_image",
          "label": "Before image"
        },
        {
          "type": "image_picker",
          "id": "after_image",
          "label": "After image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GG: Transformation",
      "blocks": [
        { "type": "pair" },
        { "type": "pair" },
        { "type": "pair" }
      ]
    }
  ]
}
{% endschema %}
