{%- comment -%}
  Figma node 551:920 — Floor page: centered intro, eyebrow, heading, text, three CTAs.
{%- endcomment -%}
{{ 'floor-garage-sections.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .floor-sec--hero {
    --floor-accent: {{ section.settings.accent_color.red }},{{ section.settings.accent_color.green }},{{ section.settings.accent_color.blue }};
    --floor-hero-bg: {{ section.settings.background_color.red }},{{ section.settings.background_color.green }},{{ section.settings.background_color.blue }};
    --floor-hero-heading: {{ section.settings.heading_color.red }},{{ section.settings.heading_color.green }},{{ section.settings.heading_color.blue }};
    --floor-hero-text: {{ section.settings.text_color.red }},{{ section.settings.text_color.green }},{{ section.settings.text_color.blue }};
    --floor-hero-btn-gap: {{ section.settings.button_gap_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .floor-sec--hero {
      --floor-hero-btn-gap: {{ section.settings.button_gap_desktop }}px;
    }
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  class="floor-sec floor-sec--hero flr-hero section-{{ section.id }}-padding"
  aria-labelledby="FloorHeroTitle-{{ section.id }}"
>
  <div class="flr-hero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="flr-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 id="FloorHeroTitle-{{ section.id }}" class="flr-hero__title">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="flr-hero__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
    <div class="flr-hero__actions">
      {%- if section.settings.primary_label != blank -%}
        <a
          class="floor-sec__btn floor-sec__btn--outline"
          href="{{ section.settings.primary_link | default: '#' }}"
        >
          {{- section.settings.primary_label | escape -}}
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a
          class="floor-sec__btn floor-sec__btn--solid"
          href="{{ section.settings.secondary_link | default: '#' }}"
        >
          {{- section.settings.secondary_label | escape -}}
        </a>
      {%- endif -%}
      {%- if section.settings.tertiary_label != blank -%}
        <a
          class="floor-sec__btn floor-sec__btn--outline"
          href="{{ section.settings.tertiary_link | default: '#' }}"
        >
          {{- section.settings.tertiary_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Floor: Hero intro",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Grid Garage"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Garage floor tiles"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Grid Garage floor tiles transform your garage in more ways than one. You won't only get a clean and professional looking garage with Grid Garage, but you'll also have a functional and durable flooring system that can withstand the harsh environment of a well-used garage.</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "First button label",
      "default": "Floor designer"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "First button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Second button label",
      "default": "Contact us"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Second button link"
    },
    {
      "type": "text",
      "id": "tertiary_label",
      "label": "Third button label",
      "default": "Shop online"
    },
    {
      "type": "url",
      "id": "tertiary_link",
      "label": "Third button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#E11D48"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text color",
      "default": "#0A0A0A"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "button_gap_mobile",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Button gap (mobile)",
      "default": 12
    },
    {
      "type": "range",
      "id": "button_gap_desktop",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Button gap (desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Floor: Hero intro"
    }
  ]
}
{% endschema %}
