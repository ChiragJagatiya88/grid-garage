{{ 'if-faq-accordion.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign if_bg = section.settings.section_bg | default: '#F5F5F5'
  assign if_panel = section.settings.panel_bg | default: '#FFFFFF'
  assign if_row = section.settings.row_bg | default: '#F0F0F0'
  assign if_accent = section.settings.accent_color | default: '#111111'
-%}

<div
  id="if-faq-{{ section.id }}"
  class="section_{{ section.id }} if-faq{% if section.settings.enable_custom_class and section.settings.section_class != blank %} {{ section.settings.section_class }}{% endif %}"
  data-if-faq
  {% unless section.settings.one_at_a_time %}data-multi-open{% endunless %}
  style="
    --if-faq-bg: {{ if_bg }};
    --if-faq-panel: {{ if_panel }};
    --if-faq-row: {{ if_row }};
    --if-faq-accent: {{ if_accent }};
  "
>
  <div class="{% if section.settings.enable_container %}if-faq__inner{% else %}if-faq__inner if-faq__inner--fluid{% endif %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="if-faq__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="if-faq__panel">
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq' -%}
          <details
            class="if-faq__item"
            data-if-faq-item
            {% if forloop.first and section.settings.open_first %}open{% endif %}
            {{ block.shopify_attributes }}
          >
            <summary class="if-faq__summary">
              <span class="if-faq__question">{{ block.settings.question | escape }}</span>
              <span class="if-faq__icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </summary>
            {%- if block.settings.answer != blank -%}
              <div class="if-faq__answer">
                <div class="if-faq__answer-inner rte">
                  {{ block.settings.answer }}
                </div>
              </div>
            {%- endif -%}
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script src="{{ 'if-faq-accordion.js' | asset_url }}" defer></script>

{% style %}
  .section_{{ section.id }} {
    {% if section.settings.section_bg != blank %}background: {{ section.settings.section_bg }};{% endif %}
    {% if section.settings.section_gradient_bg != blank %}background: {{ section.settings.section_gradient_bg }};{% endif %}
    {% if section.settings.enable_custom_padding %}padding-block: {{ section.settings.padding_desk }};{% endif %}
  }
  @media screen and (max-width: 767px) {
    .section_{{ section.id }} {
      {% if section.settings.enable_custom_padding %}padding-block: {{ section.settings.padding_mob }};{% endif %}
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "IF FAQ Accordion",
  "tag": "section",
  "class": "if_faq_accordion",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_class",
      "label": "Enable custom class",
      "default": false
    },
    {
      "type": "text",
      "id": "section_class",
      "label": "Custom class",
      "visible_if": "{{ section.settings.enable_custom_class == true }}"
    },
    {
      "type": "checkbox",
      "id": "enable_container",
      "label": "Enable container",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first item by default",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "one_at_a_time",
      "label": "Only one item open at a time",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#F5F5F5"
    },
    {
      "type": "color_background",
      "id": "section_gradient_bg",
      "label": "Section gradient background"
    },
    {
      "type": "color",
      "id": "panel_bg",
      "label": "Panel background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "row_bg",
      "label": "Row background",
      "default": "#F0F0F0"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Answer accent line",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_padding",
      "label": "Enable custom padding",
      "default": true
    },
    {
      "type": "text",
      "id": "padding_desk",
      "label": "Padding desktop",
      "default": "56px 0",
      "visible_if": "{{ section.settings.enable_custom_padding == true }}"
    },
    {
      "type": "text",
      "id": "padding_mob",
      "label": "Padding mobile",
      "default": "36px 0",
      "visible_if": "{{ section.settings.enable_custom_padding == true }}"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Do I need to measure my garage?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>No, our standard kits are designed to fit most 2-car and 3-car garages. Each kit includes tiles that can be easily trimmed to fit your exact space.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IF FAQ Accordion",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "Do I need to measure my garage?",
            "answer": "<p>No, our standard kits are designed to fit most 2-car and 3-car garages. Each kit includes tiles that can be easily trimmed to fit your exact space.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Is shipping really included?",
            "answer": "<p>Yes — shipping is included in the kit price for standard deliveries across the contiguous US.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I install this myself?",
            "answer": "<p>Absolutely. Most customers install their floor in a few hours with basic tools and no special experience required.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What if my garage is slightly different in size?",
            "answer": "<p>Tiles can be cut to fit edges and columns. For custom footprints, use Design My Space in the configurator.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Most orders ship within 2–6 business days. You’ll receive tracking once your kit leaves the warehouse.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
