{%- comment -%}
  Style Grid — "Choose Your Style" section with 4 product/style cards.
  Light grey background, white cards, image + title layout.
{%- endcomment -%}
{{ 'gg-style-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign head_align = 'center'
  if section.settings.heading_alignment == 'left'
    assign head_align = 'left'
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .gg-sg {
    --gg-sg-bg: {{ section.settings.background_color.red }},{{ section.settings.background_color.green }},{{ section.settings.background_color.blue }};
    --gg-sg-card-bg: {{ section.settings.card_background.red }},{{ section.settings.card_background.green }},{{ section.settings.card_background.blue }};
    --gg-sg-title: {{ section.settings.title_color.red }},{{ section.settings.title_color.green }},{{ section.settings.title_color.blue }};
    --gg-sg-head-align: {{ head_align }};
    --gg-sg-img-h-m: {{ section.settings.image_height_mobile }}px;
    --gg-sg-img-h-d: {{ section.settings.image_height_desktop }}px;
  }
{%- endstyle -%}

<section
  class="gg-sg section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  data-section-id="{{ section.id }}"
>
  <div class="gg-sg__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="gg-sg__heading gg-font-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="gg-sg__grid">
      {%- for block in section.blocks -%}
        <div
          class="gg-sg__card{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {{ block.shopify_attributes }}
          style="{% if settings.animations_reveal_on_scroll %}--animation-order: {{ forloop.index }}{% endif %}"
        >
          {%- if block.settings.link != blank -%}
            <a
              href="{{ block.settings.link }}"
              class="gg-sg__card-link"
              {% if block.settings.open_new_tab %}
                target="_blank"
                rel="noopener noreferrer"
              {% endif %}
            >
          {%- else -%}
            <div class="gg-sg__card-inner">
          {%- endif -%}

              <div class="gg-sg__card-image">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      class: 'gg-sg__img',
                      sizes: '(min-width: 990px) 22vw, (min-width: 750px) 45vw, 100vw',
                      widths: '375,550,750,900,1100',
                      alt: block.settings.image.alt | default: block.settings.title | escape
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg gg-sg__img' }}
                {%- endif -%}
              </div>

              {%- if block.settings.title != blank -%}
                <h3 class="gg-sg__card-title gg-font-heading">{{ block.settings.title | escape }}</h3>
              {%- endif -%}

          {%- if block.settings.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GG: Style grid",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose Your Style"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Image height"
    },
    {
      "type": "range",
      "id": "image_height_desktop",
      "min": 180,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Image height (desktop)",
      "default": 220
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "min": 140,
      "max": 260,
      "step": 10,
      "unit": "px",
      "label": "Image height (mobile)",
      "default": 180
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title text",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "style_card",
      "name": "Style card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Style Name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "URL to collection, product, or page"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GG: Style grid",
      "blocks": [
        {
          "type": "style_card",
          "settings": {
            "title": "DiamondTrax"
          }
        },
        {
          "type": "style_card",
          "settings": {
            "title": "Ribtrax Smooth"
          }
        },
        {
          "type": "style_card",
          "settings": {
            "title": "Ribtrax Pro"
          }
        },
        {
          "type": "style_card",
          "settings": {
            "title": "Ribtrax Smooth Pro"
          }
        }
      ]
    }
  ]
}
{% endschema %}
