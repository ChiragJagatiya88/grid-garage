{%- comment -%}
  Figma node 551:1283 — Floor page: “How to get started” three cards.
{%- endcomment -%}
{{ 'floor-garage-sections.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .flr-start {
    --floor-accent: {{ section.settings.accent_color.red }},{{ section.settings.accent_color.green }},{{ section.settings.accent_color.blue }};
    --floor-start-gap: {{ section.settings.grid_gap }}px;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="floor-sec flr-start section-{{ section.id }}-padding" aria-labelledby="FloorStartTitle-{{ section.id }}">
  <div class="floor-sec__inner">
    {%- if section.settings.heading != blank -%}
      <h2 id="FloorStartTitle-{{ section.id }}" class="flr-start__title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="flr-start__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'card' -%}
            <article class="flr-start-card" {{ block.shopify_attributes }}>
              <div class="flr-start-card__media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 100vw',
                      widths: '375,550,750,900',
                      alt: block.settings.image.alt | default: block.settings.title | escape
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <div class="flr-start-card__accent" aria-hidden="true"></div>
              <div class="flr-start-card__body">
                {%- if block.settings.title != blank -%}
                  <h3 class="flr-start-card__name">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="flr-start-card__text rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <div class="flr-start-card__cta">
                    <a class="floor-sec__btn floor-sec__btn--solid" href="{{ block.settings.button_link | default: '#' }}">
                      {{- block.settings.button_label | escape -}}
                    </a>
                  </div>
                {%- endif -%}
              </div>
            </article>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Floor: Get started",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How to get started"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#E11D48"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Grid gap",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Get free design assistance"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Speak to a knowledgeable flooring specialist who will assist with your design.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Get design assistance"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Floor: Get started",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Get free design assistance",
            "text": "<p>Speak to a knowledgeable flooring specialist who will assist with your design and help determine the perfect tile style for your new floor.</p>",
            "button_label": "Get design assistance"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Design your new floor",
            "text": "<p>Whether you utilize one of the existing preset designs or customize your own flooring, this program has all the tools to help you imagine your new floor.</p>",
            "button_label": "Start designing"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Shop Grid Garage online store",
            "text": "<p>Ready to buy? Go straight to our online store to shop our inventory of pre-designed garage kits, pads, accessories, and much more.</p>",
            "button_label": "Start designing"
          }
        }
      ]
    }
  ]
}
{% endschema %}
