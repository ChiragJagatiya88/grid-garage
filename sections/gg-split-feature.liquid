{%- comment -%}
  Split feature section — Text + checklist left, image right.
  Light grey background, red check icons, rounded image with shadow.
{%- endcomment -%}
{{ 'gg-split-feature.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign image_position = section.settings.image_position
  assign content_align = section.settings.content_alignment
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .gg-sf {
    --gg-sf-bg: {{ section.settings.background_color.red }},{{ section.settings.background_color.green }},{{ section.settings.background_color.blue }};
    --gg-sf-icon: {{ section.settings.check_icon_color.red }},{{ section.settings.check_icon_color.green }},{{ section.settings.check_icon_color.blue }};
  }
{%- endstyle -%}

<section
  class="gg-sf section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  data-section-id="{{ section.id }}"
>
  <div class="gg-sf__container">
    <div class="gg-sf__grid{% if image_position == 'left' %} gg-sf__grid--reversed{% endif %}">
      {%- comment -%}Text Content{%- endcomment -%}
      <div class="gg-sf__content{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.heading != blank -%}
          <h2 class="gg-sf__heading gg-font-heading{% if content_align == 'center' %} gg-sf__heading--center{% endif %}">
            {{ section.settings.heading | escape | newline_to_br }}
          </h2>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="gg-sf__list" role="list">
            {%- for block in section.blocks -%}
              <li class="gg-sf__item" {{ block.shopify_attributes }}>
                <span class="gg-sf__icon" aria-hidden="true">
                  {%- if block.settings.custom_icon != blank -%}
                    {{
                      block.settings.custom_icon
                      | image_url: width: 72
                      | image_tag:
                        loading: 'lazy',
                        width: 18,
                        height: 18,
                        alt: block.settings.custom_icon.alt | escape
                    }}
                  {%- else -%}
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M5.5 9L8 11.5L12.5 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {%- endif -%}
                </span>
                <span class="gg-sf__text gg-font-body">{{ block.settings.text | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%}Media (Image or Video){%- endcomment -%}
      <div class="gg-sf__media{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.media_type == 'video' -%}
          {%- comment -%}Video{%- endcomment -%}
          {%- liquid
            if section.settings.video != blank
              assign video_source = section.settings.video
            elsif section.settings.video_url != blank
              assign video_source = section.settings.video_url
            endif
          -%}
          {%- if video_source != blank -%}
            <div class="gg-sf__media-wrapper gg-sf__media-wrapper--video">
              {%- if section.settings.video != blank -%}
                {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'gg-sf__video' }}
              {%- else -%}
                {%- if section.settings.video_url.type == 'youtube' -%}
                  <iframe
                    src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ section.settings.video_url.id }}&controls=0&rel=0"
                    class="gg-sf__video"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  ></iframe>
                {%- elsif section.settings.video_url.type == 'vimeo' -%}
                  <iframe
                    src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1&mute=1&loop=1&controls=0"
                    class="gg-sf__video"
                    frameborder="0"
                    allow="autoplay; fullscreen; picture-in-picture"
                    allowfullscreen
                  ></iframe>
                {%- endif -%}
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="gg-sf__media-wrapper gg-sf__media-wrapper--placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        {%- else -%}
          {%- comment -%}Image{%- endcomment -%}
          {%- if section.settings.image != blank -%}
            <div class="gg-sf__media-wrapper">
              {{
                section.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  class: 'gg-sf__image',
                  sizes: '(min-width: 990px) 50vw, (min-width: 750px) 60vw, 100vw',
                  widths: '375,550,750,900,1100,1200',
                  alt: section.settings.image.alt | default: section.settings.heading | escape
              }}
            </div>
          {%- else -%}
            <div class="gg-sf__media-wrapper gg-sf__media-wrapper--placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GG: Split feature",
  "tag": "section",
  "class": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Install in Hours,\nNot Days",
      "info": "Use line breaks for multi-line heading"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment (mobile)",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video upload",
      "info": "Upload a video file (MP4 recommended)"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL",
      "accept": ["youtube", "vimeo"],
      "info": "Paste YouTube or Vimeo link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "check_icon_color",
      "label": "Check icon color",
      "default": "#E61E43"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Benefit description"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon (optional)",
          "info": "Replaces default red checkmark. SVG recommended."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GG: Split feature",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "text": "No glue required"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "text": "No professional installation needed"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "text": "Tiles snap together easily"
          }
        }
      ]
    }
  ]
}
{% endschema %}
