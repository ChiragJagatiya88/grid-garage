        "custom_liquid_bxRWCK": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"garage-kit-dynamic-info\">\n  <div class=\"garage-kit-info-content garage-kit-info-2car\">\n    <h4>2-Car Garage Kit</h4>\n    <ul>\n      <li>Fits most garages between 400–430 sq. ft.</li>\n      <li>Includes extra tiles for cuts and installation.</li>\n      <li>Free nationwide shipping. 3–5 days delivery.</li>\n    </ul>\n  </div>\n\n  <div class=\"garage-kit-info-content garage-kit-info-3car\" style=\"display: none;\">\n    <h4>3-Car Garage Kit</h4>\n    <ul>\n      <li>Fits most garages between 600–630 sq. ft.</li>\n      <li>Includes extra tiles for cuts and installation.</li>\n      <li>Free nationwide shipping. 3–5 days delivery.</li>\n    </ul>\n  </div>\n</div>\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function () {\n  function updateGarageKitInfo() {\n    var selectedGarage = '';\n\n    var checkedRadio = document.querySelector('input[type=\"radio\"][name*=\"Garage\"]:checked');\n    if (checkedRadio) {\n      selectedGarage = checkedRadio.value;\n    }\n\n    var selectedDropdown = document.querySelector('select[name*=\"Garage\"]');\n    if (!selectedGarage && selectedDropdown) {\n      selectedGarage = selectedDropdown.value;\n    }\n\n    var twoCarInfo = document.querySelector('.garage-kit-info-2car');\n    var threeCarInfo = document.querySelector('.garage-kit-info-3car');\n\n    if (!twoCarInfo || !threeCarInfo) return;\n\n    if (selectedGarage.includes('3-Car')) {\n      twoCarInfo.style.display = 'none';\n      threeCarInfo.style.display = 'block';\n    } else {\n      twoCarInfo.style.display = 'block';\n      threeCarInfo.style.display = 'none';\n    }\n  }\n\n  updateGarageKitInfo();\n\n  document.addEventListener('change', function (event) {\n    if (\n      event.target.matches('input[type=\"radio\"]') ||\n      event.target.matches('select')\n    ) {\n      updateGarageKitInfo();\n    }\n  });\n\n  document.addEventListener('click', function () {\n    setTimeout(updateGarageKitInfo, 100);\n  });\n});\n</script>\n\n<style>\n.garage-kit-dynamic-info {\n  margin: 14px 0 18px;\n  padding: 14px 16px;\n  border: 1px solid #e1e1e1;\n  background: #fafafa;\n}\n\n.garage-kit-info-content h4 {\n  margin: 0 0 8px;\n  font-size: 16px;\n  font-weight: 700;\n  color: #111;\n}\n\n.garage-kit-info-content ul {\n  margin: 0;\n  padding-left: 18px;\n}\n\n.garage-kit-info-content li {\n  font-size: 14px;\n  line-height: 1.45;\n  margin-bottom: 6px;\n  color: #222;\n}\n</style>"
          }
