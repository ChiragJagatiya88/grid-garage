        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "Do I need to measure my garage?",
            "answer": "<p>No, our standard kits are designed to fit most 2-car and 3-car garages. Each kit includes tiles that can be easily trimmed to fit your exact space.</p>"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "Is shipping really included?",
            "answer": "<p>Yes! All our garage flooring kits include free shipping within the continental United States. No hidden fees or surprises at checkout.</p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "Can I install this myself?",
            "answer": "<p>Absolutely. Our modular tiles snap together easily without any special tools, glue, or professional help. Most installations take just a few hours.</p>"
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "question": "What if my garage is slightly different in size?",
            "answer": "<p>Our tiles can be easily cut with a utility knife or saw to fit any space. We also offer expansion kits for larger garages.</p>"
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Most orders arrive within 3-6 business days. You'll receive tracking information as soon as your order ships.</p>"
          }
