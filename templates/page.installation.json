      "blocks": {
        "heading_BtFrFN": {
          "type": "heading",
          "settings": {
            "heading": "Grid Garage Installation Steps",
            "heading_size": "h1"
          }
        },
        "text_JagGCC": {
          "type": "text",
          "settings": {
            "text": "<p>Grid Garage interlocking flooring tiles must be site conditioned at room temperature (72° F or higher) for a period of 24 hours prior to installation. It is ideal to put the tiles which will be placed at the front of the garage in the direct sunlight for a period of time prior to installation to allow the tiles to expand, especially if they will be exposed to direct sunlight when the garage door is open.<br/></p>"
          }
        },
        "button_RaH76B": {
          "type": "button",
          "settings": {
            "button_label": "SwissTrax Installation Instructions",
            "button_link": "https://cdn.shopify.com/s/files/1/0811/8543/9973/files/Garage-Install-Instructions-2.0-2022.pdf?v=1777570719",
            "button_style_secondary": false,
            "button_label_2": "Grid Garage X Installation Insructions",
            "button_link_2": "#",
            "button_style_secondary_2": false
          }
        }
      },
      "block_order": [
