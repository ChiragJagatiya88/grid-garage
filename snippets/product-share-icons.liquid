{% doc %}
  Renders a horizontal product share row (Facebook, X/Twitter, Pinterest).

  @param {object} block - Section block (for Theme Editor attributes).
  @param {object} product - Product object.
  @param {string} share_url - Absolute URL to share (variant-aware when updated via JS).

  @example
  {% render 'product-share-icons',
    block: block,
    product: product,
    share_url: share_url
  %}
{% enddoc %}
<script src="{{ 'product-share-icons.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign share_title = product.title | escape
  assign encoded_url = share_url | url_encode
  assign encoded_title = product.title | url_encode
  assign pin_media = product.featured_image | image_url: width: 1200
  if pin_media != blank
    unless pin_media contains 'http'
      assign pin_media = pin_media | prepend: 'https:'
    endunless
  endif
  assign encoded_media = pin_media | url_encode
  assign facebook_href = 'https://www.facebook.com/sharer.php?u=' | append: encoded_url
  assign twitter_href = 'https://twitter.com/intent/tweet?url=' | append: encoded_url | append: '&text=' | append: encoded_title
  assign pinterest_href = 'https://www.pinterest.com/pin/create/button/?url=' | append: encoded_url | append: '&description=' | append: encoded_title
  if pin_media != blank
    assign pinterest_href = pinterest_href | append: '&media=' | append: encoded_media
  endif
-%}
<product-share-icons
  class="product-share-icons"
  data-share-title="{{ share_title }}"
  {% if pin_media != blank %}
    data-share-media="{{ pin_media | escape }}"
  {% endif %}
  {{ block.shopify_attributes }}
>
  <span class="product-share-icons__label">{{ block.settings.share_label | escape }}</span>
  <ul class="product-share-icons__list list-unstyled" role="list">
    <li class="product-share-icons__item">
      <a
        href="{{ facebook_href }}"
        class="product-share-icons__link link"
        data-share-network="facebook"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="{{ 'general.social.alt_text.share_on_facebook' | t }}"
      >
        <span class="svg-wrapper" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="18" viewBox="0 0 10 18" fill="none">
  <g clip-path="url(#clip0_288_1839)">
    <path d="M9.89 0.00854492H7.19273C4.67527 0.00854492 2.69727 1.98654 2.69727 4.504V7.20127H0V10.7976H2.69727V17.9904H6.29364V10.7976H8.99091L9.89 7.20127H6.29364V4.504C6.29364 3.96454 6.65327 3.60491 7.19273 3.60491H9.89V0.00854492Z" fill="#222222"/>
  </g>
  <defs>
    <clipPath id="clip0_288_1839">
      <rect width="9.89" height="17.9989" fill="white"/>
    </clipPath>
  </defs>
</svg>
        </span>
      </a>
    </li>
    <li class="product-share-icons__item">
      <a
        href="{{ twitter_href }}"
        class="product-share-icons__link link"
        data-share-network="twitter"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="{{ 'general.social.alt_text.share_on_twitter' | t }}"
      >
        <span class="svg-wrapper" aria-hidden="true">
          {{- 'icon-twitter.svg' | inline_asset_content -}}
        </span>
      </a>
    </li>
    <li class="product-share-icons__item">
      <a
        href="{{ pinterest_href }}"
        class="product-share-icons__link link"
        data-share-network="pinterest"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="{{ 'general.social.alt_text.share_on_pinterest' | t }}"
      >
        <span class="svg-wrapper" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="18" viewBox="0 0 14 18" fill="none">
